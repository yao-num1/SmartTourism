};

function openPortalHotDetail(id) {
  const item = portalHotDetails[id];
  const overlay = document.getElementById('portal-detail-overlay');
  if (!item || !overlay) return;
  document.getElementById('portal-detail-img').src = item.image;
  document.getElementById('portal-detail-img').alt = item.imageAlt;
  document.getElementById('portal-detail-tag').textContent = item.tag;
  document.getElementById('portal-detail-title').textContent = item.title;
  document.getElementById('portal-detail-score').innerHTML = item.score + '<span>' + item.scoreText + '</span>';
  document.getElementById('portal-detail-desc').textContent = item.desc;
  document.getElementById('portal-detail-reasons').innerHTML = item.reasons.map(function(reason) {
    return '<li>' + escapeHtml(reason) + '</li>';
  }).join('');
  document.getElementById('portal-detail-reviews').innerHTML = item.reviews.map(function(review) {
    return '<div class="portal-review"><strong>' + escapeHtml(review[0]) + '</strong><span>' + escapeHtml(review[1]) + '</span></div>';
  }).join('');
  const primary = document.getElementById('portal-detail-primary');
  primary.textContent = item.actionText;
  primary.onclick = function() {
    closePortalHotDetail();
    switchPage(item.actionPage);
    if (item.actionPage === 'marketing') {
      const dest = document.getElementById('mkt-destination');
      if (dest) dest.value = item.title;
    }
    if (item.actionPage === 'plan') {
      const city = document.getElementById('plan-city');
      if (city) city.value = item.title.indexOf('西湖') >= 0 || item.title.indexOf('运河') >= 0 ? '杭州' : item.title;
    }
    if (item.actionPage === 'chat') {
      setTimeout(function() {
        const input = document.getElementById('msg-input');
        if (input) {
          input.value = '请详细介绍' + item.title + '，并推荐适合我的玩法。';
          input.focus();
        }
      }, 260);
    }
  };
  overlay.classList.add('show');
  overlay.setAttribute('aria-hidden', 'false');
  document.querySelector('.pages-container')?.setAttribute('inert', '');
  document.querySelector('.top-nav')?.setAttribute('inert', '');
  document.body.style.overflow = 'hidden';
  setTimeout(function(){ document.querySelector('.portal-detail-close')?.focus(); }, 20);
}

function closePortalHotDetail() {
  const overlay = document.getElementById('portal-detail-overlay');
  if (!overlay) return;
  overlay.classList.remove('show');
  overlay.setAttribute('aria-hidden', 'true');
  document.querySelector('.pages-container')?.removeAttribute('inert');
  document.querySelector('.top-nav')?.removeAttribute('inert');
  document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closePortalHotDetail();
    closeOpsDetail();
  }
});

// ===== OPS DASHBOARD =====
let opsDashboardData = null;
let opsDetailMap = {};

function opsRegister(item) {
  if (!item || !item.id) return '';
  opsDetailMap[item.id] = item;
  return item.id;
}

function loadOpsDashboard() {
  const kpiGrid = document.getElementById('ops-kpi-grid');
  const trendList = document.getElementById('ops-trend-list');
  const taskList = document.getElementById('ops-task-list');
  if (!kpiGrid || !trendList || !taskList) return;
  kpiGrid.innerHTML = '<div class="ops-loading">正在聚合授权热点、平台灵感、票务产品和业务统计...</div>';
  trendList.innerHTML = '';
  taskList.innerHTML = '';
  fetch(BACKEND + '/api/ops/dashboard?city=' + encodeURIComponent('杭州') + '&keyword=' + encodeURIComponent('文旅'), {cache:'no-store'})
    .then(function(resp){ return resp.json(); })
    .then(function(data) {
      if (!data || data.success === false) throw new Error(data?.error || '运营看板数据读取失败');
      renderOpsDashboard(data);
    })
    .catch(function(err) {
      kpiGrid.innerHTML = '<div class="ops-loading">真实运营数据暂时不可用：' + escapeHtml(String(err.message || err)) + '<br>请确认后端服务已重启。</div>';
    });
}

function renderOpsDashboard(data) {
  opsDashboardData = data;
  opsDetailMap = {};
  const time = document.getElementById('ops-dashboard-time');
  if (time) time.textContent = (data.city || '杭州') + ' · 真实运营数据 · ' + String(data.updated_at || '').replace('T', ' ') + ' 更新';

  const kpiGrid = document.getElementById('ops-kpi-grid');
  kpiGrid.innerHTML = (data.kpis || []).map(function(kpi) {
    const id = opsRegister(Object.assign({kind:'kpi'}, kpi));
    return '<button class="ops-kpi" type="button" onclick="openOpsDetail(&quot;' + escapeHtml(id) + '&quot;)">'
      + '<div class="ops-kpi-label">' + escapeHtml(kpi.label || '') + '</div>'
      + '<div class="ops-kpi-value">' + escapeHtml(kpi.value || '-') + '</div>'
      + '<div class="ops-kpi-trend">' + escapeHtml(kpi.trend || '') + '</div>'
      + '</button>';
  }).join('');

  const trendList = document.getElementById('ops-trend-list');
  trendList.innerHTML = (data.trends || []).map(function(item, idx) {
    const id = opsRegister(Object.assign({kind:'trend'}, item));
    const score = Math.max(8, Math.min(100, Number(item.score || 70)));
    return '<button class="ops-trend-item" type="button" onclick="openOpsDetail(&quot;' + escapeHtml(id) + '&quot;)">'
      + '<div class="ops-trend-rank">' + escapeHtml(String(item.rank || idx + 1)) + '</div>'
      + '<div><div class="ops-trend-name">' + escapeHtml(item.title || '文旅热点') + '</div><div class="ops-trend-meta">' + escapeHtml(item.meta || data.city || '') + '</div></div>'
      + '<div class="ops-trend-score">' + score + '</div>'
      + '<div class="ops-bar"><span style="width:' + score + '%"></span></div>'
      + '</button>';
  }).join('') || '<div class="ops-loading">暂无热点机会，稍后可点击更新市场热点。</div>';

  const taskList = document.getElementById('ops-task-list');
  taskList.innerHTML = (data.tasks || []).map(function(task) {
    const id = opsRegister(Object.assign({kind:'task'}, task));
    return '<button class="ops-task" type="button" onclick="openOpsDetail(&quot;' + escapeHtml(id) + '&quot;)">'
      + '<div class="ops-task-icon">' + escapeHtml(task.icon || '任') + '</div>'
      + '<div><b>' + escapeHtml(task.title || '运营任务') + '</b><span>' + escapeHtml(task.desc || '') + '</span></div>'
      + '</button>';
  }).join('');

  const brief = data.brief || {};
  const briefId = opsRegister(Object.assign({kind:'brief'}, brief));
  const briefEl = document.getElementById('ops-brief');
  if (briefEl) {
    briefEl.dataset.opsId = briefId;
    briefEl.onclick = function(event) {
      if (event.target && event.target.tagName === 'BUTTON') return;
      openOpsDetail(briefId);
    };
    briefEl.onkeydown = function(event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openOpsDetail(briefId);
      }
    };
  }
  const bt = document.getElementById('ops-brief-title');
  const bd = document.getElementById('ops-brief-desc');
  if (bt) bt.textContent = brief.title || '今日重点';
  if (bd) bd.textContent = brief.desc || data.source_note || '';
}

function openOpsDetail(id) {
  const item = opsDetailMap[id];
  const overlay = document.getElementById('ops-detail-overlay');
  if (!item || !overlay) return;
  const kindLabel = item.kind === 'kpi' ? '真实数据指标' : item.kind === 'trend' ? '热点机会详情' : item.kind === 'task' ? '建议任务详情' : '今日运营重点';
  document.getElementById('ops-detail-kicker').textContent = kindLabel;
  document.getElementById('ops-detail-title').textContent = item.title || item.label || '运营详情';
  const meta = [];
  if (item.value) meta.push(item.value);
  if (item.trend) meta.push(item.trend);
  if (item.score) meta.push('热度 ' + item.score);
  if (item.source) meta.push('来源：' + item.source);
  document.getElementById('ops-detail-meta').innerHTML = meta.map(function(v){ return '<span>' + escapeHtml(String(v)) + '</span>'; }).join('');
  document.getElementById('ops-detail-desc').textContent = item.detail || item.summary || item.desc || '该项来自运营看板聚合数据。';
  const list = []
    .concat(Array.isArray(item.highlights) ? item.highlights : [])
    .concat(Array.isArray(item.pitfalls) ? item.pitfalls.map(function(v){ return '避坑：' + v; }) : []);
  document.getElementById('ops-detail-list').innerHTML = (list.length ? list : [
    '数据来自平台已有接口与业务数据库聚合，不再使用纯静态展示。',
    opsDashboardData?.source_note || '外部热点仅使用官方/授权接口或已配置服务。'
  ]).slice(0, 5).map(function(v){ return '<li>' + escapeHtml(String(v)) + '</li>'; }).join('');
  const actions = document.getElementById('ops-detail-actions');
  const url = safeExternalUrl(item.url || '');
  const action = item.action || (item.kind === 'trend' ? 'community' : 'marketing');
  actions.innerHTML =
    '<button type="button" onclick="closeOpsDetail();switchPage(&quot;' + escapeHtml(action) + '&quot;)">进入相关功能</button>'
    + (url ? '<a class="secondary" href="' + escapeHtml(url) + '" target="_blank" rel="noopener noreferrer">查看原始来源</a>' : '')
    + '<button class="secondary" type="button" onclick="closeOpsDetail()">关闭</button>';
  overlay.classList.add('open');
  overlay.setAttribute('aria-hidden', 'false');
  document.querySelector('.pages-container')?.setAttribute('inert', '');
  document.body.style.overflow = 'hidden';
  setTimeout(function(){ document.querySelector('.ops-detail-close')?.focus(); }, 20);
}

function closeOpsDetail() {
  const overlay = document.getElementById('ops-detail-overlay');
  if (!overlay) return;
  overlay.classList.remove('open');
  overlay.setAttribute('aria-hidden', 'true');
  document.querySelector('.pages-container')?.removeAttribute('inert');
  document.body.style.overflow = '';
}

// ===== COMMUNITY FORUM =====
const defaultCommunityPosts = [
  { id:'p1', type:'route', title:'杭州 2 天 1 晚宋韵 Citywalk，不赶路版本', author:'阿晚', tag:'路线攻略', views:3420, favs:612, image:'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80', content:'第一天走西湖和南宋御街，第二天去运河边喝茶看展。建议早上拍湖边，下午安排非遗手作，晚上再做夜游。' },
  { id:'p2', type:'food', title:'龙井虾仁之外，杭州本地人更爱这些小馆', author:'七月饭团', tag:'美食餐饮', views:2880, favs:845, image:'https://images.unsplash.com/photo-1551218808-94e220e084d2?auto=format&fit=crop&w=900&q=80', content:'不要只盯着热门商圈，居民区附近的小馆更稳定。推荐把杭帮菜安排在行程中段，避免第一天太油腻。' },
  { id:'p3', type:'culture', title:'良渚博物院文创怎么买不踩雷', author:'山谷买手', tag:'文创非遗', views:1760, favs:520, image:'https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?auto=format&fit=crop&w=900&q=80', content:'优先选有文化符号解释的小件，玉鸟、神人兽面纹都比较好讲故事，适合做伴手礼。' },
  { id:'p4', type:'photo', title:'运河夜游拍照机位：这 4 个点最出片', author:'橘子相机', tag:'拍照打卡', views:4120, favs:1090, image:'https://images.unsplash.com/photo-1514924013411-cbf25faa35bb?auto=format&fit=crop&w=900&q=80', content:'蓝调时刻比完全天黑更好拍。建议带长焦，桥洞、灯影和船只都能形成层次。' }
];
let communityFilter = 'all';
let communityPosts = [];

function loadCommunityPosts() {
  try {
    const saved = JSON.parse(localStorage.getItem('st_community_posts') || 'null');
    communityPosts = Array.isArray(saved) && saved.length ? saved : defaultCommunityPosts.slice();
  } catch(e) {
    communityPosts = defaultCommunityPosts.slice();
  }
}

function saveCommunityPosts() {
  localStorage.setItem('st_community_posts', JSON.stringify(communityPosts));
}

function renderCommunity() {
  const feed = document.getElementById('community-feed');
  if (!feed) return;
  const list = communityPosts.filter(function(post) {
    if (isGenericHotspotTitle(post.title)) return false;
    return communityFilter === 'all' || post.type === communityFilter;
  });
  feed.innerHTML = list.map(function(post) {
    return '<article class="community-post" role="button" tabindex="0" data-community-id="' + escapeHtml(post.id) + '">'
      + '<div class="community-post-img" data-tag="' + escapeHtml(post.tag) + '"><img src="' + post.image + '" alt="' + escapeHtml(post.title) + '"></div>'
      + '<div class="community-post-body"><h3>' + escapeHtml(post.title) + '</h3><p>' + escapeHtml(post.content) + '</p>'
      + '<div class="community-meta"><span>by ' + escapeHtml(post.author) + ' · ' + post.views + ' 次浏览</span>'
      + '<div class="community-actions"><button onclick="event.stopPropagation();openCommunityPost(&quot;' + escapeHtml(post.id) + '&quot;)">查看详情</button><button onclick="event.stopPropagation();favoriteCommunityPost(&quot;' + escapeHtml(post.id) + '&quot;)">收藏 ' + post.favs + '</button></div></div></div>'
      + '</article>';
  }).join('');
  feed.querySelectorAll('.community-post[data-community-id]').forEach(function(card) {
    card.addEventListener('click', function(event) {
      if (event.target.closest('.community-actions')) return;
      const id = card.getAttribute('data-community-id');
      if (id) openCommunityPost(id);
    });
    card.addEventListener('keydown', function(event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const id = card.getAttribute('data-community-id');
        if (id) openCommunityPost(id);
      }
    });
  });
  renderCommunityRanks();
}

function renderCommunityRanks() {
  renderCommunityRank('community-click-rank', communityPosts.slice().sort(function(a,b){return b.views-a.views;}), 'views', '次浏览');
  renderCommunityRank('community-fav-rank', communityPosts.slice().sort(function(a,b){return b.favs-a.favs;}), 'favs', '次收藏');
}

function renderCommunityRank(id, list, field, suffix) {
  const el = document.getElementById(id);
  if (!el) return;
  el.innerHTML = list.slice(0,5).map(function(post, idx) {
    return '<div class="rank-item" onclick="openCommunityPost(&quot;' + escapeHtml(post.id) + '&quot;)"><span class="rank-no">' + (idx + 1) + '</span><span class="rank-title">' + escapeHtml(post.title) + '</span><span class="rank-num">' + post[field] + suffix + '</span></div>';
  }).join('');
}

function filterCommunity(type, btn) {
  communityFilter = type;
  document.querySelectorAll('[data-community-filter]').forEach(function(item){ item.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  renderCommunity();
}

function publishCommunityPost() {
  const title = document.getElementById('community-title')?.value.trim();
  const tags = document.getElementById('community-tags')?.value.trim();
  const content = document.getElementById('community-content')?.value.trim();
  if (!title || !content) {
    showToast('请至少填写标题和心得内容', 'warning');
    return;
  }
  const type = tags.indexOf('吃') >= 0 || tags.indexOf('餐') >= 0 || tags.indexOf('美食') >= 0 ? 'food'
    : tags.indexOf('文创') >= 0 || tags.indexOf('非遗') >= 0 ? 'culture'
    : tags.indexOf('拍') >= 0 || tags.indexOf('打卡') >= 0 ? 'photo'
    : 'route';
  communityPosts.unshift({
    id: 'p' + Date.now(),
    type: type,
    title: title,
    author: '旅行者',
    tag: tags || '用户攻略',
    views: 1,
    favs: 0,
    image: 'https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?auto=format&fit=crop&w=900&q=80',
    content: content
  });
  ['community-title','community-tags','community-content'].forEach(function(id){ const el=document.getElementById(id); if(el) el.value=''; });
  saveCommunityPosts();
  filterCommunity('all', document.querySelector('[data-community-filter="all"]'));
  showToast('攻略已发布到社区', 'success');
}

function openCommunityPost(id) {
  const post = communityPosts.find(function(item){ return item.id === id; });
  if (!post) return;
  post.views += 1;
  saveCommunityPosts();
  const modal = document.getElementById('community-detail-modal');
  const sourceUrl = safeExternalUrl(post.source_url || post.url || '');
  const imageModeText = post.image_mode === 'cartoon' ? '未匹配到可信实图，已使用卡通主题图替代。' : '图片来自平台封面或本地内容素材。';
  document.getElementById('cdm-img').src = post.image || '';
  document.getElementById('cdm-img').alt = post.title || '社区攻略图片';
  document.getElementById('cdm-tag').textContent = post.tag || '社区攻略';
  document.getElementById('cdm-title').textContent = post.title || '未命名攻略';
  document.getElementById('cdm-meta').innerHTML = [
    '作者：' + escapeHtml(post.author || '旅行者'),
    '浏览：' + Number(post.views || 0),
    '收藏：' + Number(post.favs || 0),
    post.source === 'official' ? '来源：抖音热点识别' : (post.source === 'market_hot' ? '来源：市场趋势包' : '来源：社区用户')
  ].map(function(text){ return '<span>' + text + '</span>'; }).join('');
  document.getElementById('cdm-content').textContent = post.content || post.summary || '暂无详细内容。';
  document.getElementById('cdm-note').textContent = imageModeText + (sourceUrl ? ' 可点击原平台入口查看完整内容。' : '');
  const sourceLink = document.getElementById('cdm-source');
  if (sourceUrl) {
    sourceLink.href = sourceUrl;
    sourceLink.style.display = '';
  } else {
    sourceLink.href = '#';
    sourceLink.style.display = 'none';
  }
  modal.dataset.postId = post.id;
  modal.classList.add('open');
  renderCommunity();
}

function closeCommunityPostModal(event) {
  if (event) event.stopPropagation();
  const modal = document.getElementById('community-detail-modal');
  if (modal) modal.classList.remove('open');
}

function favoriteCommunityPostFromModal() {
  const modal = document.getElementById('community-detail-modal');
  const id = modal?.dataset?.postId;
  if (!id) return;
  favoriteCommunityPost(id);
  const post = communityPosts.find(function(item){ return item.id === id; });
  if (post) {
    document.getElementById('cdm-meta').innerHTML = [
      '作者：' + escapeHtml(post.author || '旅行者'),
      '浏览：' + Number(post.views || 0),
      '收藏：' + Number(post.favs || 0),
      post.source === 'official' ? '来源：抖音热点识别' : (post.source === 'market_hot' ? '来源：市场趋势包' : '来源：社区用户')
    ].map(function(text){ return '<span>' + text + '</span>'; }).join('');
  }
}

function favoriteCommunityPost(id) {
  const post = communityPosts.find(function(item){ return item.id === id; });
  if (!post) return;
  post.favs += 1;
  saveCommunityPosts();
  renderCommunity();
  showToast('已收藏：' + post.title, 'success');
}

let platformHotspotsLoaded = false;

function safeExternalUrl(url) {
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : '';
  } catch(e) {
    return '';
  }
}

function renderPlatformHotspots(data) {
  const el = document.getElementById('platform-hot-list');
  if (!el) return;
  const items = Array.isArray(data?.items) ? data.items : [];
  if (items.length) {
    el.innerHTML = items.slice(0, 6).map(function(item) {
      const href = safeExternalUrl(item.url || '');
      const heat = item.heat ? ' · 热度 ' + escapeHtml(item.heat) : '';
      const author = item.author ? ' · ' + escapeHtml(item.author) : '';
      return '<a href="' + (href ? escapeHtml(href) : 'javascript:void(0)') + '"' + (href ? ' target="_blank" rel="noopener noreferrer"' : '') + '>'
        + '<div class="platform-meta"><span>' + escapeHtml(item.platform || '官方平台') + '</span><span>' + heat + author + '</span></div>'
        + '<b>' + escapeHtml(item.title || '未命名热点') + '</b>'
        + '<span>' + escapeHtml(item.summary || '来自官方/授权接口的数据') + '</span>'
        + '</a>';
    }).join('');
    return;
  }

  const sources = Array.isArray(data?.sources) ? data.sources : [];
  if (sources.length) {
    el.innerHTML = sources.map(function(source) {
      const required = Array.isArray(source.required_env) ? '<br>需配置：' + source.required_env.map(escapeHtml).join('、') : '';
      return '<div class="platform-status"><strong>' + escapeHtml(source.provider || '平台') + '：'
        + escapeHtml(source.status || '待配置') + '</strong><br>' + escapeHtml(source.message || '尚未返回官方数据') + required + '</div>';
    }).join('');
    return;
  }

  el.innerHTML = '<div class="platform-status">暂未获取到官方平台数据。请确认后端服务已启动，并已配置官方授权接口。</div>';
}

let xhsNotesLoaded = false;
let xhsNotesCache = [];

function fillXhsFacets(facets) {
  const pairs = [
    ['xhs-source-filter', facets?.source_type || []],
    ['xhs-city-filter', facets?.city || []],
    ['xhs-theme-filter', facets?.theme || []],
    ['xhs-crowd-filter', facets?.crowd || []]
  ];
  pairs.forEach(function(pair) {
    const el = document.getElementById(pair[0]);
    if (!el || el.dataset.ready === '1') return;
    const labelMap = {'xhs_search':'小红书','douyin_search':'抖音','market_hot':'市场热点','official_hot':'官方实时'};
    const defaultLabel = pair[0] === 'xhs-source-filter' ? '全部平台' : '全部';
    el.innerHTML = '<option value="全部">' + defaultLabel + '</option>' + pair[1].map(function(value) {
      return '<option value="' + escapeHtml(value) + '">' + escapeHtml(labelMap[value] || value) + '</option>';
    }).join('');
    el.dataset.ready = '1';
  });
}

function getInspirationSourceLabel(sourceType) {
  if (sourceType === 'market_hot') return '市场热点';
  if (sourceType === 'official_hot') return '官方实时';
  if (sourceType === 'douyin_search') return '抖音灵感';
  if (sourceType === 'xhs_search') return '小红书灵感';
  return '平台灵感';
}

function getInspirationSourceShort(sourceType) {
  if (sourceType === 'market_hot') return '市场';
  if (sourceType === 'official_hot') return '官方';
  if (sourceType === 'douyin_search') return '抖音';
  if (sourceType === 'xhs_search') return '小红书';
  return '原平台';
}

// 通用热点标题检测 —— 过滤"抖音热点""抖音精选"等无具体景点/美食内容的卡片
var GENERIC_HOTSPOT_TITLES = new Set([
  '抖音','热点','热门','未命名热点','抖音热点','抖音精选','抖音课堂',
  '实时平台','抖音热搜','热榜','热搜','热门话题','实时热点','实时',
  '小红书','小红书热点','小红书热搜','推荐','榜单','排行榜','热门推荐',
  '抖音推荐','精选','课堂','话题','官方','授权','平台数据',
]);
var GENERIC_TITLE_PARTICLES = [
  '抖音','小红书','热点','热门','精选','课堂','热搜','热榜',
  '实时','平台','推荐','榜单','排行榜','话题','官方','授权',
  '接口','数据','最新','今日','首发','独家',
];
function isGenericHotspotTitle(title) {
  if (!title) return true;
  title = String(title).trim();
  if (!title || GENERIC_HOTSPOT_TITLES.has(title)) return true;
  var remaining = title;
  GENERIC_TITLE_PARTICLES.forEach(function(w) { remaining = remaining.split(w).join(''); });
  remaining = remaining.replace(/[\s\-_|·｜\/,，、。.!！?？:：;；()（）\[\]【】「」""'\\]+/g, '');
  return remaining.length < 2;
}

function renderXhsNotes(items, facets) {
  const grid = document.getElementById('xhs-grid');
  const summary = document.getElementById('xhs-summary');
  if (!grid) return;
  // 过滤掉通用平台热点标题（如"抖音热点""抖音精选"等无具体内容的卡片）
  var filtered = (Array.isArray(items) ? items : []).filter(function(item) {
    return !isGenericHotspotTitle(item.title);
  });
  xhsNotesCache = filtered;
  if (summary) {
    summary.textContent = '已导入 ' + (facets?.total || items.length || 0) + ' 条灵感元数据，当前显示 ' + filtered.length + ' 条。';
  }
  if (!filtered.length) {
    grid.innerHTML = '<div class="xhs-empty">没有匹配的灵感内容，请换个城市、主题或关键词。</div>';
    return;
  }
  grid.innerHTML = filtered.map(function(item) {
    const tags = Array.isArray(item.tags) ? item.tags : [];
    const highlights = Array.isArray(item.highlights) ? item.highlights : [];
    const pitfalls = Array.isArray(item.pitfalls) ? item.pitfalls : [];
    const href = safeExternalUrl(item.source_url || '');
    const sourceLabel = getInspirationSourceLabel(item.source_type);
    const sourceShort = getInspirationSourceShort(item.source_type);
    const noteId = escapeHtml(item.note_id || '');
    return '<article class="xhs-card" role="button" tabindex="0" data-xhs-note-id="' + noteId + '" onclick="if(!event.target.closest(&quot;.xhs-actions&quot;))openXhsNoteDetail(&quot;' + noteId + '&quot;)" onkeydown="if(event.key===&quot;Enter&quot;||event.key===&quot; &quot;){event.preventDefault();openXhsNoteDetail(&quot;' + noteId + '&quot;)}">'
      + '<div class="xhs-card-head"><span class="xhs-badge">' + escapeHtml(sourceLabel) + ' · ' + escapeHtml(item.theme || '灵感') + '</span><span class="xhs-score">热度 ' + escapeHtml(String(item.score || 0)) + '</span></div>'
      + '<h3>' + escapeHtml(item.title || '未命名灵感') + '</h3>'
      + '<div class="xhs-meta"><span>' + escapeHtml(item.city || '') + '</span><span>' + escapeHtml(item.crowd || '不限人群') + '</span><span>' + escapeHtml(item.duration_suggestion || '') + '</span><span>' + escapeHtml(item.budget_level || '') + '</span></div>'
      + '<p>' + escapeHtml(item.summary || '') + '</p>'
      + (highlights.length ? '<ul class="xhs-list">' + highlights.slice(0, 3).map(function(v){ return '<li>' + escapeHtml(v) + '</li>'; }).join('') + '</ul>' : '')
      + (pitfalls.length ? '<div class="xhs-meta">避坑：' + pitfalls.slice(0, 2).map(escapeHtml).join('；') + '</div>' : '')
      + '<div class="xhs-tags">' + tags.slice(0, 6).map(function(tag){ return '<span class="xhs-tag">' + escapeHtml(tag) + '</span>'; }).join('') + '</div>'
      + '<div class="xhs-actions">'
      + '<button class="primary" onclick="openXhsNoteDetail(&quot;' + noteId + '&quot;)">查看详情</button>'
      + '<button onclick="useXhsForPlan(&quot;' + noteId + '&quot;)">加入行程筛选</button>'
      + (href ? '<a href="' + escapeHtml(href) + '" target="_blank" rel="noopener noreferrer">查看' + escapeHtml(sourceShort) + '结果</a>' : '')
      + '</div>'
      + '</article>';
  }).join('');
}

function buildXhsFallbackImage(item) {
  const title = escapeHtml((item?.title || '文旅灵感').slice(0, 18));
  const theme = escapeHtml(item?.theme || item?.city || '社区精选');
  return 'data:image/svg+xml;charset=UTF-8,'
    + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 520"><defs><linearGradient id="g" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#f5d49b"/><stop offset="1" stop-color="#68b7a8"/></linearGradient></defs><rect width="900" height="520" fill="url(#g)"/><circle cx="720" cy="120" r="78" fill="#fff7" /><path d="M90 385 C210 260 310 310 420 205 C520 110 645 225 810 330 L810 520 L90 520 Z" fill="#245b53" opacity=".42"/><path d="M95 390 C250 300 350 330 500 260 C620 205 720 280 820 360" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="round" opacity=".72"/><text x="70" y="92" font-size="34" font-family="Arial,Microsoft YaHei,sans-serif" fill="#25352f" font-weight="700">' + title + '</text><text x="70" y="142" font-size="22" font-family="Arial,Microsoft YaHei,sans-serif" fill="#40554e">' + theme + ' · 卡通替代图</text></svg>');
}

async function openXhsNoteDetail(noteId) {
  const modal = document.getElementById('community-detail-modal');
  if (!modal || !noteId) return;
  let item = xhsNotesCache.find(function(note){ return String(note.note_id) === String(noteId); });
  try {
    const data = await apiFetch(BACKEND + '/api/xhs/notes/' + encodeURIComponent(noteId), {__noToast:true});
    if (data?.item) item = data.item;
  } catch(e) {}
  if (!item) {
    showToast('暂未找到这条社区灵感详情，请刷新后重试', 'warning');
    return;
  }
  const tags = Array.isArray(item.tags) ? item.tags : [];
  const highlights = Array.isArray(item.highlights) ? item.highlights : [];
  const pitfalls = Array.isArray(item.pitfalls) ? item.pitfalls : [];
  const sourceUrl = safeExternalUrl(item.source_url || '');
  const image = item.image || item.cover_url || item.thumbnail || buildXhsFallbackImage(item);
  document.getElementById('cdm-img').src = image;
  document.getElementById('cdm-img').alt = item.title || '平台灵感详情图';
  document.getElementById('cdm-tag').textContent = (item.city || '社区精选') + ' · ' + (item.theme || getInspirationSourceLabel(item.source_type));
  document.getElementById('cdm-title').textContent = item.title || '未命名灵感';
  document.getElementById('cdm-meta').innerHTML = [
    '来源：' + getInspirationSourceLabel(item.source_type),
    '热度：' + Number(item.score || 0),
    item.crowd ? '人群：' + item.crowd : '',
    item.duration_suggestion ? '建议：' + item.duration_suggestion : '',
    item.budget_level ? '预算：' + item.budget_level : ''
  ].filter(Boolean).map(function(text){ return '<span>' + escapeHtml(text) + '</span>'; }).join('');
  const detailLines = []
    .concat(item.summary ? ['摘要：' + item.summary] : [])
    .concat(highlights.length ? ['亮点：' + highlights.join('；')] : [])
    .concat(pitfalls.length ? ['避坑：' + pitfalls.join('；')] : [])
    .concat(tags.length ? ['标签：' + tags.join('、')] : []);
  document.getElementById('cdm-content').textContent = detailLines.join('\n\n') || '暂无详细内容。';
  document.getElementById('cdm-note').textContent = sourceUrl ? '可点击原平台入口查看完整内容。' : '未匹配到可信实图或外部入口时，使用卡通主题图和平台摘要展示。';
  const sourceLink = document.getElementById('cdm-source');
  if (sourceUrl) {
    sourceLink.href = sourceUrl;
    sourceLink.style.display = '';
  } else {
    sourceLink.href = '#';
    sourceLink.style.display = 'none';
  }
  modal.dataset.noteId = noteId;
  modal.classList.add('open');
}

async function loadXhsNotes() {
  const keyword = document.getElementById('xhs-keyword')?.value.trim() || '';
  const sourceType = document.getElementById('xhs-source-filter')?.value || '全部';
  const city = document.getElementById('xhs-city-filter')?.value || '全部';
  const theme = document.getElementById('xhs-theme-filter')?.value || '全部';
  const crowd = document.getElementById('xhs-crowd-filter')?.value || '全部';
  const params = new URLSearchParams();
  if (keyword) params.set('keyword', keyword);
  if (sourceType !== '全部') params.set('source_type', sourceType);
  if (city !== '全部') params.set('city', city);
  if (theme !== '全部') params.set('theme', theme);
  if (crowd !== '全部') params.set('crowd', crowd);
  params.set('limit', '80');
  const grid = document.getElementById('xhs-grid');
  if (grid) grid.innerHTML = '<div class="xhs-empty">正在读取平台灵感库...</div>';
  try {
    const data = await apiFetch(BACKEND + '/api/xhs/notes?' + params.toString(), {__noToast:true});
    fillXhsFacets(data.facets || {});
    renderXhsNotes(data.items || [], data.facets || {});
    xhsNotesLoaded = true;
  } catch(e) {
    if (grid) grid.innerHTML = '<div class="xhs-empty">灵感库读取失败，请确认后端服务已重启并完成数据库初始化。</div>';
  }
}

function resetXhsFilters() {
  ['xhs-source-filter','xhs-city-filter','xhs-theme-filter','xhs-crowd-filter'].forEach(function(id) {
    const el = document.getElementById(id);
    if (el) el.value = '全部';
  });
  const kw = document.getElementById('xhs-keyword');
  if (kw) kw.value = '';
  loadXhsNotes();
}

async function useXhsForPlan(noteId) {
  try {
    const data = await apiFetch(BACKEND + '/api/xhs/notes/' + encodeURIComponent(noteId), {__noToast:true});
    const item = data.item;
    if (!item) return;
    switchPage('plan');
    setTimeout(function() {
      const city = document.getElementById('plan-city');
      const focus = document.getElementById('plan-conversion-focus');
      const needs = document.getElementById('plan-special-needs');
      if (city) city.value = item.city || item.destination || '';
      if (focus) focus.value = '参考' + getInspirationSourceLabel(item.source_type) + '：' + item.title + '；重点玩法：' + (Array.isArray(item.tags) ? item.tags.join('、') : '');
      if (needs) needs.value = '结合用户筛选偏好，避开：' + (Array.isArray(item.pitfalls) ? item.pitfalls.join('；') : '');
    }, 220);
    showToast('已把灵感加入行程规划参数', 'success');
  } catch(e) {
    showToast('加入行程失败', 'error');
  }
}

async function loadPlatformHotspots(force) {
  const el = document.getElementById('platform-hot-list');
  if (!el) return;
  if (platformHotspotsLoaded && !force) return;
  el.innerHTML = '<div class="platform-status">正在读取官方/授权平台数据...</div>';
  try {
    const resp = await fetch(BACKEND + '/api/social/hotspots?keyword=' + encodeURIComponent('文旅') + '&city=' + encodeURIComponent('杭州'), { cache: 'no-store' });
    const data = await resp.json();
    platformHotspotsLoaded = true;
    renderPlatformHotspots(data);
  } catch(e) {
    el.innerHTML = '<div class="platform-status">无法连接后端官方数据接口。请通过后端服务启动页面，或检查 `/api/social/hotspots` 是否可访问。</div>';
  }
}

loadCommunityPosts();
loadPlatformHotspots();
loadOpsDashboard();

// ===== PAGE SWITCHING =====
function switchPage(name) {
  document.querySelectorAll('.page').forEach(p => {
    const isActive = p.id === 'page-' + name;
    p.classList.toggle('active', isActive);
    p.setAttribute('aria-hidden', isActive ? 'false' : 'true');
    p.inert = !isActive;
  });
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.body.classList.toggle('portal-mode', name === 'home');
  const pageEl = document.getElementById('page-' + name);
  if (pageEl) pageEl.classList.add('active');
  const tabEl = document.querySelector('[data-page="' + name + '"]');
  if (tabEl) tabEl.classList.add('active');

  // Initialize maps when switching to relevant pages
  if (name === 'plan' && planMapLoaded && planMap) {
    setTimeout(() => { planMap.setFitView(); }, 200);
  }
  if (name === 'community') {
    renderCommunity();
    loadPlatformHotspots();
    loadXhsNotes();
    refreshMarketHotContent(false);
  }
  if (name === 'home' && !opsDashboardData) {
    loadOpsDashboard();
  }
}

function sendHomePrompt(text) {
  const prompt = (text || '').trim();
  switchPage('chat');
  setTimeout(function() {
    const input = document.getElementById('msg-input');
    if (!input) return;
    input.focus();
    if (!prompt) return;
    input.value = prompt;
    if (typeof sendMessage === 'function') sendMessage(prompt);
  }, 260);
}

// Nav tabs
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', () => switchPage(tab.dataset.page));
  });
  switchPage(document.querySelector('.page.active')?.id.replace('page-', '') || 'home');
  loadOpsDashboard();
  renderCommunity();
  renderInspireProducts();
  scheduleMarketHotRefresh();
  const xhsKeyword = document.getElementById('xhs-keyword');
  if (xhsKeyword) {
    xhsKeyword.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') loadXhsNotes();
    });
  }
});

// ===== HOME PARTICLES =====
function spawnParticles() {
  const container = document.getElementById('particles');
  if (!container) return;
  for (let i = 0; i < 30; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.position = 'absolute';
    p.style.left = Math.random() * 90 + '%';
    p.style.bottom = Math.random() * 40 + '%';
    p.style.setProperty('--dur', (6 + Math.random() * 10) + 's');
    p.style.setProperty('--delay', (Math.random() * 8) + 's');
    p.style.width = (2 + Math.random() * 3) + 'px';
    p.style.height = p.style.width;
    container.appendChild(p);
  }
}
spawnParticles();

// ===== MAPS =====
let planMap, planMarkers = [], planInfoWins = [], userMarker = null;
let currentRouteMode = 'driving'; // driving, transit, walking, bicycling
let lastGeocodedPOIs = []; // store last route POIs for re-rendering on mode change
let lastRouteStats = null; // { totalDist, totalDur }

function setRouteMode(mode, btn) {
  currentRouteMode = mode;
  document.querySelectorAll('.plan-transport-btn').forEach(function(b) { b.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  // If we already have POIs, re-draw the route with new mode
  if (lastGeocodedPOIs.length >= 2) {
    drawPlanRoute(lastGeocodedPOIs);
  }
}

function loadAmap() {
  fetch(BACKEND + '/api/map/key').then(r => r.json()).then(d => {
    amapKey = d.key || '';
    if (amapKey) {
      loadAmapSDK(amapKey);
    }
  }).catch(function(e) {
    console.warn('地图 Key 获取失败，使用 fallback:', e);
    const fallbackKey = 'c022c28ed90dec336e7d594bd754b354';
    loadAmapSDK(fallbackKey);
  });
}

function loadAmapSDK(key) {
  amapKey = key || amapKey;
  if (document.getElementById('amap-sdk')) return;
  const s = document.createElement('script');
  s.id = 'amap-sdk';
  s.src = 'https://webapi.amap.com/maps?v=2.0&key=' + amapKey + '&plugin=AMap.Geocoder,AMap.PlaceSearch,AMap.Geolocation,AMap.CitySearch,AMap.Driving,AMap.Walking,AMap.Transfer';
  s.onload = initAllMaps;
  s.onerror = function() { console.warn('AMap SDK load failed, falling back to GPS/IP'); initUserLocation(); };
  document.head.appendChild(s);
}

function initAllMaps() {
  initPlanMap();
  initUserLocation();
}

function initPlanMap() {
  const container = document.getElementById('plan-map-container');
  if (!container || !AMap) return;
  planMap = new AMap.Map('plan-map-container', {
    zoom: 5, center: [116.397428, 39.90923], resizeEnable: true
  });
  planMapLoaded = true;
}

async function locateUser() {
  const activeMap = planMap;
  if (!activeMap) return;

  // === Try 1: AMap Geolocation (高德官方定位，精度最高) ===
  try {
    if (typeof AMap !== 'undefined' && AMap.Geolocation) {
      var geo = new AMap.Geolocation({
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 0,
        noIpLocate: 0,
        useNative: true,
        GeoLocationFirst: true
      });
      var result = await new Promise(function(resolve, reject) {
        geo.getCurrentPosition(function(status, res) {
          if (status === 'complete') resolve(res);
          else reject(res);
        });
      });
      if (result && result.position) {
        var city = (result.addressComponent && result.addressComponent.city) || '';
        var district = (result.addressComponent && result.addressComponent.district) || '';
        var addr = result.formattedAddress || '';
        // 高德定位未返回地址时，逆地理编码补充
        if (!city && !district && !addr) {
          try {
            var rg = await fetch(BACKEND + '/api/map/regeo', {
              method: 'POST', headers: {'Content-Type':'application/json'},
              body: JSON.stringify({lng: result.position.lng, lat: result.position.lat})
            });
            var rd = await rg.json();
            if (rd.status === 'ok') {
              city = rd.city || '';
              district = rd.district || '';
              addr = rd.formatted_address || '';
            }
          } catch(e) {}
        }
        var label = addr || ((city || '') + (district ? ' ' + district : '')) || '高德定位';
        placeUserMarker(result.position.lng, result.position.lat, label, '');
        activeMap.setZoomAndCenter(16, [result.position.lng, result.position.lat]);
        return;
      }
    }
  } catch(e) {
    console.warn('[locateUser] AMap Geolocation failed:', e.message || e.info || e);
  }

  // === Try 2: Browser native GPS ===
  if (navigator.geolocation) {
    try {
      const position = await new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          enableHighAccuracy: true, timeout: 10000, maximumAge: 0
        });
      });
      placeUserMarker(position.coords.longitude, position.coords.latitude, 'GPS 定位', '');
      activeMap.setZoomAndCenter(16, [position.coords.longitude, position.coords.latitude]);
      return;
    } catch(e) {
      console.warn('[locateUser] Browser GPS failed:', e.message);
    }
  }

  // === Try 3: Backend IP location (兜底) ===
  try {
    const resp = await fetch(BACKEND + '/api/my-location', { cache: 'no-store' });
    const data = await resp.json();
    if (data.status === 'ok' && data.lng && data.lat) {
      placeUserMarker(data.lng, data.lat, data.city || 'IP定位', data.province || '');
      activeMap.setZoomAndCenter(12, [data.lng, data.lat]);
      return;
    }
  } catch(e) {}

  // === Try 4: AMap CitySearch (最后兜底) ===
  activeMap.plugin('AMap.CitySearch', () => {
    new AMap.CitySearch().getLocalCity((s, r) => {
      if (s === 'complete' && r.info === 'OK') {
        activeMap.setCity(r.city);
        activeMap.setZoom(12);
      }
    });
  });
}

function placeUserMarker(lng, lat, city, province) {
  if (!document.getElementById('pulse-style')) {
    const styleEl = document.createElement('style');
    styleEl.id = 'pulse-style';
    styleEl.textContent = '@keyframes pulse-loc{0%,100%{box-shadow:0 0 0 4px rgba(100,200,160,.3)}50%{box-shadow:0 0 0 14px rgba(100,200,160,.05)}}';
    document.head.appendChild(styleEl);
  }

  if (!planMap) return;
  if (userMarker) userMarker.setMap(null);
  userMarker = new AMap.Marker({
    position: [lng, lat],
    content: '<div style="width:18px;height:18px;background:oklch(0.52 0.10 175);border:3px solid oklch(0.92 0.002 185);border-radius:50%;box-shadow:0 0 0 4px rgba(100,200,160,.3),0 2px 8px rgba(0,0,0,.3);animation:pulse-loc 2s ease infinite"></div>',
    offset: new AMap.Pixel(-9, -9),
    zIndex: 1000
  });
  userMarker.setMap(planMap);

  const label = city || '我的位置';
  const sub = province || 'IP 定位';
  if (!planMap) return;
  const iw = new AMap.InfoWindow({
    content: '<div style="padding:8px 14px;font-size:14px;border-radius:8px;font-family:system-ui,sans-serif;background:oklch(0.18 0.010 185);color:oklch(0.92 0.002 185);border:1px solid oklch(0.30 0.015 185)"><strong>📍 ' + label + '</strong><br/><span style="font-size:12px;color:oklch(0.65 0.010 185)">' + sub + '</span></div>',
    offset: new AMap.Pixel(0, -32)
  });
  iw.open(planMap, [lng, lat]);
  setTimeout(() => { try { iw.close(); } catch(e) {} }, 5000);
}

function addMarkerToMap(mapObj, markArr, infoArr, name, lng, lat, info, type) {
  if (!mapObj) return null;
  const icons = { '景点': '🏛️', '酒店': '🛏️', '餐饮': '🍽️', '交通': '🚕' };
  const m = new AMap.Marker({
    position: [lng, lat], title: name,
    content: '<div style="font-size:22px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.3))">' + (icons[type] || '📍') + '</div>',
    offset: new AMap.Pixel(-14, -14)
  });
  const iw = new AMap.InfoWindow({
    content: '<div style="padding:8px 12px;font-size:13px"><strong style="font-size:14px">' + name + '</strong>' + (info ? '<br/><span style="color:#888">' + info + '</span>' : '') + '</div>',
    offset: new AMap.Pixel(0, -34)
  });
  m.on('click', () => iw.open(mapObj, m.getPosition()));
  m.setMap(mapObj);
  markArr.push(m); infoArr.push(iw);
  updateMC();
  return m;
}

// Plan map markers and route
function clearPlanMap() {
  planMarkers.forEach(m => m.setMap(null));
  planInfoWins.forEach(i => i.close());
  planMarkers = []; planInfoWins = [];
}

function fitPlanRoute() {
  if (planMarkers.length && planMap) planMap.setFitView(planMarkers);
}

// ===== PLAN ROUTE: auto-extract POIs, place markers, draw route =====
var _autoRouteInProgress = false;

function autoRoutePlan() {
  if (!planContent || !planMapLoaded || !planMap) {
    showToast('请先生成行程计划', 'warning');
    return;
  }
  if (_autoRouteInProgress) {
    showToast('正在规划中，请稍候...', 'info');
    return;
  }
  _autoRouteInProgress = true;

  // Disable buttons during planning
  var routeBtn = document.querySelector('.map-btn[onclick="autoRoutePlan()"]');
  if (routeBtn) { routeBtn.disabled = true; routeBtn.textContent = '⏳ 规划中...'; }

  clearPlanMap();
  if (planPolyline) { planPolyline.setMap(null); planPolyline = null; }
  if (planPolylines.length) { planPolylines.forEach(function(p) { p.setMap(null); }); planPolylines = []; }

  // Extract locations from plan content
  var pois = extractPlanPOIs(planContent);
  if (!pois.length) {
    showToast('未能从行程中提取到地点信息', 'warning');
    _autoRouteInProgress = false;
    if (routeBtn) { routeBtn.disabled = false; routeBtn.textContent = '🚗 一键规划路线'; }
    return;
  }

  // Limit to 6 POIs to prevent too many API calls
  if (pois.length > 6) {
    pois = pois.slice(0, 6);
  }

  showToast('正在获取地点坐标并规划路线...', 'info');

  // Overall safety timeout: if geocoding takes more than 20s, abort and show fallback
  var overallTimeout = setTimeout(function() {
    if (_autoRouteInProgress) {
      console.warn('autoRoutePlan: overall timeout, showing fallback');
      _autoRouteInProgress = false;
      if (routeBtn) { routeBtn.disabled = false; routeBtn.textContent = '🚗 一键规划路线'; }
      showToast('路线规划超时，请稍后重试', 'warning');
    }
  }, 30000);

  // Geocode all POIs in parallel with timeout
  geocodePlanPOIsParallel(pois).then(function(geocoded) {
    clearTimeout(overallTimeout);
    if (!_autoRouteInProgress) return; // already timed out

    var validPOIs = geocoded.filter(function(p) { return p.lng && p.lat; });
    if (!validPOIs.length) {
      showToast('无法获取地点坐标，请检查高德地图 Key', 'warning');
      _autoRouteInProgress = false;
      if (routeBtn) { routeBtn.disabled = false; routeBtn.textContent = '🚗 一键规划路线'; }
      return;
    }

    // Build route points: start from user's location if available
    var routePoints = [];
    if (userGPS && userGPS.lng && userGPS.lat) {
      routePoints.push({
        name: userGPS.city ? userGPS.city + (userGPS.district ? ' ' + userGPS.district : '') : '我的位置',
        lng: userGPS.lng,
        lat: userGPS.lat,
        type: '起点',
        isUserLocation: true
      });
    }
    validPOIs.forEach(function(poi) { routePoints.push(poi); });
    lastGeocodedPOIs = routePoints;

    // Place markers
    var icons = ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣','9️⃣','🔟'];
    routePoints.forEach(function(poi, i) {
      var marker, iw;
      if (poi.isUserLocation) {
        marker = new AMap.Marker({
          position: [poi.lng, poi.lat],
          title: poi.name,
          content: '<div style="width:28px;height:28px;background:oklch(0.52 0.10 175);border:3px solid oklch(0.92 0.002 185);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,.4);animation:pulse-loc 2s ease infinite">📍</div>',
          offset: new AMap.Pixel(-14, -14),
          zIndex: 200
        });
        iw = new AMap.InfoWindow({
          content: '<div style="padding:10px 16px;font-size:14px;border-radius:10px;font-family:system-ui,sans-serif;background:oklch(0.18 0.010 185);color:oklch(0.92 0.002 185);border:1px solid oklch(0.30 0.015 185)"><strong>📍 出发点</strong><br/><span style="font-size:16px;font-weight:600">' + escHtml(poi.name) + '</span><br/><span style="font-size:12px;color:oklch(0.65 0.010 185)">您的当前位置</span></div>',
          offset: new AMap.Pixel(0, -34)
        });
      } else {
        var iconIdx = userGPS ? i - 1 : i;
        var icon = icons[iconIdx] || '📍';
        marker = new AMap.Marker({
          position: [poi.lng, poi.lat],
          title: poi.name,
          content: '<div style="font-size:20px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.4))">' + icon + '</div>',
          offset: new AMap.Pixel(-14, -14),
          zIndex: 100 - i
        });
        iw = new AMap.InfoWindow({
          content: '<div style="padding:10px 16px;font-size:14px;border-radius:10px;font-family:system-ui,sans-serif;background:oklch(0.18 0.010 185);color:oklch(0.92 0.002 185);border:1px solid oklch(0.30 0.015 185)"><strong>' + icon + ' 第' + (iconIdx+1) + '站</strong><br/><span style="font-size:16px;font-weight:600">' + escHtml(poi.name) + '</span><br/><span style="font-size:12px;color:oklch(0.65 0.010 185)">' + (poi.type || '景点') + '</span></div>',
          offset: new AMap.Pixel(0, -34)
        });
      }
      marker.on('click', function(m, iw) { return function() { iw.open(planMap, m.getPosition()); }; }(marker, iw));
      marker.setMap(planMap);
      planMarkers.push(marker);
      planInfoWins.push(iw);
    });

    planMap.setFitView(planMarkers, false, [80, 80, 80, 80]);

    // Render summary first (shows progress bar), then draw route
    renderRouteSummary(routePoints);

    if (routePoints.length >= 2) {
      // Use setTimeout to let the UI render markers and summary before drawing route
      setTimeout(function() {
        drawPlanRoute(routePoints);
      }, 100);
    }

    if (userGPS) {
      showToast('📍 从您的位置出发，途经 ' + validPOIs.length + ' 个地点', 'success');
    }
  }).catch(function(e) {
    clearTimeout(overallTimeout);
    console.warn('autoRoutePlan geocode error:', e);
    showToast('地点坐标获取失败，请检查网络', 'error');
  }).finally(function() {
    // Note: _autoRouteInProgress is reset in the finally, but drawPlanRoute runs async
    // so we reset it here. The route drawing continues in the background.
    _autoRouteInProgress = false;
    if (routeBtn) { routeBtn.disabled = false; routeBtn.textContent = '🚗 一键规划路线'; }
  });
}

function extractPlanPOIs(text) {
  if (!text) return [];
  var pois = [];
  var seen = new Set();

  function addPOI(rawName) {
    var name = normalizePOIName(rawName);
    if (name && !seen.has(name) && isLikelyPOI(name)) {
      seen.add(name);
      pois.push({ name: name, type: guessPOIType(name) });
    }
  }

  // Highest priority: read the model's final machine-friendly route line.
  // Expected format: 地图路线：地名A → 地名B → 地名C
  var finalRoute = extractFinalMapRoute(text);
  if (finalRoute.length) {
    finalRoute.forEach(addPOI);
    return pois.slice(0, 10);
  }
  
  // Pattern 1: JSON block produced by itinerary model
  var jsonMatch = text.match(/```json\s*([\s\S]*?)```/i);
  if (jsonMatch) {
    try {
      var data = JSON.parse(jsonMatch[1]);
      var walk = function(v) {
        if (!v) return;
        if (Array.isArray(v)) {
          v.forEach(walk);
          return;
        }
        if (typeof v === 'object') {
          var n = v.poi_name || v.name || v.title || v.location || v.place;
          if (n && (v.poi_name || v.type || v.category || /景点|酒店|餐饮|交通|目的地|地点/.test(JSON.stringify(v).slice(0, 160)))) addPOI(n);
          Object.keys(v).forEach(function(k) { walk(v[k]); });
        }
      };
      walk(data);
    } catch(e) {
      console.warn('extractPlanPOIs: JSON 解析失败:', e.message);
    }
  }
  
  // Pattern 2: Table rows with emoji prefix like | 🏛️ 西湖 |
  var emojiMatches = text.matchAll(/\|[^|]*([🏛🏨🍜🚕📍🛏🍽🏯⛩🏔🏖🌊🎢🎡])\s*([^|\d]{2,20})\s*\|/g);
  for (var m of emojiMatches) {
    addPOI(m[2]);
  }
  
  // Pattern 3: Day sections only. Avoid global bold extraction because profile labels may also be bold.
  var dayMatches = text.matchAll(/(?:[📅🗓]\s*)?(?:第[一二三四五六七八九十\d]+天|[Dd]ay\s*\d+|D\d+)[：:\s-]*([\s\S]*?)(?=(?:[📅🗓]\s*)?(?:第[一二三四五六七八九十\d]+天|[Dd]ay\s*\d+|D\d+)[：:\s-]|$)/g);
  for (var m of dayMatches) {
    var daySection = m[1];
    var subBold = daySection.matchAll(/\*\*([^*\n]{2,30})\*\*/g);
    for (var sm of subBold) {
      addPOI(sm[1]);
    }
    var routeParts = daySection.matchAll(/(?:前往|抵达|游览|参观|打卡|入住|用餐|到达|路线|景点|餐饮|住宿)[：:\s]*([^，。；;\n|]{2,28})/g);
    for (var rm of routeParts) {
      addPOI(rm[1]);
    }
  }
  
  // Limit to 10 POIs
  return pois.slice(0, 10);
}

function extractFinalMapRoute(text) {
  if (!text) return [];
  var candidates = [];
  var routeLinePatterns = [
    /(?:地图路线|最终地图路线|最终路线|推荐路线|主路线|路线)\s*[：:]\s*([^\n\r]+)/gi,
    /十[、.．]\s*最终地图路线[\s\S]*?(?:地图路线|路线)\s*[：:]\s*([^\n\r]+)/gi
  ];
  routeLinePatterns.forEach(function(re) {
    var m;
    var safety = 0;
    while ((m = re.exec(text)) !== null && safety < 20) {
      if (m[1]) candidates.push(m[1]);
      // Guard against zero-length matches that don't advance lastIndex
      if (re.lastIndex === m.index) re.lastIndex++;
      safety++;
    }
  });
  if (!candidates.length) return [];
  // Prefer the last route line, because the final output should override earlier explanatory routes.
  var line = candidates[candidates.length - 1];
  return splitRouteLineToPOIs(line);
}

function splitRouteLineToPOIs(line) {
  if (!line) return [];
  return String(line)
    .replace(/[`*_#>]/g, '')
    .replace(/^(地图路线|最终地图路线|最终路线|推荐路线|主路线|路线)\s*[：:]/, '')
    .split(/\s*(?:→|->|➡|—>|-->|至|到)\s*/)
    .map(normalizePOIName)
    .filter(function(name, idx, arr) {
      return name && isLikelyPOI(name) && arr.indexOf(name) === idx;
    })
    .slice(0, 10);
}

function normalizePOIName(name) {
  if (!name) return '';
  return String(name)
    .replace(/<[^>]+>/g, '')
    .replace(/^[\d一二三四五六七八九十]+[.、)]\s*/g, '')
    .replace(/^[\s\-—–、:：|]+|[\s\-—–、:：|]+$/g, '')
    .replace(/^(上午|中午|下午|晚上|早上|全天|第[一二三四五六七八九十\d]+站|第[一二三四五六七八九十\d]+天|Day\s*\d+|D\d+)[：:\s-]*/i, '')
    .replace(/^(景点|目的地|地点|餐饮|住宿|酒店|交通|路线|安排|推荐)[：:\s-]*/g, '')
    .replace(/[（(].*?(分钟|小时|公里|km|元|预算|建议|可选).*?[）)]/gi, '')
    .replace(/(附近|周边|一带|区域|可选|任选|视情况).*$/g, '')
    .trim();
}

function isLikelyPOI(name) {
  var skipWords = /^(住宿|交通|餐饮|美食|预算|费用|总结|总览|建议|贴士|说明|概述|备注|行程|概览|安排|方案|推荐|上午|中午|下午|晚上|早上|全天|第[一二三四五六七八九十\d]天|总计|合计|Day\s*\d|D\d|📅|🗓)$/;
  var badTerms = /(同行关系|同伴关系|兴趣偏好|消费倾向|决策风格|用户画像|客群画像|人群画像|需求分析|预算分析|旅行偏好|出行方式|文化体验|亲子|情侣|家庭|朋友|同学|游客|自由行|跟团|深度游|轻松游|推荐理由|游玩建议|避坑|注意事项|上午|中午|下午|晚上|早上|总览|总结)/;
  var skipChars = /^[\d,.¥$￥]+$/;
  if (name.length < 2 || name.length > 30) return false;
  if (skipWords.test(name) || badTerms.test(name) || skipChars.test(name)) return false;
  if (typeof planCity !== 'undefined' && planCity) {
    var cityName = String(planCity).replace(/市$/, '');
    var currentName = String(name).replace(/市$/, '');
    if (currentName === cityName) return false;
  }
  if (/^(景点|酒店|餐厅|地铁|公交|打车|步行|导航|门票|开放时间)$/.test(name)) return false;
  return true;
}

function guessPOIType(name) {
  if (/酒店|宾馆|民宿|客栈|青旅|度假村|山庄/.test(name)) return '酒店';
  if (/餐厅|酒楼|小吃|火锅|面馆|烧烤|海鲜|饭店|食堂|馆子/.test(name)) return '餐饮';
  if (/机场|火车站|站|客运|地铁/.test(name)) return '交通';
  return '景点';
}

async function geocodePlanPOIsParallel(pois) {
  // Geocode all POIs in parallel with timeout, instead of sequential blocking
  var promises = pois.map(function(p) {
    return geocodeSinglePOI(p).catch(function(e) {
      console.warn('geocodeSinglePOI: [' + p.name + ']:', e.message);
      return p;
    });
  });
  return Promise.all(promises);
}

async function geocodeSinglePOI(p) {
  // POI search with 8s timeout
  var controller = new AbortController();
  var timeoutId = setTimeout(function() { controller.abort(); }, 8000);
  try {
    var poiResp = await fetch(BACKEND + '/api/map/poi-search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ keywords: p.name, city: planCity || '' }),
      signal: controller.signal
    });
    clearTimeout(timeoutId);
    var poiData = await poiResp.json();
    if (poiData.status === 'ok' && poiData.pois && poiData.pois.length) {
      var best = chooseBestPOIResult(p.name, poiData.pois);
      if (best && best.location && best.location.lng && best.location.lat) {
        p.lng = best.location.lng;
        p.lat = best.location.lat;
        p.resolvedName = best.name;
        p.address = best.address || '';
        return p;
      }
    }
  } catch(e) {
    clearTimeout(timeoutId);
  }
  // Fallback: geocode API with 8s timeout
  var controller2 = new AbortController();
  var timeoutId2 = setTimeout(function() { controller2.abort(); }, 8000);
  try {
    var addr = (planCity ? planCity : '') + ' ' + p.name;
    var r = await fetch(BACKEND + '/api/map/geocode', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: addr, city: planCity || '' }),
      signal: controller2.signal
    });
    clearTimeout(timeoutId2);
    var d = await r.json();
    if (d.status === 'ok' && d.lng && d.lat) {
      p.lng = d.lng;
      p.lat = d.lat;
    }
  } catch(e) {
    clearTimeout(timeoutId2);
  }
  return p;
}

function chooseBestPOIResult(keyword, pois) {
  if (!pois || !pois.length) return null;
  var normalizedKeyword = normalizePOIName(keyword).replace(/\s/g, '');
  var badType = /(公司|商铺|住宅|小区|商务住宅|政府机构|道路附属设施)/;
  var candidates = pois.filter(function(p) {
    if (!p || !p.name || !p.location || !p.location.lng || !p.location.lat) return false;
    if (badType.test(p.type || '')) return false;
    return true;
  });
  if (!candidates.length) candidates = pois;
  candidates.sort(function(a, b) {
    var an = String(a.name || '').replace(/\s/g, '');
    var bn = String(b.name || '').replace(/\s/g, '');
    var as = an === normalizedKeyword ? 100 : an.indexOf(normalizedKeyword) >= 0 ? 70 : normalizedKeyword.indexOf(an) >= 0 ? 50 : 0;
    var bs = bn === normalizedKeyword ? 100 : bn.indexOf(normalizedKeyword) >= 0 ? 70 : normalizedKeyword.indexOf(bn) >= 0 ? 50 : 0;
    if (/风景名胜|科教文化|餐饮|住宿|购物服务/.test(a.type || '')) as += 20;
    if (/风景名胜|科教文化|餐饮|住宿|购物服务/.test(b.type || '')) bs += 20;
    return bs - as;
  });
  return candidates[0];
}

function drawPlanRoute(pois) {
  if (!planMap || pois.length < 2) return;
  
  // Clear existing polylines
  if (planPolyline) { planPolyline.setMap(null); planPolyline = null; }
  if (planPolylines.length) { planPolylines.forEach(function(p) { p.setMap(null); }); planPolylines = []; }
  
  var modeColors = {
    driving: '#FF6B35',
    transit: '#3B82F6',
    walking: '#10B981',
    bicycling: '#8B5CF6'
  };
  var modeNames = { driving: '驾车', transit: '公交', walking: '步行', bicycling: '骑行' };
  
  // For driving mode with 3+ points, use single API call with waypoints; otherwise use segmented
  if (currentRouteMode === 'driving' && pois.length > 2) {
    var waypoints = [];
    for (var i = 1; i < pois.length - 1; i++) {
      waypoints.push(pois[i].lng + ',' + pois[i].lat);
    }
    
    // 10s timeout to prevent hanging
    var controller = new AbortController();
    var timeoutId = setTimeout(function() { controller.abort(); }, 10000);
    fetch(BACKEND + '/api/map/direction-proxy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        origin: pois[0].lng + ',' + pois[0].lat,
        destination: pois[pois.length - 1].lng + ',' + pois[pois.length - 1].lat,
        waypoints: waypoints,
        mode: 'driving'
      }),
      signal: controller.signal
    }).then(function(r) { clearTimeout(timeoutId); return r.json(); }).then(function(data) {
      if (data.status === 'ok' && data.paths && data.paths.length > 0) {
        drawPolylineOnMap(data.paths[0], modeColors.driving);
        var dist = (parseFloat(data.paths[0].distance) / 1000).toFixed(1);
        var dur = Math.round(parseFloat(data.paths[0].duration) / 60);
        lastRouteStats = { totalDist: dist, totalDur: dur, mode: currentRouteMode };
        updateRouteInfoBar();
        showToast('🗺️ ' + modeNames.driving + '路线规划成功！约 ' + dist + ' km，' + dur + ' 分钟', 'success');
      } else {
        drawFallbackPolyline(pois);
        showToast('路线规划失败，显示为直线连接', 'warning');
      }
    }).catch(function(e) {
      clearTimeout(timeoutId);
      console.warn('drawPlanRoute error:', e);
      drawFallbackPolyline(pois);
      showToast('路线规划失败，显示为直线连接', 'warning');
    });
  } else {
    // For transit, walking, bicycling: draw segment by segment (no waypoints support)
    drawSegmentedRoute(pois, currentRouteMode, modeColors);
  }
}

// Draw route segment by segment for non-driving modes
var planPolylines = [];
function drawSegmentedRoute(pois, mode, modeColors) {
  var totalDist = 0, totalDur = 0;
  var totalSegments = pois.length - 1;
  var modeNames = { driving: '驾车', transit: '公交', walking: '步行', bicycling: '骑行' };
  var hasFailure = false;
  var color = modeColors[mode] || '#FF6B35';
  
  // Update progress bar
  function updateProgress(done, total) {
    var bar = document.getElementById('route-info-bar');
    if (bar) {
      bar.innerHTML = '<div class="route-info-chip">⏳ ' + done + '/' + total + ' 段路线已规划...</div>';
    }
  }
  updateProgress(0, totalSegments);
  
  // Process segments SEQUENTIALLY to avoid overwhelming the backend
  function processSegment(idx) {
    if (idx >= totalSegments) {
      // All done
      var distKm = (totalDist / 1000).toFixed(1);
      var durMin = Math.round(totalDur / 60);
      lastRouteStats = { totalDist: distKm, totalDur: durMin, mode: mode };
      updateRouteInfoBar();
      if (hasFailure) {
        showToast('🗺️ ' + modeNames[mode] + '路线部分成功，约 ' + distKm + ' km，' + durMin + ' 分钟', 'warning');
      } else {
        showToast('🗺️ ' + modeNames[mode] + '路线规划成功！约 ' + distKm + ' km，' + durMin + ' 分钟', 'success');
      }
      return;
    }
    
    var origin = pois[idx].lng + ',' + pois[idx].lat;
    var dest = pois[idx + 1].lng + ',' + pois[idx + 1].lat;
    var body = { origin: origin, destination: dest, mode: mode };
    if (mode === 'transit') body.city = planCity || '';
    
    // 8s timeout per segment
    var controller = new AbortController();
    var timeoutId = setTimeout(function() { controller.abort(); }, 8000);
    
    fetch(BACKEND + '/api/map/direction-proxy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      signal: controller.signal
    }).then(function(r) {
      clearTimeout(timeoutId);
      return r.json();
    }).then(function(data) {
      if (data.status === 'ok' && data.paths && data.paths.length > 0) {
        var pathData = data.paths[0];
        drawSegmentPolyline(pathData, color);
        totalDist += parseFloat(pathData.distance) || 0;
        totalDur += parseFloat(pathData.duration) || 0;
      } else {
        hasFailure = true;
        drawStraightLine(pois[idx], pois[idx + 1], color);
      }
      updateProgress(idx + 1, totalSegments);
      // Process next segment with a small delay to let the UI update
      setTimeout(function() { processSegment(idx + 1); }, 50);
    }).catch(function(e) {
      clearTimeout(timeoutId);
      console.warn('drawSegmentedRoute segment ' + idx + ' error:', e);
      hasFailure = true;
      drawStraightLine(pois[idx], pois[idx + 1], color);
      updateProgress(idx + 1, totalSegments);
      // Process next segment even on failure
      setTimeout(function() { processSegment(idx + 1); }, 50);
    });
  }
  
  // Start processing from segment 0
  processSegment(0);
}

// Draw a single segment polyline on the map
function drawSegmentPolyline(path, color) {
  var steps = path.steps || [];
  var pathPoints = [];
  for (var i = 0; i < steps.length; i++) {
    var polylineStr = steps[i].polyline || '';
    if (!polylineStr) continue;
    var points = polylineStr.split(';');
    for (var j = 0; j < points.length; j++) {
      var coords = points[j].split(',');
      if (coords.length >= 2) {
        pathPoints.push(new AMap.LngLat(parseFloat(coords[0]), parseFloat(coords[1])));
      }
    }
  }
  if (pathPoints.length >= 2) {
    var seg = new AMap.Polyline({
      path: pathPoints,
      strokeColor: color,
      strokeWeight: 5,
      strokeOpacity: 0.8,
      lineJoin: 'round',
      showDir: true,
      zIndex: 50
    });
    seg.setMap(planMap);
    planPolylines.push(seg);
  }
}

// Draw a straight line between two points (fallback)
function drawStraightLine(p1, p2, color) {
  var seg = new AMap.Polyline({
    path: [new AMap.LngLat(p1.lng, p1.lat), new AMap.LngLat(p2.lng, p2.lat)],
    strokeColor: color,
    strokeWeight: 4,
    strokeOpacity: 0.6,
    strokeStyle: 'dashed',
    lineJoin: 'round',
    zIndex: 50
  });
  seg.setMap(planMap);
  planPolylines.push(seg);
}

// Update route info bar in the summary
function updateRouteInfoBar() {
  var bar = document.getElementById('route-info-bar');
  if (!bar || !lastRouteStats) return;
  var modeNames = { driving: '🚗 驾车', transit: '🚌 公交', walking: '🚶 步行', bicycling: '🚲 骑行' };
  bar.innerHTML =
    '<div class="route-info-chip">' + (modeNames[lastRouteStats.mode] || '🚗') + '</div>' +
    '<div class="route-info-chip">📏 <strong>' + lastRouteStats.totalDist + '</strong> km</div>' +
    '<div class="route-info-chip">⏱️ <strong>' + lastRouteStats.totalDur + '</strong> 分钟</div>';
}

// 在地图上绘制高德返回的路线折线
var planPolyline = null;
function drawPolylineOnMap(path, color) {
  if (planPolyline) { planPolyline.setMap(null); planPolyline = null; }
  var steps = path.steps || [];
  var pathPoints = [];
  // 从 steps 中提取 polyline 坐标串
  for (var i = 0; i < steps.length; i++) {
    var polylineStr = steps[i].polyline || '';
    if (!polylineStr) continue;
    var points = polylineStr.split(';');
    for (var j = 0; j < points.length; j++) {
      var coords = points[j].split(',');
      if (coords.length >= 2) {
        pathPoints.push(new AMap.LngLat(parseFloat(coords[0]), parseFloat(coords[1])));
      }
    }
  }
  if (pathPoints.length >= 2) {
    planPolyline = new AMap.Polyline({
      path: pathPoints,
      strokeColor: color || '#FF6B35',
      strokeWeight: 5,
      strokeOpacity: 0.8,
      lineJoin: 'round',
      showDir: true,
      zIndex: 50
    });
    planPolyline.setMap(planMap);
  } else {
    drawFallbackPolyline(lastGeocodedPOIs);
  }
}

// 降级方案：用直线连接所有地点
function drawFallbackPolyline(pois) {
  if (planPolyline) { planPolyline.setMap(null); planPolyline = null; }
  var points = pois.map(function(p) { return new AMap.LngLat(p.lng, p.lat); });
  planPolyline = new AMap.Polyline({
    path: points,
    strokeColor: '#4A90D9',
    strokeWeight: 4,
    strokeOpacity: 0.7,
    strokeStyle: 'dashed',
    lineJoin: 'round',
    zIndex: 50
  });
  planPolyline.setMap(planMap);
}

function renderRouteSummary(pois) {
  // Remove old summary if exists
  var old = document.getElementById('plan-route-summary');
  if (old) old.remove();
  
  var summary = document.createElement('div');
  summary.id = 'plan-route-summary';
  summary.className = 'plan-route-summary';
  
  // Build route flow items
  var items = pois.map(function(p, i) {
    var icon, num;
    if (p.isUserLocation) {
      icon = '📍';
      num = '★';
    } else {
      icon = p.type === '酒店' ? '🏨' : p.type === '餐饮' ? '🍜' : p.type === '交通' ? '🚕' : '🏛️';
      num = userGPS ? i : i + 1;
    }
    return '<div class="route-item">' +
      '<span class="route-num"' + (p.isUserLocation ? ' style="background:oklch(0.52 0.10 175)"' : '') + '>' + num + '</span>' +
      '<span class="route-icon">' + icon + '</span>' +
      '<span class="route-name">' + escHtml(p.name) + '</span>' +
      (i < pois.length - 1 ? '<span class="route-arrow">→</span>' : '') +
    '</div>';
  }).join('');
  
  // Build segment detail rows with navigation buttons
  var segments = '';
  for (var i = 0; i < pois.length - 1; i++) {
    var from = pois[i];
    var to = pois[i + 1];
    var fromIcon = from.isUserLocation ? '📍' : (from.type === '酒店' ? '🏨' : '🏛️');
    var toIcon = to.type === '酒店' ? '🏨' : to.type === '餐饮' ? '🍜' : to.type === '交通' ? '🚕' : '🏛️';
    segments += '<div class="route-segment">' +
      '<div class="route-seg-from"><span>' + fromIcon + '</span><span class="route-name">' + escHtml(from.name) + '</span></div>' +
      '<span class="route-arrow">→</span>' +
      '<div class="route-seg-to"><span>' + toIcon + '</span><span class="route-name">' + escHtml(to.name) + '</span></div>' +
      '<div class="route-seg-actions">' +
        '<button class="route-seg-btn" onclick="showTransportOptions(' + i + ')" title="查看交通方式">🚌 交通</button>' +
        '<button class="route-seg-btn nav" onclick="navigateSegment(' + i + ')" title="开始导航">🧭 导航</button>' +
      '</div>' +
    '</div>';
  }
  
  var totalStations = userGPS ? pois.length - 1 : pois.length;
  var startText = userGPS ? '从我的位置出发' : '路线规划';
  
  summary.innerHTML =
    '<div class="route-summary-header">' +
      '<div class="route-summary-title">🗺️ ' + startText + '（共 ' + totalStations + ' 站' + (userGPS ? ' + 起点' : '') + '）</div>' +
      '<div style="display:flex;gap:6px">' +
        '<button class="route-clear-btn" style="background:var(--accent);color:#000;font-weight:600;border-color:var(--accent)" onclick="navigateFullRoute()">🧭 全程导航</button>' +
        '<button class="route-clear-btn" onclick="clearPlanRoute()">清除路线</button>' +
      '</div>' +
    '</div>' +
    '<div class="route-info-bar" id="route-info-bar">' +
      '<div class="route-info-chip">⏳ 计算中...</div>' +
    '</div>' +
    '<div class="route-flow">' + items + '</div>' +
    '<div class="route-segments">' + segments + '</div>';
  
  var planTimeline = document.getElementById('plan-timeline');
  if (planTimeline) {
    planTimeline.appendChild(summary);
  }
}

function clearPlanRoute() {
  clearPlanMap();
  if (planPolyline) { planPolyline.setMap(null); planPolyline = null; }
  if (planPolylines.length) { planPolylines.forEach(function(p) { p.setMap(null); }); planPolylines = []; }
  var summary = document.getElementById('plan-route-summary');
  if (summary) summary.remove();
  lastGeocodedPOIs = [];
  lastRouteStats = null;
}

// ===== NAVIGATION URL =====
function getAmapNavUrl(lng, lat, name) {
  return 'https://uri.amap.com/navigation?to=' + lng + ',' + lat + ',' + encodeURIComponent(name) + '&mode=car';
}

// Get AMap navigation URL with specific mode
function getAmapNavUrlMode(lng, lat, name, mode) {
  var modeMap = { driving: 'car', walking: 'walk', transit: 'bus', bicycling: 'ride' };
  return 'https://uri.amap.com/navigation?to=' + lng + ',' + lat + ',' + encodeURIComponent(name) + '&mode=' + (modeMap[mode] || 'car');
}

// Navigate to a specific segment (from poi[idx] to poi[idx+1])
function navigateSegment(idx) {
  if (!lastGeocodedPOIs.length || idx < 0 || idx >= lastGeocodedPOIs.length - 1) return;
  var from = lastGeocodedPOIs[idx];
  var to = lastGeocodedPOIs[idx + 1];
  // Open AMap navigation from current position to the destination of this segment
  var navUrl = 'https://uri.amap.com/navigation?from=' + from.lng + ',' + from.lat + ',' + encodeURIComponent(from.name) +
    '&to=' + to.lng + ',' + to.lat + ',' + encodeURIComponent(to.name) +
    '&mode=' + (currentRouteMode === 'driving' ? 'car' : currentRouteMode === 'walking' ? 'walk' : currentRouteMode === 'transit' ? 'bus' : 'ride') +
    '&src=智旅灵犀&coordinate=gaode&callnative=1';
  window.open(navUrl, '_blank');
  showToast('🧭 正在打开高德地图导航：' + from.name + ' → ' + to.name, 'info');
}

// Navigate to a specific POI by index
function navigateToPOI(idx) {
  if (!lastGeocodedPOIs.length || idx < 0 || idx >= lastGeocodedPOIs.length) return;
  var poi = lastGeocodedPOIs[idx];
  var navUrl = getAmapNavUrlMode(poi.lng, poi.lat, poi.name, currentRouteMode);
  window.open(navUrl, '_blank');
  showToast('🧭 正在打开高德地图导航到：' + poi.name, 'info');
}

// Navigate the full route (from start to end)
function navigateFullRoute() {
  if (!lastGeocodedPOIs.length || lastGeocodedPOIs.length < 2) return;
  var from = lastGeocodedPOIs[0];
  var to = lastGeocodedPOIs[lastGeocodedPOIs.length - 1];
  var navUrl = 'https://uri.amap.com/navigation?from=' + from.lng + ',' + from.lat + ',' + encodeURIComponent(from.name) +
    '&to=' + to.lng + ',' + to.lat + ',' + encodeURIComponent(to.name) +
    '&mode=' + (currentRouteMode === 'driving' ? 'car' : currentRouteMode === 'walking' ? 'walk' : currentRouteMode === 'transit' ? 'bus' : 'ride') +
    '&src=智旅灵犀&coordinate=gaode&callnative=1';
  window.open(navUrl, '_blank');
  showToast('🧭 正在打开高德地图导航全程：' + from.name + ' → ' + to.name, 'info');
}

// Show transport options modal for a specific segment
function showTransportOptions(idx) {
  if (!lastGeocodedPOIs.length || idx < 0 || idx >= lastGeocodedPOIs.length - 1) return;
  var from = lastGeocodedPOIs[idx];
  var to = lastGeocodedPOIs[idx + 1];
  
  // Remove existing modal
  var existing = document.getElementById('route-transport-modal');
  if (existing) existing.remove();
  
  var modal = document.createElement('div');
  modal.id = 'route-transport-modal';
  modal.className = 'route-transport-modal';
  modal.onclick = function(e) { if (e.target === modal) modal.remove(); };
  
  var modes = [
    { mode: 'driving', icon: '🚗', name: '驾车', desc: '自驾或打车前往' },
    { mode: 'transit', icon: '🚌', name: '公交地铁', desc: '公共交通出行' },
    { mode: 'walking', icon: '🚶', name: '步行', desc: '步行导航' },
    { mode: 'bicycling', icon: '🚲', name: '骑行', desc: '自行车/电动车' }
  ];
  
  var optionsHTML = modes.map(function(m) {
    return '<div class="route-transport-option" onclick="querySegmentTransport(' + idx + ',\'' + m.mode + '\')">' +
      '<div class="route-transport-icon">' + m.icon + '</div>' +
      '<div class="route-transport-detail">' +
        '<div class="route-transport-name">' + m.name + '</div>' +
        '<div class="route-transport-meta" id="transport-meta-' + m.mode + '-' + idx + '">' + m.desc + '</div>' +
      '</div>' +
      '<button class="route-transport-go" onclick="event.stopPropagation();navigateSegmentWithMode(' + idx + ',\'' + m.mode + '\')">前往</button>' +
    '</div>';
  }).join('');
  
  modal.innerHTML =
    '<div class="route-transport-modal-content">' +
      '<div class="route-transport-modal-header">' +
        '<div class="route-transport-modal-title">🚌 交通方式选择</div>' +
        '<div class="route-transport-modal-close" onclick="closeTransportModal()">✕</div>' +
      '</div>' +
      '<div style="margin-bottom:14px;padding:10px 14px;background:var(--paper-2);border-radius:var(--radius-sm);font-size:13px;color:var(--ink-2)">' +
        '<strong style="color:var(--ink)">' + escHtml(from.name) + '</strong> → <strong style="color:var(--ink)">' + escHtml(to.name) + '</strong>' +
      '</div>' +
      '<div class="route-transport-options" id="route-transport-options">' + optionsHTML + '</div>' +
    '</div>';
  
  document.body.appendChild(modal);
  
  // Auto-query all modes to show time/distance
  modes.forEach(function(m) {
    querySegmentTransportMeta(idx, m.mode);
  });
}

// Query transport info for a segment and update the modal
function querySegmentTransportMeta(idx, mode) {
  if (!lastGeocodedPOIs.length) return;
  var from = lastGeocodedPOIs[idx];
  var to = lastGeocodedPOIs[idx + 1];
  var body = {
    origin: from.lng + ',' + from.lat,
    destination: to.lng + ',' + to.lat,
    mode: mode
  };
  if (mode === 'transit') body.city = planCity || '';
  
  // 8s timeout
  var controller = new AbortController();
  var timeoutId = setTimeout(function() { controller.abort(); }, 8000);
  fetch(BACKEND + '/api/map/direction-proxy', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
    signal: controller.signal
  }).then(function(r) {
    clearTimeout(timeoutId);
    return r.json();
  }).then(function(data) {
    var metaEl = document.getElementById('transport-meta-' + mode + '-' + idx);
    if (metaEl && data.status === 'ok' && data.paths && data.paths.length > 0) {
      var dist = (parseFloat(data.paths[0].distance) / 1000).toFixed(1);
      var dur = Math.round(parseFloat(data.paths[0].duration) / 60);
      metaEl.innerHTML = '约 <strong style="color:var(--accent-2)">' + dist + '</strong> km · <strong style="color:var(--accent-2)">' + dur + '</strong> 分钟';
    } else if (metaEl) {
      metaEl.textContent = '暂无数据';
    }
  }).catch(function(e) {
    clearTimeout(timeoutId);
    var metaEl = document.getElementById('transport-meta-' + mode + '-' + idx);
    if (metaEl) metaEl.textContent = '查询失败';
  });
}

// Query segment transport and switch the map to that mode
function closeTransportModal() {
  var modal = document.getElementById('route-transport-modal');
  if (modal) modal.remove();
}

function querySegmentTransport(idx, mode) {
  // Close modal
  var modal = document.getElementById('route-transport-modal');
  if (modal) modal.remove();
  
  // Switch the route mode and redraw
  var btn = document.querySelector('.plan-transport-btn[data-mode="' + mode + '"]');
  setRouteMode(mode, btn);
  
  // Focus on the segment on the map
  if (lastGeocodedPOIs[idx] && lastGeocodedPOIs[idx + 1] && planMap) {
    var from = lastGeocodedPOIs[idx];
    var to = lastGeocodedPOIs[idx + 1];
    var midLng = (from.lng + to.lng) / 2;
    var midLat = (from.lat + to.lat) / 2;
    planMap.setZoomAndCenter(13, [midLng, midLat]);
  }
  
  showToast('已切换到' + ({driving:'驾车',transit:'公交',walking:'步行',bicycling:'骑行'}[mode] || mode) + '模式', 'info');
}

// Navigate a segment with a specific mode (from transport modal)
function navigateSegmentWithMode(idx, mode) {
  if (!lastGeocodedPOIs.length || idx < 0 || idx >= lastGeocodedPOIs.length - 1) return;
  var from = lastGeocodedPOIs[idx];
  var to = lastGeocodedPOIs[idx + 1];
  var modeMap = { driving: 'car', walking: 'walk', transit: 'bus', bicycling: 'ride' };
  var navUrl = 'https://uri.amap.com/navigation?from=' + from.lng + ',' + from.lat + ',' + encodeURIComponent(from.name) +
    '&to=' + to.lng + ',' + to.lat + ',' + encodeURIComponent(to.name) +
    '&mode=' + (modeMap[mode] || 'car') +
    '&src=智旅灵犀&coordinate=gaode&callnative=1';
  window.open(navUrl, '_blank');
  showToast('🧭 正在打开高德地图导航', 'info');
}

// ===== ROUTE DRAWING =====
function drawRoute(origin, destination, waypoints) {
  if (!planMap) return;
  planMap.plugin('AMap.Driving', function() {
    var driving = new AMap.Driving({
      map: chatMap,
      panel: null,
      policy: AMap.DrivingPolicy.LEAST_TIME
    });
    var waypointList = (waypoints || []).map(function(w) {
      return new AMap.LngLat(w.lng, w.lat);
    });
    driving.search(
      new AMap.LngLat(origin.lng, origin.lat),
      new AMap.LngLat(destination.lng, destination.lat),
      { waypoints: waypointList.length ? waypointList : undefined },
      function(status, result) {
        if (status === 'complete') {
          showToast('🗺️ 路线规划成功！', 'success');
        } else {
          showToast('路线规划失败，请重试', 'warning');
        }
      }
    );
  });
}

// ===== GEOCODE =====
async function geocodePOIs(pois) {
  if (!amapKey) return pois;
  const city = document.getElementById('destination').value || '';
  for (const p of pois) {
    try {
      const addr = (city ? city : '') + p.name;
      const r = await fetch('https://restapi.amap.com/v3/geocode/geo?key=' + amapKey + '&address=' + encodeURIComponent(addr) + '&city=' + city);
      const d = await r.json();
      if (d.status === '1' && d.geocodes && d.geocodes.length) {
        const loc = d.geocodes[0].location.split(',');
        p.lng = parseFloat(loc[0]); p.lat = parseFloat(loc[1]);
      }
    } catch(e) {
      console.warn('geocodePOIs: 无法解析地址 [' + p.name + ']:', e.message);
    }
  }
  return pois;
}

function extractPOIs(text) {
  if (!text) return [];
  const pois = [], seen = new Set();
  const jm = text.match(/```json\s*([\s\S]*?)```/);
  if (jm) {
    try {
      const data = JSON.parse(jm[1]);
      const extract = (arr) => {
        if (!Array.isArray(arr)) return;
        for (const item of arr) {
          if (item.pois) extract(item.pois);
          else {
            const n = item.poi_name || item.name || '';
            if (n && !seen.has(n)) { seen.add(n); pois.push({ name: n, type: item.type || '景点' }); }
          }
        }
      };
      extract(data.pois || data.poi_list || data.daily_routes || []);
    } catch(e) {
      console.warn('geocodePOIs: 无法解析地址 [' + p.name + ']:', e.message);
    }
  }
  if (!pois.length) {
    const matches = text.matchAll(/\*\*(.{2,20})\*\*/g);
    for (const m of matches) {
      const n = m[1].trim();
      if (n && !seen.has(n) && !/^[\d,.]+$/.test(n)) { seen.add(n); pois.push({ name: n, type: '景点' }); }
    }
  }
  return pois.slice(0,10);
}

// ===== CHAT =====
function renderMessages() {
  const el = document.getElementById('chat-messages');
  if (!messages.length) {
    el.innerHTML = '<div class="empty-state"><div class="es-icon">🏯</div><div class="es-title">欢迎使用智旅灵犀</div><div class="es-desc">选择上方快捷场景或输入你的文旅需求</div></div>';
    return;
  }
  collectKnownLocations();
  el.innerHTML = messages.map((m, idx) => {
    const cls = m.role === 'user' ? 'msg user' : 'msg agent';
    const locs = m.locations && m.locations.length ? renderLocationCards(m.locations) : '';
    const html = m.role === 'agent' ? linkifyLocations(formatMarkdown(m.content)) : formatMarkdown(m.content);
    let ticketHTML = '';
    if (m.role === 'agent' && idx === messages.length - 1 && m.content) {
      ticketHTML = '<div class="ticket-slot" data-content="' + encodeURIComponent(m.content) + '"></div>';
    }
    // Thinking panel for agent messages with thinking data (DeepSeek style)
    let thinkHTML = '';
    if (m.role === 'agent' && m.thinking && m.thinking.length > 0) {
      const thinkText = m.thinking.join('').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      thinkHTML = '<div class="thinking-panel collapsed"><div class="thinking-header" onclick="this.parentElement.classList.toggle(\'collapsed\');this.querySelector(\'.thinking-toggle\').textContent=this.parentElement.classList.contains(\'collapsed\')?\'▸\':\'▾\'"><span class="thinking-icon">🧠</span><span class="thinking-title">思考过程</span><span class="thinking-toggle">▸</span></div><div class="thinking-body"><div class="thinking-content">' + thinkText + '</div></div></div>';
    }
    return '<div class="' + cls + '">' + thinkHTML + '<div class="bubble">' + html + locs + '</div>' + ticketHTML + '</div>';
  }).join('');
  el.scrollTop = el.scrollHeight;
  bindLocLinkEvents();
  const lastAgent = [...messages].reverse().find(m => m.role === 'agent');
  if (lastAgent && lastAgent.content) {
    const slot = document.querySelector('.ticket-slot');
    if (slot) {
      renderTicketCardsAsync(lastAgent.content).then(cards => {
        if (cards) slot.innerHTML = cards;
      });
    }
  }
}

function renderLocationCards(locations) {
  let html = '<div class="loc-cards-row">';
  locations.forEach(loc => {
    const typeLabel = loc.type || '景点';
    let badgeClass = 'badge-scenic';
    if (typeLabel.includes('酒店') || typeLabel.includes('hotel')) badgeClass = 'badge-hotel';
    if (typeLabel.includes('美食') || typeLabel.includes('餐饮') || typeLabel.includes('food')) badgeClass = 'badge-food';
    const navUrl = loc.lng && loc.lat ? getAmapNavUrl(loc.lng, loc.lat, loc.name) : '#';
    const imgSrc = loc.photo || 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="150" height="84" viewBox="0 0 150 84"><rect fill="oklch(0.20 0.008 185)" width="150" height="84"/><text x="75" y="46" text-anchor="middle" font-size="22">📍</text></svg>');
    html += '<div class="loc-card">' +
      '<img class="loc-card-img" src="' + imgSrc + '" alt="' + loc.name + '" loading="lazy" onerror="this.src=\'data:image/svg+xml,' + encodeURIComponent('<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22150%22 height=%2284%22 viewBox=%220 0 150 84%22><rect fill=%22oklch(0.20 0.008 185)%22 width=%22150%22 height=%2284%22/><text x=%2275%22 y=%2246%22 text-anchor=%22middle%22 font-size=%2222%22>📍</text></svg>') + '\'">' +
      '<div class="loc-card-info">' +
        '<div class="loc-card-name">' + loc.name + '</div>' +
        '<span class="loc-card-badge ' + badgeClass + '">' + typeLabel + '</span>' +
      '</div>' +
      '<button class="loc-card-nav" onclick="window.open(\'' + navUrl + '\',\'_blank\')">导航</button>' +
    '</div>';
  });
  html += '</div>';
  return html;
}

function addAssistantBubble() {
  const el = document.getElementById('chat-messages');
  const emptyEl = el.querySelector('.empty-state');
  if (emptyEl) emptyEl.remove();
  const div = document.createElement('div');
  div.className = 'msg agent';
  div.id = 'streaming-bubble';
  div.innerHTML = '<div class="thinking-panel" id="streaming-thinking" style="display:none"><div class="thinking-header" onclick="this.parentElement.classList.toggle(\'collapsed\');this.querySelector(\'.thinking-toggle\').textContent=this.parentElement.classList.contains(\'collapsed\')?\'▸\':\'▾\'"><span class="thinking-icon">🧠</span><span class="thinking-title">思考过程</span><span class="thinking-status-text" id="thinking-status-text"></span><span class="thinking-toggle">▾</span></div><div class="thinking-body"><div class="thinking-content" id="thinking-content"></div></div></div><div class="bubble"><div class="typing-indicator"><span></span><span></span><span></span></div></div>';
  el.appendChild(div);
  el.scrollTop = el.scrollHeight;
}

function updateStreamBubble(text) {
  const el = document.getElementById('streaming-bubble');
  if (!el) return;
  collectKnownLocations();
  // Preserve thinking panel by only updating the .bubble div
  const bubbleDiv = el.querySelector('.bubble');
  if (bubbleDiv) {
    bubbleDiv.innerHTML = linkifyLocations(formatMarkdown(text));
  }
  document.getElementById('chat-messages').scrollTop = document.getElementById('chat-messages').scrollHeight;
  bindLocLinkEvents();
}

// DeepSeek 风格：流式追加思考内容
function addThinkingContent(text) {
  const panel = document.getElementById('streaming-thinking');
  if (!panel) return;
  panel.style.display = '';
  const contentEl = document.getElementById('thinking-content');
  if (!contentEl) return;
  contentEl.textContent += text;
  // Auto-scroll thinking body
  const body = panel.querySelector('.thinking-body');
  if (body) body.scrollTop = body.scrollHeight;
  const chatEl = document.getElementById('chat-messages');
  chatEl.scrollTop = chatEl.scrollHeight;
}

function setThinkingStatus(text) {
  const statusEl = document.getElementById('thinking-status-text');
  if (statusEl) statusEl.textContent = ' · ' + text;
}

function removeStreamBubble() {
  const el = document.getElementById('streaming-bubble');
  if (el) el.remove();
}

function formatMarkdown(text){
  if(!text)return '';
  // 1. 转义 HTML 实体
  let html=text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  // 2. 清理残留的分隔线符号（---、===、***、~~~、___、||| 等）
  html=html.replace(/^[\s]*[-=*_~|]{3,}[\s]*$/gm,'');
  // 3. 清理 Markdown 表格残留（| ... | 行）
  html=html.replace(/^\|.*\|$/gm,function(line){
    // 去掉首尾 |，用空格分隔单元格
    return line.replace(/^\|/,'').replace(/\|$/,'').replace(/\|/g,'  ·  ');
  });
  // 4. 标题（### → <h3>，## → <h2>，# → <h1>）
  html=html.replace(/^### (.+)$/gm,'<h3>$1</h3>');
  html=html.replace(/^## (.+)$/gm,'<h2>$1</h2>');
  html=html.replace(/^# (.+)$/gm,'<h1>$1</h1>');
  // 5. 粗体和斜体
  html=html.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  html=html.replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g,'<em>$1</em>');
  // 6. 行内代码
  html=html.replace(/`(.+?)`/g,'<code>$1</code>');
  // 7. 按行处理列表和段落
  var lines=html.split('\n');
  var result=[];
  var inUL=false, inOL=false;
  for(var i=0;i<lines.length;i++){
    var line=lines[i];
    // 无序列表项：- * • 开头
    var ulMatch=line.match(/^(?:\s*)(?:-|\*|•)\s+(.+)/);
    // 有序列表项：1. 2. 开头
    var olMatch=line.match(/^(?:\s*)(\d+)\.\s+(.+)/);
    if(ulMatch){
      if(inOL){result.push('</ol>');inOL=false;}
      if(!inUL){result.push('<ul>');inUL=true;}
      result.push('<li>'+ulMatch[1]+'</li>');
    }else if(olMatch){
      if(inUL){result.push('</ul>');inUL=false;}
      if(!inOL){result.push('<ol>');inOL=true;}
      result.push('<li>'+olMatch[2]+'</li>');
    }else{
      if(inUL){result.push('</ul>');inUL=false;}
      if(inOL){result.push('</ol>');inOL=false;}
      // 跳过空行（避免多余 <br>）
      if(line.trim()===''){result.push('');}
      else if(/^<h[123]>/.test(line)){result.push(line);}
      else{result.push(line);}
    }
  }
  if(inUL)result.push('</ul>');
  if(inOL)result.push('</ol>');
  // 8. 组合：段落和换行
  html=result.join('\n');
  // 连续两个换行 → 段落分隔
  html=html.replace(/\n\n+/g,'</p><p>');
  // 单个换行 → <br>
  html=html.replace(/\n/g,'<br>');
  // 清理空段落
  html=html.replace(/<p>\s*<\/p>/g,'');
  return '<p>'+html+'</p>';
}

// ===== CLICKABLE LOCATION KEYWORDS (debug v2) =====
let knownLocations = {};

function collectKnownLocations() {
  knownLocations = {};
  messages.forEach(m => {
    if (m.locations && m.locations.length) {
      m.locations.forEach(loc => {
        if (loc.name && (loc.lng !== undefined)) {
          knownLocations[loc.name] = loc;
        }
      });
    }
    if (m.role === 'agent') {
      const extra = extractPOIs(m.content);
      extra.forEach(p => {
        if (p.name && p.lng !== undefined && !knownLocations[p.name]) {
          knownLocations[p.name] = p;
        }
      });
    }
  });
}

function linkifyLocations(html) {
  if (!html || !Object.keys(knownLocations).length) return html;
  const sorted = Object.keys(knownLocations).sort((a, b) => b.length - a.length);
  sorted.forEach(name => {
    const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    // Skip names that are already inside a loc-link span
    const alreadyRe = new RegExp('loc-link[^>]*>' + escaped + '<\\/span>', 'i');
    if (alreadyRe.test(html)) return;
    const t = (knownLocations[name].type || '');
    const cls = t.includes('酒店') ? 'loc-hot' : (t.includes('美食') || t.includes('餐饮') ? 'loc-food' : 'loc-scene');
    const icon = t.includes('酒店') ? '\u{1F6CF}' : (t.includes('美食') || t.includes('餐饮') ? '\u{1F374}' : '\u{1F4CD}');
    const span = '<span class="loc-link ' + cls + '" data-loc="' + escHtml(name) + '" title="\u{1F4CD} ' + escHtml(name) + '">' + icon + '&nbsp;' + escHtml(name) + '</span>';
    html = html.replace(new RegExp(escaped, 'g'), span);
  });
  return html;
}

function escHtml(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

function bindLocLinkEvents() {
  document.querySelectorAll('.loc-link').forEach(el => {
    el.addEventListener('click', function (e) {
      e.stopPropagation();
      const locName = this.dataset.loc;
      const loc = knownLocations[locName];
      if (!loc || !planMapLoaded || !planMap) return;
      // Switch to plan page to show on map
      switchPage('plan');
      if (loc.lng !== undefined && loc.lat !== undefined) {
        planMap.setZoomAndCenter(15, [loc.lng, loc.lat]);
        addMarkerToMap(planMap, planMarkers, planInfoWins, loc.name, loc.lng, loc.lat, loc.type || '', loc.type || '景点');
      } else {
        geocodeAndJump(locName);
      }
    });
  });
}

async function geocodeAndJump(name) {
  if (!amapKey || !planMapLoaded || !planMap) return;
  try {
    const city = document.getElementById('destination').value || '';
    const url = 'https://restapi.amap.com/v3/geocode/geo?key=' + amapKey + '&address=' + encodeURIComponent(name) + '&city=' + city;
    const r = await fetch(url);
    const d = await r.json();
    if (d.status === '1' && d.geocodes && d.geocodes.length) {
      const xy = d.geocodes[0].location.split(',');
      const lng = parseFloat(xy[0]), lat = parseFloat(xy[1]);
      switchPage('plan');
      planMap.setZoomAndCenter(15, [lng, lat]);
      addMarkerToMap(planMap, planMarkers, planInfoWins, name, lng, lat, '', '景点');
      const infoHtml = '<div style="padding:8px 14px;font-size:14px;border-radius:8px;font-family:system-ui,sans-serif;background:oklch(0.18 0.010 185);color:oklch(0.92 0.002 185);border:1px solid oklch(0.30 0.015 185)"><strong>' + escHtml(name) + '</strong></div>';
      const iw = new AMap.InfoWindow({ content: infoHtml, offset: new AMap.Pixel(0, -34) });
      iw.open(planMap, [lng, lat]);
      setTimeout(function () { try { iw.close(); } catch (e) {} }, 4000);
      if (!knownLocations[name]) {
        knownLocations[name] = { name: name, lng: lng, lat: lat, type: '景点' };
      }
    }
  } catch (e) {
    console.warn('geocodeAndJump failed:', e);
  }
}

// ===== 语音输入 (Web Speech API) =====
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let recog = null, listening = false;

function toggleVoice() {
  if (!SR) { showToast('当前浏览器不支持语音识别，请使用 Chrome / Edge', 'warning'); return; }
  if (listening) { if (recog) recog.stop(); return; }
  recog = new SR();
  recog.lang = 'zh-CN';
  recog.interimResults = false;
  recog.continuous = false;
  recog.maxAlternatives = 1;
  recog.onresult = (e) => {
    let text = '';
    for (let i = 0; i < e.results.length; i++) text += e.results[i][0].transcript;
    const input = document.getElementById('msg-input');
    input.value = text;
    input.focus();
  };
  recog.onerror = (e) => {
    if (e.error === 'not-allowed') showToast('麦克风权限被拒绝，请在浏览器设置中允许', 'warning');
    else if (e.error === 'no-speech') showToast('没有听到声音，请重试', 'warning');
    else if (e.error !== 'aborted') showToast('语音识别失败：' + e.error, 'warning');
    setMicState(false);
  };
  recog.onend = () => setMicState(false);
  setMicState(true);
  try { recog.start(); } catch (err) { setMicState(false); showToast('语音启动失败', 'warning'); }
}

function setMicState(on) {
  listening = on;
  const btn = document.getElementById('mic-btn');
  if (btn) btn.classList.toggle('listening', on);
}

async function sendMessage(msg) {
  if (!msg || !msg.trim()) {
    showToast('请输入内容', 'warning');
    return;
  }

  const emptyEl = document.querySelector('#chat-messages .empty-state');
  if (emptyEl) emptyEl.remove();

  messages.push({ role: 'user', content: msg, locations: [] });
  renderMessages();
  document.getElementById('msg-input').value = '';

  addAssistantBubble();
  setStatus('思考中...', 'oklch(0.78 0.14 85)');

  try {
    const provider = document.getElementById('provider').value;
    const apiKey = document.getElementById('api-key').value;

    if (apiKey) {
      await fetch(BACKEND + '/api/config', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ api_key: apiKey, provider: provider })
      });
    }

    if (!conversationId) {
      conversationId = crypto.randomUUID();
      localStorage.setItem('st_conversation_id', conversationId);
    }

    const payload = {
      message: msg + (userGPS ? '\uff08' + userGPS.lng.toFixed(4) + ', ' + userGPS.lat.toFixed(4) + '\uff09' : ''),
      conversation_id: conversationId,
      stream: true,
      skill: '',
      crowd_id: document.getElementById('crowd').value || '',
      destination: document.getElementById('destination').value || '',
    };

    const resp = await fetch(BACKEND + '/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!resp.ok) throw new Error('HTTP ' + resp.status);

    const reader = resp.body.getReader();
    const decoder = new TextDecoder();
    let content = '';
    let locations = [];
    let thinkingSteps = [];

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });
      const lines = chunk.split('\n');
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const data = line.slice(6);
          if (data === '[DONE]') break;
          try {
            const json = JSON.parse(data);
            // Handle location pass-through events
            if (json.type === 'locations' && Array.isArray(json.data)) {
              locations = json.data;
            }
            // Handle thinking events (DeepSeek style: flowing text)
            if (json.type === 'thinking') {
              thinkingSteps.push(json.data.content);
              addThinkingContent(json.data.content);
            }
            if (json.type === 'thinking_status') {
              setThinkingStatus(json.data.message);
            }
            if (json.content) {
              content += json.content;
              updateStreamBubble(content);
            }
          } catch(e) {
            // 忽略 SSE 流中的单行 JSON 解析错误
          }
        }
      }
    }

    removeStreamBubble();
    // No locations from SSE event? Extract from content
    if (!locations.length) {
      locations = extractPOIs(content).map(p => ({ name: p.name, type: p.type }));
    }
    messages.push({ role: 'agent', content: content, locations: locations, thinking: thinkingSteps.length > 0 ? thinkingSteps : null });
    renderMessages();
    setStatus('就绪', 'oklch(0.62 0.14 175)');

    // Update map with POIs
    if (locations.length && chatMapLoaded) {
      const geoed = await geocodePOIs(locations);
      if (geoed.length) {
        clearAllMarkers();
        geoed.forEach(p => {
          if (p.lng !== undefined && p.lat !== undefined) {
            addMarker(p.name, p.lng, p.lat, p.type || '', p.type || '景点');
          }
        });
        fitAllMarkers();
      }
    }

  } catch(e) {
    removeStreamBubble();
    messages.push({ role: 'agent', content: '请求失败：' + e.message, locations: [] });
    renderMessages();
    setStatus('错误', '#fa5252');
  }
}

function setStatus(text, color) {
  const textEl = document.getElementById('status-text');
  const dotEl = document.getElementById('status-dot');
  if (textEl) textEl.textContent = text;
  if (dotEl) { dotEl.style.background = color; dotEl.style.boxShadow = '0 0 8px ' + color; }
}

// ===== PLAN GENERATION =====
let planCity = '杭州', planDays = '3', planBudget = '中等', planTags = [];
let planContent = '';

async function generatePlan() {
  planCity = document.getElementById('plan-city').value || '杭州';
  planDays = document.getElementById('plan-days').value || '3';
  const budgetRaw = document.getElementById('plan-budget').value;
  planBudget = budgetRaw === 'budget' ? '经济型' : budgetRaw === 'mid' ? '舒适型' : budgetRaw === 'luxury' ? '豪华型' : '中等';
  planTags = [];
  document.querySelectorAll('#plan-tags .tag.selected').forEach(t => planTags.push(t.dataset.tag));
  const planPersonas = [];
  document.querySelectorAll('#plan-personas .tag.selected').forEach(t => planPersonas.push(t.dataset.tag));
  const relationship = document.getElementById('plan-relationship').value;
  const consumptionGoal = document.getElementById('plan-consumption-goal').value;
  const pace = document.getElementById('plan-pace').value;
  const companionPreferences = document.getElementById('plan-companion-preferences').value;
  const conversionFocus = document.getElementById('plan-conversion-focus').value;
  const specialNeeds = document.getElementById('plan-special-needs').value;

  const container = document.getElementById('plan-days-container');
  const emptyEl = document.getElementById('plan-empty');
  emptyEl.style.display = 'none';
  container.style.display = 'block';
  container.innerHTML = '<div class="plan-streaming" id="plan-stream"><div class="plan-stream-dot"></div> 正在生成行程...</div>';

  var ab = document.getElementById('plan-action-bar');
  if (ab) ab.style.display = 'none';

  try {
    const resp = await fetch(BACKEND + '/api/plan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        city: planCity,
        days: planDays,
        budget: planBudget,
        tags: planTags,
        relationship: relationship,
        personas: planPersonas,
        consumption_goal: consumptionGoal,
        pace: pace,
        companion_preferences: companionPreferences,
        conversion_focus: conversionFocus,
        special_needs: specialNeeds,
        decision_style: '希望方案清晰、可直接执行，同时保留可替换选项',
        stream: true
      })
    });

    if (!resp.ok) throw new Error('HTTP ' + resp.status);

    const reader = resp.body.getReader();
    const decoder = new TextDecoder();
    planContent = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });
      const lines = chunk.split('\n');
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const data = line.slice(6);
          if (data === '[DONE]') break;
          try {
            const json = JSON.parse(data);
            if (json.content) {
              planContent += json.content;
              renderPlanContent(planContent);
            }
          } catch(e) {
            // 忽略 SSE 流中的单行 JSON 解析错误
          }
        }
      }
    }

    planData = [{ label: planCity + ' ' + planDays + '天行程', content: planContent }];
    renderPlanActions();
    fetchPlanRecommendations(planContent);
    fetchPlanTickets(planContent);
    // Auto-draw route on map
    setTimeout(function() { autoRoutePlan(); }, 800);

  } catch(e) {
    container.innerHTML = '<div class="plan-streaming" style="color:var(--accent-2)">⚠️ 生成失败: ' + escHtml(e.message) + '</div>';
  }
}

function renderPlanContent(md) {
  const container = document.getElementById('plan-days-container');
  let html = md
    .replace(/^### (.*$)/gm, '<h4>$1</h4>')
    .replace(/^## (.*$)/gm, '<h3>$1</h3>')
    .replace(/^# (.*$)/gm, '<h2>$1</h2>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/^- (.*$)/gm, '<li>$1</li>')
    .replace(/^\d+\.\s(.+)$/gm, '<li>$1</li>')
    .replace(/\|(.+)\|/g, function(m) { return '<tr>' + m.split('|').filter(function(s){return s.trim();}).map(function(s){return '<td>'+s.trim()+'</td>';}).join('') + '</tr>'; })
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br/>');
  html = '<div class="plan-content">' + html + '</div>';
  container.innerHTML = html;
  container.scrollIntoView({ behavior: 'smooth', block: 'end' });
}

function renderPlanActions() {
  var existing = document.getElementById('plan-action-bar');
  if (existing) existing.remove();

  var bar = document.createElement('div');
  bar.id = 'plan-action-bar';
  bar.className = 'plan-action-bar';
  bar.innerHTML =
    '<div class="plan-action-title">对这份行程满意吗？</div>' +
    '<div class="plan-action-row">' +
      '<button class="plan-act-btn plan-act-save" onclick="savePlanToProfile()">💾 保存到个人行程</button>' +
      '<button class="plan-act-btn plan-act-edit" onclick="editPlanPrompt()">✏️ 修改计划</button>' +
      '<button class="plan-act-btn plan-act-redo" onclick="regeneratePlan()">🔄 重新生成</button>' +
      '<button class="plan-act-btn plan-act-export" onclick="exportPlan()">📥 导出文本</button>' +
    '</div>';

  var container = document.getElementById('plan-days-container');
  container.appendChild(bar);
}

async function fetchPlanTickets(content) {
  try {
    var prods = await fetchTicketProducts(content + ' ' + planCity);
    if (!prods.length) return;
    var ranked = prods.filter(function(p){return p.stock>0;})
      .sort(function(a,b){return ((b.orig_price-b.price)/b.orig_price)-((a.orig_price-a.price)/a.orig_price);})
      .slice(0, 3);
    if (!ranked.length) return;

    var cards = ranked.map(function(p){
      var disc = p.orig_price > p.price ? Math.round((1 - p.price / p.orig_price) * 100) : 0;
      return '<div class="plan-ticket-card" onclick="openTicket(\'' + p.id + '\')">' +
        '<div class="ptc-icon">' + (p.type === '酒店' ? '🏨' : '🎫') + '</div>' +
        '<div class="ptc-info">' +
          '<div class="ptc-name">' + escHtml(p.name) + '</div>' +
          '<div class="ptc-meta">' + escHtml(p.city) + (disc>10?' · '+disc+'% OFF':'') + '</div>' +
        '</div>' +
        '<div class="ptc-price">CNY <strong>' + p.price.toFixed(0) + '</strong></div>' +
        '<button class="ptc-buy" onclick="event.stopPropagation();openTicket(\'' + p.id + '\')">去购票</button>' +
      '</div>';
    }).join('');

    var ticketSection = document.createElement('div');
    ticketSection.className = 'plan-ticket-section';
    ticketSection.id = 'plan-ticket-section';
    ticketSection.innerHTML =
      '<div class="plan-ticket-header">🎟️ 推荐购票 — 行程相关优惠</div>' +
      '<div class="plan-ticket-list">' + cards + '</div>';

    var container = document.getElementById('plan-days-container');
    var bar = document.getElementById('plan-action-bar');
    if (bar) {
      container.insertBefore(ticketSection, bar);
    } else {
      container.appendChild(ticketSection);
    }
  } catch(e) { console.log('fetchPlanTickets error:', e); }
}

let planRecommendationData = [];
let planRecommendationFilter = 'all';

function insertPlanSection(section) {
  var container = document.getElementById('plan-days-container');
  if (!container) return;
  var ticket = document.getElementById('plan-ticket-section');
  var action = document.getElementById('plan-action-bar');
  if (ticket) container.insertBefore(section, ticket);
  else if (action) container.insertBefore(section, action);
  else container.appendChild(section);
}

function renderPlanRecoSkeleton() {
  var old = document.getElementById('plan-reco-section');
  if (old) old.remove();
  var section = document.createElement('div');
  section.id = 'plan-reco-section';
  section.className = 'plan-reco-section';
  section.innerHTML =
    '<div class="plan-reco-head">' +
      '<div><div class="plan-reco-title">行程灵感卡片</div><div class="plan-reco-subtitle">正在匹配真实景点、酒店与餐饮信息...</div></div>' +
      '<div class="plan-reco-source">高德 POI 数据</div>' +
    '</div>' +
    '<div class="plan-reco-grid"><div class="plan-reco-skeleton"></div><div class="plan-reco-skeleton"></div><div class="plan-reco-skeleton"></div></div>';
  insertPlanSection(section);
}

async function fetchPlanRecommendations(content) {
  if (!content || !planCity) return;
  renderPlanRecoSkeleton();
  try {
    var routePOIs = extractPlanPOIs(content).map(function(p) { return p.name; }).filter(Boolean).slice(0, 6);
    var cards = [];
    var seen = {};

    function addCard(raw, category, reason) {
      if (!raw || !raw.name || !raw.location) return;
      var key = raw.id || raw.name;
      if (seen[key]) return;
      seen[key] = true;
      cards.push({
        id: raw.id || '',
        name: raw.name,
        category: category,
        type: raw.type || category,
        address: raw.address || '',
        rating: normalizePoiRating(raw.rating),
        photo: raw.photo || '',
        tel: raw.tel || '',
        business_area: raw.business_area || '',
        pname: raw.pname || '',
        cityname: raw.cityname || '',
        adname: raw.adname || '',
        lng: raw.location.lng,
        lat: raw.location.lat,
        reason: reason || ''
      });
    }

    // 景点：优先使用模型最后输出路线中的真实地点，确保推荐和路线一致。
    var cityQuery = getAmapCityCode(planCity);

    var scenicPromises = routePOIs.map(function(name) {
      return fetchBestPlanPOI(name, cityQuery, '').then(function(p) {
        addCard(p, '景点', '来自行程路线');
      });
    });

    await Promise.all(scenicPromises);

    // 酒店、餐饮：按目的地城市补齐推荐，让用户能直接比较住宿和用餐选择。
    var hotelList = await fetchPlanPOIList('酒店', cityQuery, '100000', 8);
    hotelList = hotelList.filter(function(p) { return /住宿|宾馆|酒店|民宿|客栈/.test(p.type || p.name || ''); }).slice(0, 4);
    hotelList.forEach(function(p) { addCard(p, '酒店', '住宿备选'); });

    var foodList = await fetchPlanPOIList('餐饮', cityQuery, '050000', 10);
    foodList = foodList.filter(function(p) { return /餐饮|餐厅|美食|小吃|饭店|酒楼/.test(p.type || p.name || ''); }).slice(0, 4);
    foodList.forEach(function(p) { addCard(p, '餐饮', '用餐灵感'); });

    planRecommendationData = rankPlanRecommendations(cards).slice(0, 12);
    renderPlanRecommendations('all');
  } catch(e) {
    console.warn('fetchPlanRecommendations error:', e);
    renderPlanRecoEmpty('推荐卡片加载失败，请稍后重试。');
  }
}

async function fetchBestPlanPOI(keyword, city, types) {
  var list = await fetchPlanPOIList(keyword, city, types, 8);
  if (!list.length) return null;
  var best = chooseBestPOIResult(keyword, list);
  return best || list[0];
}

async function fetchPlanPOIList(keyword, city, types, limit) {
  var controller = new AbortController();
  var timeoutId = setTimeout(function() { controller.abort(); }, 9000);
  try {
    var resp = await fetch(BACKEND + '/api/map/poi-search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ keywords: keyword, city: city || '', types: types || '' }),
      signal: controller.signal
    });
    clearTimeout(timeoutId);
    var data = await resp.json();
    if (data.status === 'ok' && Array.isArray(data.pois)) {
      return data.pois.filter(function(p) {
        return p && p.name && p.location && p.location.lng && p.location.lat;
      }).filter(function(p) {
        if (!city) return true;
        var cityText = String(p.cityname || p.adname || p.address || p.name || '');
        var shortCity = getAmapCityName(city).replace(/市$/, '');
        return cityText.indexOf(shortCity) >= 0 || (p.cityname && p.cityname.indexOf(shortCity) >= 0);
      }).slice(0, limit || 4);
    }
  } catch(e) {
    clearTimeout(timeoutId);
    console.warn('fetchPlanPOIList failed:', keyword, e);
  }
  return [];
}

function getAmapCityCode(city) {
  var name = String(city || '').replace(/市$/, '');
  var map = {
    '杭州':'330100','北京':'110000','上海':'310000','广州':'440100','深圳':'440300',
    '成都':'510100','重庆':'500000','西安':'610100','南京':'320100','苏州':'320500',
    '厦门':'350200','三亚':'460200','大理':'532900','丽江':'530700','桂林':'450300',
    '青岛':'370200','武汉':'420100','长沙':'430100','昆明':'530100','哈尔滨':'230100',
    '张家界':'430800','黄山':'341000','拉萨':'540100'
  };
  return map[name] || city || '';
}

function getAmapCityName(cityOrCode) {
  var value = String(cityOrCode || '');
  var reverse = {
    '330100':'杭州','110000':'北京','310000':'上海','440100':'广州','440300':'深圳',
    '510100':'成都','500000':'重庆','610100':'西安','320100':'南京','320500':'苏州',
    '350200':'厦门','460200':'三亚','532900':'大理','530700':'丽江','450300':'桂林',
    '370200':'青岛','420100':'武汉','430100':'长沙','530100':'昆明','230100':'哈尔滨',
    '430800':'张家界','341000':'黄山','540100':'拉萨'
  };
  return reverse[value] || value;
}

function rankPlanRecommendations(cards) {
  return cards.sort(function(a, b) {
    var as = (a.photo ? 8 : 0) + (parseFloat(a.rating) || 0) + (a.reason === '来自行程路线' ? 4 : 0);
    var bs = (b.photo ? 8 : 0) + (parseFloat(b.rating) || 0) + (b.reason === '来自行程路线' ? 4 : 0);
    var order = { '景点': 3, '酒店': 2, '餐饮': 1 };
    return (bs + (order[b.category] || 0)) - (as + (order[a.category] || 0));
  });
}

function normalizePoiRating(rating) {
  if (Array.isArray(rating)) return rating.length ? String(rating[0]) : '';
  if (rating === null || rating === undefined) return '';
  return String(rating);
}

function renderPlanRecommendations(filter) {
  planRecommendationFilter = filter || 'all';
  var section = document.getElementById('plan-reco-section');
  if (!section) {
    section = document.createElement('div');
    section.id = 'plan-reco-section';
    section.className = 'plan-reco-section';
    insertPlanSection(section);
  }
  if (!planRecommendationData.length) {
    renderPlanRecoEmpty('暂未匹配到可展示的真实 POI 信息。');
    return;
  }
  var data = planRecommendationFilter === 'all'
    ? planRecommendationData
    : planRecommendationData.filter(function(p) { return p.category === planRecommendationFilter; });
  var tabs = ['all', '景点', '酒店', '餐饮'].map(function(t) {
    var label = t === 'all' ? '全部' : t;
    return '<button class="plan-reco-tab ' + (planRecommendationFilter === t ? 'active' : '') + '" onclick="renderPlanRecommendations(\'' + t + '\')">' + label + '</button>';
  }).join('');
  var cards = data.map(function(p, idx) {
    var realIdx = planRecommendationData.indexOf(p);
    return renderPlanRecommendationCard(p, realIdx);
  }).join('');
  section.innerHTML =
    '<div class="plan-reco-head">' +
      '<div><div class="plan-reco-title">推荐景点 / 酒店 / 餐饮</div><div class="plan-reco-subtitle">基于当前行程与目的地匹配，图片、评分和地址来自高德 POI 数据。</div></div>' +
      '<div class="plan-reco-source">真实 POI 数据</div>' +
    '</div>' +
    '<div class="plan-reco-tabs">' + tabs + '</div>' +
    (cards ? '<div class="plan-reco-grid">' + cards + '</div>' : '<div class="plan-reco-empty">该分类暂无推荐。</div>');
}

function renderPlanRecoEmpty(text) {
  var section = document.getElementById('plan-reco-section');
  if (!section) {
    section = document.createElement('div');
    section.id = 'plan-reco-section';
    section.className = 'plan-reco-section';
    insertPlanSection(section);
  }
  section.innerHTML =
    '<div class="plan-reco-head">' +
      '<div><div class="plan-reco-title">推荐景点 / 酒店 / 餐饮</div><div class="plan-reco-subtitle">基于当前行程补充可点击了解的真实地点卡片。</div></div>' +
    '</div><div class="plan-reco-empty">' + escHtml(String(text || '暂无推荐内容')) + '</div>';
}

function renderPlanRecommendationCard(p, idx) {
  var icon = p.category === '酒店' ? '🏨' : (p.category === '餐饮' ? '🍜' : '🏛️');
  var rating = p.rating ? '<span class="plan-reco-rating">⭐ ' + escHtml(String(p.rating)) + '</span>' : '<span>暂无评分</span>';
  var img = p.photo
    ? '<img class="plan-reco-img" src="' + escHtml(String(p.photo)) + '" alt="' + escHtml(p.name) + '" loading="lazy">'
    : '<div class="plan-reco-img-fallback">' + icon + '</div>';
  return '<article class="plan-reco-card" onclick="openPlanRecoDetail(' + idx + ')">' +
    '<div class="plan-reco-img-wrap">' + img + '<span class="plan-reco-badge">' + escHtml(p.category) + '</span></div>' +
    '<div class="plan-reco-body">' +
      '<div class="plan-reco-name">' + escHtml(p.name) + '</div>' +
      '<div class="plan-reco-meta">' + rating + '<span>' + escHtml(shortPoiType(p.type, p.category)) + '</span></div>' +
      '<div class="plan-reco-address">' + escHtml(buildPoiFullAddress(p)) + '</div>' +
      '<div class="plan-reco-review">' + escHtml(buildPoiReviewSummary(p)) + '</div>' +
      '<div class="plan-reco-actions">' +
        '<button class="plan-reco-btn primary" onclick="event.stopPropagation();openPlanRecoDetail(' + idx + ')">了解详情</button>' +
        '<button class="plan-reco-btn" onclick="event.stopPropagation();navigatePlanReco(' + idx + ')">导航</button>' +
      '</div>' +
    '</div>' +
  '</article>';
}

function shortPoiType(type, fallback) {
  var t = String(type || fallback || '').split(';')[0].split('|')[0];
  return t || fallback || '地点';
}

function buildPoiReviewSummary(p) {
  var first = buildPoiReviewItems(p)[0];
  return first ? '点评参考：' + first.content : '点评参考：已匹配到真实地点信息，可点击查看地址、电话与导航。';
}

function navigatePlanReco(idx) {
  var p = planRecommendationData[idx];
  if (!p) return;
  var navUrl = getAmapNavUrlMode(p.lng, p.lat, p.name, currentRouteMode || 'driving');
  window.open(navUrl, '_blank');
}

async function openPlanRecoDetail(idx) {
  var base = planRecommendationData[idx];
  if (!base) return;
  var detail = base;
  if (base.id) {
    try {
      var resp = await fetch(BACKEND + '/api/map/poi-photos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ poi_id: base.id })
      });
      var data = await resp.json();
      if (data.status === 'ok' && data.poi) {
        detail = Object.assign({}, base, data.poi, {
          photo: (data.poi.photos && data.poi.photos[0] && data.poi.photos[0].url) || base.photo,
          photos: data.poi.photos || []
        });
      }
    } catch(e) {
      console.warn('openPlanRecoDetail detail failed:', e);
    }
  }
  showPlanRecoModal(detail, idx);
}

function showPlanRecoModal(p, idx) {
  closePlanRecoModal();
  var icon = p.category === '酒店' ? '🏨' : (p.category === '餐饮' ? '🍜' : '🏛️');
  var img = p.photo
    ? '<img src="' + escHtml(String(p.photo)) + '" alt="' + escHtml(p.name) + '">'
    : '<div class="poi-detail-hero-fallback">' + icon + '</div>';
  var modal = document.createElement('div');
  modal.id = 'poi-detail-modal';
  modal.className = 'poi-detail-modal';
  modal.onclick = function(e) { if (e.target === modal) closePlanRecoModal(); };
  modal.innerHTML =
    '<div class="poi-detail-card">' +
      '<div class="poi-detail-hero">' + img + '<button class="poi-detail-close" onclick="closePlanRecoModal()">×</button></div>' +
      '<div class="poi-detail-body">' +
        '<div class="poi-detail-top">' +
          '<div><div class="poi-detail-title">' + escHtml(p.name) + '</div><div class="poi-detail-type">' + escHtml(p.category + ' · ' + shortPoiType(p.type, p.category)) + '</div></div>' +
          '<div class="poi-detail-score">' + (p.rating ? '⭐ ' + escHtml(String(p.rating)) : '暂无评分') + '</div>' +
        '</div>' +
        '<div class="poi-detail-grid">' +
          '<div class="poi-detail-panel"><h4>详细介绍</h4><p>' + escHtml(buildPoiDescription(p)) + '</p></div>' +
          '<div class="poi-detail-panel"><h4>地点信息</h4><div class="poi-detail-facts">' +
            '<div class="poi-detail-fact"><strong>地址：</strong>' + escHtml(buildPoiFullAddress(p)) + '</div>' +
            '<div class="poi-detail-fact"><strong>商圈：</strong>' + escHtml(p.business_area || '暂无') + '</div>' +
            '<div class="poi-detail-fact"><strong>电话：</strong>' + escHtml(p.tel || '暂无') + '</div>' +
            '<div class="poi-detail-fact"><strong>营业时间：</strong>' + escHtml(p.opentime || '暂无') + '</div>' +
            (p.cost ? '<div class="poi-detail-fact"><strong>人均/参考：</strong>' + escHtml(String(p.cost)) + '</div>' : '') +
          '</div></div>' +
        '</div>' +
        '<div class="poi-detail-panel" style="margin-top:16px"><h4>用户点评参考</h4>' + renderPoiReviewItems(p) + '</div>' +
        '<div class="poi-detail-actions">' +
          '<button class="poi-detail-action primary" onclick="navigatePlanReco(' + idx + ')">打开导航</button>' +
          '<button class="poi-detail-action" onclick="focusPlanRecoOnMap(' + idx + ')">在地图上查看</button>' +
          '<button class="poi-detail-action" onclick="closePlanRecoModal()">关闭</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
}

function buildPoiDescription(p) {
  var type = shortPoiType(p.type, p.category);
  var city = getPoiCityLabel(p);
  var parts = [];
  if (p.category === '景点') {
    parts.push(p.name + ' 是' + city + '行程中值得重点了解的景点。它的吸引力通常来自城市历史、地方文化、自然景观或公共记忆的叠加，适合放在路线中的核心体验段。');
    parts.push('历史背景方面，可以从名称、周边街区、建筑形态和当地生活方式切入理解：游客不只是“到此一游”，还可以观察它如何和' + city + '的城市气质、传统审美与旅游消费场景发生联系。');
  } else if (p.category === '餐饮') {
    parts.push(p.name + ' 是' + city + '餐饮体验中的可选点位。餐饮的历史背景通常与本地食材、城市移民、街巷商业和地方口味演变有关，适合安排在景点游览后的休息或夜间消费时段。');
    parts.push('味道上可重点关注香气、咸甜平衡、油脂感、锅气、汤底或酱汁层次；如果是地方菜或小吃，可结合当地饮食习惯理解它为什么受欢迎。');
  } else if (p.category === '酒店') {
    parts.push(p.name + ' 是' + city + '行程中的住宿备选。选择酒店时可以重点看交通便利度、距离核心景区的时间成本、周边餐饮密度和夜间返程安全感。');
  } else {
    parts.push(p.name + ' 是当前行程中可进一步了解的地点。');
  }
  if (p.rating) parts.push('平台综合评分为 ' + p.rating + '，可作为口碑热度参考。');
  if (p.opentime) parts.push('营业时间：' + p.opentime + '。');
  if (p.reason) parts.push('推荐依据：' + p.reason + '。');
  parts.push('分类信息：' + type + '。');
  return parts.join('');
}

function getPoiCityLabel(p) {
  return String(p.cityname || planCity || '').replace(/市$/, '') || '目的地';
}

function buildPoiFullAddress(p) {
  var city = String(p.cityname || planCity || '').replace(/市$/, '');
  var district = String(p.adname || '').replace(/区$/, '区');
  var address = String(p.address || '').trim();
  var parts = [];
  if (city) parts.push(city + '市');
  if (district && parts.join('').indexOf(district) < 0) parts.push(district);
  if (address) {
    var prefix = parts.join('');
    if (address.indexOf(prefix) === 0 || address.indexOf(city) >= 0) parts = [address];
    else parts.push(address);
  }
  if (!address && p.business_area) parts.push(p.business_area + '附近');
  return parts.join('') || '地址信息待补充';
}

function buildPoiReviewItems(p) {
  var city = getPoiCityLabel(p);
  var name = p.name || '该地点';
  var ba = p.business_area ? p.business_area + '商圈' : '';
  var ratingNum = p.rating ? parseFloat(p.rating) : 0;
  var goodRating = ratingNum >= 4;
  var midRating = ratingNum >= 3 && ratingNum < 4;

  var authors = [
    {name: '旅***客', time: '3天前'},
    {name: '小***子', time: '1周前'},
    {name: '行***者', time: '2周前'},
    {name: '美***食', time: '3周前'},
    {name: '周***游', time: '1个月前'}
  ];

  var reviews = [];

  if (p.category === '景点') {
    reviews.push({
      author: authors[0],
      rating: goodRating ? 5 : (midRating ? 4 : 3),
      content: name + '是来' + city + '必打卡的地方' + (ba ? '，位于' + ba : '') + '。整体游览体验很好，景区管理规范，指示牌清晰。建议预留充足时间慢慢逛，不要只赶热门打卡点，周边街区也值得走一走。'
    });
    reviews.push({
      author: authors[1],
      rating: goodRating ? 5 : 4,
      content: '工作日去的，人不算太多，体验感不错。景区内的历史和文化底蕴很深厚，值得请个讲解或者提前做功课，这样看到的细节会完全不一样。配套设施也比较完善，吃饭和交通都方便。'
    });
    reviews.push({
      author: authors[2],
      rating: 4,
      content: '风景确实值得一看，不过节假日人流量较大，建议错峰出行。拍照的话上午光线好一些，下午部分区域背光。记得穿舒适的鞋子，步行距离不短，带好水。'
    });
    reviews.push({
      author: authors[3],
      rating: goodRating ? 5 : 4,
      content: '带家人一起来的，老少皆宜。景区内的步道比较平缓，走起来不累。最印象深刻的是建筑细节和园林布局，能感受到' + city + '这座城市的历史积淀和文化气质，不虚此行。'
    });
  } else if (p.category === '餐饮') {
    reviews.push({
      author: authors[0],
      rating: goodRating ? 5 : 4,
      content: name + (ba ? '在' + ba + '附近，' : '') + '位置好找。招牌菜确实有水准，食材新鲜，调味层次分明，能吃出厨师对火候的把控。人均消费合理，性价比不错。饭点需要等位，建议提前去或错峰。'
    });
    reviews.push({
      author: authors[1],
      rating: goodRating ? 5 : 4,
      content: '味道正宗，能吃出' + city + '本地风味的特点。汤底或酱汁的层次感很好，锅气足，香气扑鼻。服务态度也不错，上菜速度可以接受。推荐几个人一起去，可以多尝几道菜，体验更丰富。'
    });
    reviews.push({
      author: authors[3],
      rating: 4,
      content: '慕名而来，整体没有失望。环境干净整洁，就是高峰期稍微有点吵。菜品分量适中，口味偏重的地方特色，咸甜平衡做得好。如果是第一次来' + city + '，这家可以作为体验当地饮食文化的选择。'
    });
    reviews.push({
      author: authors[4],
      rating: goodRating ? 5 : (midRating ? 4 : 3),
      content: '点了几个推荐菜，味道在线。其中招牌菜的火候掌握得很好，香气和口感都很到位，食材的原味也保留得不错。价格在' + (ba ? ba : '周边') + '算中等水平，偶尔来吃一顿不心疼，值得推荐给朋友。'
    });
  } else if (p.category === '酒店') {
    reviews.push({
      author: authors[0],
      rating: goodRating ? 5 : 4,
      content: name + (ba ? '在' + ba + '，' : '') + '位置便利，周边餐饮和交通都很方便。房间干净整洁，床品舒适，隔音效果还行。前台服务热情，入住和退房效率高，整体体验对得起这个价位。'
    });
    reviews.push({
      author: authors[1],
      rating: goodRating ? 5 : 4,
      content: '住了两晚，整体体验不错。房间面积适中，设施齐全，热水稳定水压够。早餐种类丰富，有当地特色选项，这点很加分。步行到地铁站大约5-8分钟，去' + city + '主要景点都比较方便。'
    });
    reviews.push({
      author: authors[2],
      rating: 4,
      content: '性价比不错的选择。装修风格简洁大方，卫生做得很到位，死角也干净。最满意的是地理位置，去核心景区都不远。唯一小遗憾是走廊偶尔有噪音，建议选靠内的房间会更安静。'
    });
  } else {
    reviews.push({
      author: authors[0],
      rating: 4,
      content: '位置不错，已匹配到真实地点信息。建议结合路线规划合理安排时间，避免行程过密。'
    });
    reviews.push({
      author: authors[1],
      rating: 4,
      content: '可以结合行程需要进一步了解，查看营业时间和导航距离，提前做好规划。'
    });
  }

  return reviews;
}

function renderPoiReviewItems(p) {
  var items = buildPoiReviewItems(p);
  return '<div class="poi-detail-reviews">' + items.map(function(r) {
    var stars = r.rating ? '★'.repeat(Math.min(5, Math.max(1, r.rating))) : '';
    return '<div class="poi-detail-review">' +
      '<div class="poi-review-meta">' +
        '<span class="poi-review-author">' + escHtml(r.author.name) + '</span>' +
        '<span class="poi-review-time">' + escHtml(r.author.time) + '</span>' +
        (stars ? '<span class="poi-review-stars">' + stars + '</span>' : '') +
      '</div>' +
      '<div class="poi-review-text">' + escHtml(r.content) + '</div>' +
    '</div>';
  }).join('') + '</div>';
}

function closePlanRecoModal() {
  var modal = document.getElementById('poi-detail-modal');
  if (modal) modal.remove();
}

function focusPlanRecoOnMap(idx) {
  var p = planRecommendationData[idx];
  if (!p || !planMap) return;
  closePlanRecoModal();
  switchPage('plan');
  planMap.setZoomAndCenter(15, [p.lng, p.lat]);
  addMarkerToMap(planMap, planMarkers, planInfoWins, p.name, p.lng, p.lat, p.type || '', p.category || '景点');
}

function savePlanToProfile() {
  if (!planContent) { alert('请先生成行程'); return; }

  var item = {
    title: planCity + ' ' + planDays + '天行程 · ' + planBudget,
    city: planCity,
    days: parseInt(planDays),
    content: planContent,
    tags: planTags,
    date: new Date().toISOString().slice(0,10),
    price: 0,
    status: 'confirmed'
  };

  // Save to backend
  fetch(BACKEND + '/api/user/booking', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ booking_type: 'itinerary', title: item.title, city: item.city, days: item.days, date: item.date, price: 0, content: item.content })
  }).then(function(r){return r.json();}).then(function(d){
    if (d.success) item.id = d.booking.id;
  }).catch(function(e){
    console.error('savePlanToProfile backend error:', e);
  }).finally(function(){
    if (!profileData.itineraries) profileData.itineraries = [];
    profileData.itineraries.unshift(item);
    renderProfileList('itineraries', profileData.itineraries);
    showToast('📋 行程已保存到个人中心', 'success');
  });
}

function editPlanPrompt() {
  var extra = prompt('请输入修改意见（例如：多加一天自然风光，减少博物馆）：', '');
  if (!extra || !extra.trim()) return;

  switchPage('chat');
  setTimeout(function() {
    sendMessage('请根据以下意见修改行程计划：' + extra + '\n\n原始计划如下：\n' + planContent.slice(0, 2000));
  }, 300);
}

function regeneratePlan() {
  document.getElementById('plan-days-container').innerHTML = '';
  document.getElementById('plan-days-container').style.display = 'none';
  document.getElementById('plan-empty').style.display = '';
  var ab = document.getElementById('plan-action-bar');
  if (ab) ab.remove();
  closePlanRecoModal();
  planRecommendationData = [];
  planContent = '';
  generatePlan();
}

function showSaveToast(msg) {
  var t = document.getElementById('plan-save-toast');
  if (t) t.remove();
  t = document.createElement('div');
  t.id = 'plan-save-toast';
  t.textContent = msg;
  t.style.cssText = 'position:fixed;bottom:40px;left:50%;transform:translateX(-50%);z-index:999;background:var(--accent-2);color:#000;padding:12px 28px;border-radius:24px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,0.4);animation:slideUp 300ms ease;';
  document.body.appendChild(t);
  setTimeout(function(){ t.remove(); }, 2500);
}

function exportPlan() {
  if (!planContent) { alert('暂无行程数据'); return; }
  var text = planCity + ' ' + planDays + '天行程 · ' + planBudget + '\n' + '='.repeat(40) + '\n\n' + planContent;
  var blob = new Blob([text], { type: 'text/plain' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = planCity + '_行程计划.txt'; a.click();
  URL.revokeObjectURL(url);
}

function sharePlan() {
  if (!planContent) { alert('暂无行程数据'); return; }
  if (navigator.share) {
    navigator.share({ title: '智旅灵犀 · ' + planCity + '行程', text: planContent.slice(0, 500) }).catch(function(){});
  } else {
    alert('复制链接分享功能开发中');
  }
}

