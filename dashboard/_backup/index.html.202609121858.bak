let _inspireCurrentCat = 'all';
let _inspireSaved = JSON.parse(localStorage.getItem('inspire_saved') || '[]');
let _inspireCurrentProduct = null;
let _marketHotRefreshing = false;
let _marketHotTimer = null;

function setMarketHotStatus(text) {
  ['community-market-status', 'mkt-inspire-live-status'].forEach(function(id) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  });
}

function setMarketRefreshLoading(loading) {
  ['community-market-refresh', 'mkt-market-refresh'].forEach(function(id) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.classList.toggle('loading', loading);
    btn.textContent = loading ? '更新中...' : (id === 'mkt-market-refresh' ? '更新热点' : '更新市场热点');
  });
}

function mergeMarketCommunityPosts(posts, replaceDynamic) {
  if (!Array.isArray(posts) || !posts.length) return 0;
  if (replaceDynamic) {
    communityPosts = communityPosts.filter(function(post) {
      return !['official', 'market_hot'].includes(post.source) && !String(post.id || '').startsWith('douyin-hot-post-');
    });
  }
  const seen = {};
  if (!replaceDynamic) {
    communityPosts.forEach(function(post) { seen[post.title] = true; });
  }
  const incoming = posts.filter(function(post) {
    return post && post.title && !seen[post.title] && !isGenericHotspotTitle(post.title);
  }).map(function(post) {
    return {
      id: post.id || ('market-post-' + Date.now() + '-' + Math.random().toString(16).slice(2)),
      type: post.type || 'culture',
      title: post.title,
      author: post.author || '市场热点观察',
      tag: post.tag || '实时热点',
      views: Number(post.views || 1),
      favs: Number(post.favs || 0),
      image: post.image || 'https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?auto=format&fit=crop&w=900&q=80',
      content: post.content || post.summary || '',
      source: post.source || 'market_hot',
      source_url: post.source_url || '',
      category: post.category || '',
      image_mode: post.image_mode || ''
    };
  });
  if (!incoming.length) return 0;
  communityPosts = incoming.concat(communityPosts).slice(0, 36);
  saveCommunityPosts();
  renderCommunity();
  return incoming.length;
}

function mergeMarketCreativeProducts(products, replaceDynamic) {
  if (!Array.isArray(products) || !products.length) return 0;
  if (replaceDynamic) {
    for (let i = INSPIRE_PRODUCTS.length - 1; i >= 0; i -= 1) {
      if (INSPIRE_PRODUCTS[i] && INSPIRE_PRODUCTS[i].dynamic) INSPIRE_PRODUCTS.splice(i, 1);
    }
  }
  const seen = {};
  INSPIRE_PRODUCTS.forEach(function(product) { seen[product.name] = true; });
  let added = 0;
  products.slice().reverse().forEach(function(product) {
    if (!product || !product.name || seen[product.name]) return;
    seen[product.name] = true;
    INSPIRE_PRODUCTS.unshift({
      id: product.id || ('hot_' + Date.now() + '_' + added),
      name: product.name,
      brand: product.brand || '市场热门',
      cat: product.cat || '文创IP',
      img: product.img || '',
      price: Number(product.price || 99),
      sales: product.sales || '实时',
      badge: product.badge || 'hot',
      badgeText: product.badgeText || '实时热',
      tags: Array.isArray(product.tags) ? product.tags : ['实时热点'],
      desc: product.desc || '',
      design: product.design || product.desc || '',
      culture: product.culture || '',
      audience: product.audience || '大众游客',
      inspire: Array.isArray(product.inspire) ? product.inspire : [],
      dynamic: true
    });
    added += 1;
  });
  if (added) renderInspireProducts();
  return added;
}

async function refreshMarketHotContent(manual) {
  if (_marketHotRefreshing) return;
  _marketHotRefreshing = true;
  setMarketRefreshLoading(true);
  setMarketHotStatus('正在根据市场热点更新社区攻略和文创灵感...');
  try {
    const city = document.getElementById('plan-city')?.value || document.getElementById('mkt-destination')?.value || '杭州';
    const keyword = '文旅 文创 攻略 热门';
    const refreshToken = (manual ? 'manual-' : 'auto-') + Date.now() + '-' + Math.random().toString(16).slice(2);
    const data = await apiFetch(BACKEND + '/api/market/hot-inspirations?keyword=' + encodeURIComponent(keyword) + '&city=' + encodeURIComponent(city) + '&persist=1&limit=6&refresh_token=' + encodeURIComponent(refreshToken), {__noToast:true, timeout:25000});
    const postCount = mergeMarketCommunityPosts(data.community_posts || [], !!manual);
    const productCount = mergeMarketCreativeProducts(data.creative_products || [], !!manual);
    if (typeof loadXhsNotes === 'function') loadXhsNotes();
    const timeText = (data.generated_at || new Date().toLocaleString()).replace('T', ' ');
    const modeText = data.mode === 'official' ? '官方/授权接口' : '本地市场趋势包';
    setMarketHotStatus('已更新：换入攻略 ' + postCount + ' 条，换入文创灵感 ' + productCount + ' 款。已按旅游规划、景点、美食等语义识别。来源：' + modeText + ' · ' + timeText);
    if (manual) showToast('市场热点已更新', 'success');
  } catch(e) {
    setMarketHotStatus('市场热点更新失败，已保留当前本地精选内容。');
    if (manual) showToast('市场热点更新失败，请确认后端服务已重启', 'warning');
  } finally {
    _marketHotRefreshing = false;
    setMarketRefreshLoading(false);
  }
}

function scheduleMarketHotRefresh() {
  if (_marketHotTimer) clearInterval(_marketHotTimer);
  refreshMarketHotContent(false);
  _marketHotTimer = setInterval(function() {
    refreshMarketHotContent(false);
  }, 10 * 60 * 1000);
}

function getProductVisual(p){
  const palettes = {
    '博物馆':['#8b3a2b','#d7a94c','#f6ead2'],
    '非遗':['#1f6f5b','#d6a84f','#f2efe2'],
    '国潮':['#b22f2f','#f0c35a','#fff4dc'],
    '文创IP':['#2d5f8f','#d6b15b','#eef5f8'],
    '节庆':['#b64635','#e5b45c','#fff0d6']
  };
  const colors = palettes[p.cat] || ['#8b3a2b','#d7a94c','#f6ead2'];
  const initials = p.name.replace(/[·《》]/g,'').slice(0,4);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="520" height="320" viewBox="0 0 520 320">
    <defs>
      <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
        <stop offset="0" stop-color="${colors[0]}"/>
        <stop offset=".58" stop-color="${colors[1]}"/>
        <stop offset="1" stop-color="${colors[2]}"/>
      </linearGradient>
      <radialGradient id="r" cx=".72" cy=".22" r=".55">
        <stop offset="0" stop-color="#fff" stop-opacity=".55"/>
        <stop offset="1" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <rect width="520" height="320" rx="28" fill="url(#g)"/>
    <rect width="520" height="320" rx="28" fill="url(#r)"/>
    <circle cx="74" cy="70" r="42" fill="#fff" opacity=".15"/>
    <circle cx="448" cy="250" r="64" fill="#000" opacity=".08"/>
    <path d="M70 244 C150 180,210 280,304 204 S438 202,466 132" fill="none" stroke="#fff" stroke-width="4" opacity=".28"/>
    <text x="42" y="64" font-family="Microsoft YaHei, sans-serif" font-size="22" font-weight="700" fill="#fff" opacity=".86">${p.cat}</text>
    <text x="50%" y="52%" text-anchor="middle" dominant-baseline="middle" font-family="Microsoft YaHei, sans-serif" font-size="46" font-weight="800" fill="#fff">${initials}</text>
    <text x="50%" y="68%" text-anchor="middle" dominant-baseline="middle" font-family="Microsoft YaHei, sans-serif" font-size="18" fill="#fff" opacity=".86">${p.brand}</text>
  </svg>`;
  return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}

function getProductImage(p){
  return p && p.img ? p.img : getProductVisual(p);
}

function fallbackProductImage(img, id){
  const p = INSPIRE_PRODUCTS.find(x => x.id === id);
  if(!p || img.dataset.fallbackApplied === '1') return;
  img.dataset.fallbackApplied = '1';
  img.src = getProductVisual(p);
}

function renderInspireProducts(){
  const grid = document.getElementById('mkt-inspire-grid');
  if(!grid) return;
  const list = _inspireCurrentCat === 'all'
    ? INSPIRE_PRODUCTS
    : INSPIRE_PRODUCTS.filter(p => p.tags.includes(_inspireCurrentCat) || p.cat === _inspireCurrentCat);
  if(!list.length){
    grid.innerHTML = '<div class="mkt-inspire-empty">该分类暂无产品</div>';
    return;
  }
  grid.innerHTML = list.map(p => {
    const saved = _inspireSaved.includes(p.id) ? 'saved' : '';
    const savedText = _inspireSaved.includes(p.id) ? '★ 已收藏' : '☆ 收藏';
    return `
    <div class="mkt-product-card" onclick="openProductModal('${p.id}')">
      <span class="badge ${p.badge}">${p.badgeText}</span>
      <img class="mkt-product-img" src="${getProductImage(p)}" alt="${p.name}高清产品实拍图" loading="lazy"
           referrerpolicy="no-referrer" onerror="fallbackProductImage(this,'${p.id}')">
      <div class="mkt-product-body">
        <div class="mkt-product-name">${p.name}</div>
        <div class="mkt-product-brand">${p.brand}</div>
        <div class="mkt-product-tags">${p.tags.map(t=>`<span class="mkt-product-tag">${t}</span>`).join('')}</div>
        <div class="mkt-product-desc">${p.desc}</div>
        <div class="mkt-product-footer">
          <span class="mkt-product-price">¥${p.price}<small>起</small></span>
          <span class="mkt-product-sales">月销 ${p.sales}</span>
        </div>
        <button class="mkt-inspire-btn ${saved}" onclick="event.stopPropagation();toggleSaveProductById('${p.id}',this)">${savedText}</button>
      </div>
    </div>`;
  }).join('');
}

function filterInspireProducts(cat, btn){
  _inspireCurrentCat = cat;
  document.querySelectorAll('#mkt-inspire-filters .mkt-inspire-chip').forEach(c=>c.classList.remove('active'));
  if(btn) btn.classList.add('active');
  renderInspireProducts();
}

function openProductModal(id){
  const p = INSPIRE_PRODUCTS.find(x=>x.id===id);
  if(!p) return;
  _inspireCurrentProduct = p;
  const hero = document.getElementById('mpm-img');
  hero.dataset.fallbackApplied = '0';
  hero.src = getProductImage(p);
  hero.alt = p.name + '高清产品实拍图';
  hero.referrerPolicy = 'no-referrer';
  hero.onerror = function(){ fallbackProductImage(this, id); };
  document.getElementById('mpm-name').textContent = p.name;
  document.getElementById('mpm-brand').textContent = `${p.brand} · ${p.cat} · 月销 ${p.sales}`;
  document.getElementById('mpm-desc').textContent = p.desc;
  document.getElementById('mpm-design').textContent = p.design;
  document.getElementById('mpm-culture').textContent = p.culture;
  document.getElementById('mpm-audience').textContent = p.audience;
  document.getElementById('mpm-inspire-list').innerHTML = p.inspire.map(i=>`<li>${i}</li>`).join('');
  const saveBtn = document.getElementById('mpm-save-btn');
  if(_inspireSaved.includes(id)){ saveBtn.textContent='★ 已收藏'; saveBtn.classList.add('saved'); }
  else { saveBtn.textContent='☆ 收藏灵感'; saveBtn.classList.remove('saved'); }
  const modal = document.getElementById('mkt-product-modal');
  modal.classList.add('open');
  document.addEventListener('keydown', _escCloseProductModal);
}

function _escCloseProductModal(e){ if(e.key==='Escape') closeProductModal(e); }

function closeProductModal(e){
  if(e) e.preventDefault();
  document.getElementById('mkt-product-modal').classList.remove('open');
  document.removeEventListener('keydown', _escCloseProductModal);
  _inspireCurrentProduct = null;
}

function toggleSaveProduct(){
  if(!_inspireCurrentProduct) return;
  toggleSaveProductById(_inspireCurrentProduct.id, document.getElementById('mpm-save-btn'));
  renderInspireProducts();
}

function toggleSaveProductById(id, btn){
  const idx = _inspireSaved.indexOf(id);
  if(idx>=0){
    _inspireSaved.splice(idx,1);
    if(btn){ btn.textContent='☆ 收藏灵感'; btn.classList.remove('saved'); }
  } else {
    _inspireSaved.push(id);
    if(btn){ btn.textContent='★ 已收藏'; btn.classList.add('saved'); }
  }
  localStorage.setItem('inspire_saved', JSON.stringify(_inspireSaved));
}

function useProductInspiration(){
  if(!_inspireCurrentProduct) return;
  const p = _inspireCurrentProduct;
  // 填充营销表单
  const dest = document.getElementById('mkt-destination');
  const extra = document.getElementById('mkt-extra');
  const typeSel = document.getElementById('mkt-type');
  const goal = document.getElementById('mkt-business-goal');
  const pl = document.getElementById('mkt-product-line');
  if(dest && !dest.value) dest.value = p.brand;
  if(extra) extra.value = p.tags.join('、') + '；' + p.inspire[0];
  if(typeSel) typeSel.value = 'product';
  if(goal && !goal.value) goal.value = `推广${p.name}，提升文创产品曝光与转化`;
  if(pl && !pl.value) pl.value = p.name;
  closeProductModal(event);
  // 滚动到表单
  document.querySelector('.mkt-form-panel').scrollTo({top:0,behavior:'smooth'});
  // 视觉反馈
  const btn = document.querySelector('.mkt-generate-btn');
  if(btn){
    btn.style.animation = 'none';
    btn.offsetHeight;
    btn.style.animation = 'pulse 0.6s ease';
  }
  showToast('已提取灵感填充到营销表单，点击「生成内容」即可生成文案');
}

// ===== MARKETING =====
async function generateMarketing() {
  const crowd = document.getElementById('mkt-crowd').value;
  const type = document.getElementById('mkt-type').value;
  const tone = document.getElementById('mkt-tone').value;
  const destination = document.getElementById('mkt-destination').value;
  const extra = document.getElementById('mkt-extra').value;
  const businessGoal = document.getElementById('mkt-business-goal').value;
  const productLine = document.getElementById('mkt-product-line').value;
  const conversionTarget = document.getElementById('mkt-conversion-target').value;
  const channels = document.getElementById('mkt-channels').value;

  if (!destination && !extra) { alert('请输入目的地或补充说明'); return; }

  const previewEl = document.getElementById('mkt-preview');
  const actionsEl = document.getElementById('mkt-actions');
  previewEl.textContent = '生成中...';
  previewEl.classList.remove('empty');
  actionsEl.style.display = 'none';

  try {
    const resp = await fetch(BACKEND + '/api/marketing', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        destination: destination,
        type: type,
        crowd: crowd,
        tone: tone,
        extra: extra,
        business_goal: businessGoal,
        product_line: productLine,
        conversion_target: conversionTarget,
        channels: channels,
        stream: true
      })
    });

    if (!resp.ok) throw new Error('HTTP ' + resp.status);

    const reader = resp.body.getReader();
    const decoder = new TextDecoder();
    let content = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      const chunk = decoder.decode(value, { stream: true });
      const lines = chunk.split('\n');
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const data = line.slice(6);
          if (data === '[DONE]') break;
          try {
            const json = JSON.parse(data);
            if (json.content) {
              content += json.content;
              previewEl.textContent = content;
              previewEl.scrollTop = previewEl.scrollHeight;
            }
          } catch(e) {
            // 忽略 SSE 流中的单行 JSON 解析错误
          }
        }
      }
    }

    // Show actions after generation
    actionsEl.style.display = 'flex';

    // Save to history
    saveMktHistory(destination, type, content);

  } catch(e) {
    previewEl.textContent = '⚠️ 生成失败: ' + e.message;
    previewEl.classList.add('empty');
  }
}

function saveMktHistory(destination, type, content) {
  var list = document.getElementById('mkt-history-list');
  var noHist = list.querySelector('div[style]');
  if (noHist) noHist.remove();

  var typeMap = { social: '社交媒体', article: '公众号', video_script: '短视频', poster: '海报', event: '活动', product: '文创' };
  var item = document.createElement('div');
  item.className = 'mkt-history-item';
  item.textContent = typeMap[type] + ' · ' + destination;
  item.onclick = function() {
    document.getElementById('mkt-preview').textContent = content;
    document.getElementById('mkt-preview').classList.remove('empty');
    document.getElementById('mkt-actions').style.display = 'flex';
  };
  list.insertBefore(item, list.firstChild);
}

function copyMarketing() {
  const text = document.getElementById('mkt-preview').textContent;
  if (!text || text === '生成的内容将在这里展示') return;
  navigator.clipboard.writeText(text).then(() => {
    const btn = event.target;
    const orig = btn.textContent;
    btn.textContent = '✓ 已复制';
    setTimeout(() => { btn.textContent = orig; }, 2000);
  });
}

function regenerateMarketing() {
  generateMarketing();
}

// ===== SETTINGS =====
function toggleSettings() {
  document.getElementById('settings-overlay').classList.toggle('open');
}

async function saveSettings() {
  var apiKey = document.getElementById('api-key').value;
  var provider = document.getElementById('provider').value;
  // 本地模型(Ollama)不需要真实 API Key
  if (provider === 'ollama') {
    apiKey = 'ollama';  // 占位，后端 accept 任意值
  }
  if (apiKey || provider === 'ollama') {
    try {
      await fetch(BACKEND + '/api/config', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          api_key: apiKey,
          provider: provider
        })
      });
      if (provider === 'ollama') {
        showToast('🤖 已切换至本地模型 (Ollama)', 'success');
      }
    } catch(e) {
      console.error('保存配置失败:', e);
      showToast('配置保存失败，请稍后重试', 'warning');
    }
  }
  setStatus('已配置', 'oklch(0.62 0.14 175)');
  toggleSettings();
}

async function loadConfig() {
  try {
    var r = await fetch(BACKEND + '/api/config');
    var c = await r.json();
    if (c.has_key) {
      document.getElementById('api-key').value = '••••••••••••••••';
      setStatus('已配置', 'oklch(0.62 0.14 175)');
    }
    if (c.provider) document.getElementById('provider').value = c.provider;
    // 动态加载 provider 选项（支持云端 + 本地）
    if (c.providers) {
      var sel = document.getElementById('provider');
      sel.innerHTML = '';
      Object.keys(c.providers).forEach(function(key) {
        var p = c.providers[key];
        var opt = document.createElement('option');
        opt.value = key;
        opt.textContent = p.name;
        if (key === c.provider) opt.selected = true;
        sel.appendChild(opt);
      });
    }
  } catch(e) {
    console.error('加载配置失败:', e);
    setStatus('未连接后端', '#868e96');
  }
}

