function getTrainingState() {
  try { return JSON.parse(localStorage.getItem('sm_training') || '{}'); } catch(e) { return {}; }
}
function saveTrainingState(state) {
  localStorage.setItem('sm_training', JSON.stringify(state));
}

function initTrainingPage() {
  const activeMajor = document.querySelector('.major-card.active');
  const major = activeMajor ? activeMajor.dataset.major : 'tourism';

  // 技能数据加载失败处理
  if (!TRAINING_DATA || !TRAINING_DATA[major]) {
    console.warn('实训数据加载失败：专业方向 [' + major + '] 不存在');
    var stageList = document.getElementById('stage-list');
    if (stageList) {
      stageList.innerHTML = '<div class="empty-state" style="padding:48px"><div class="es-icon">⚠️</div><div class="es-title">实训数据加载失败</div><div class="es-desc">请检查网络连接后刷新页面重试</div></div>';
    }
    return;
  }

  renderTrainingContent(major);
  updateProgress(major);
  checkReportButton(major);
  
  // Bind major card clicks
  document.querySelectorAll('.major-card').forEach(card => {
    card.onclick = function() {
      document.querySelectorAll('.major-card').forEach(c => c.classList.remove('active'));
      this.classList.add('active');
      const m = this.dataset.major;
      renderTrainingContent(m);
      updateProgress(m);
      checkReportButton(m);
    };
  });
}

function renderTrainingContent(major) {
  const data = TRAINING_DATA[major];
  if (!data) return;
  
  document.getElementById('training-title').textContent = data.name + '实训';
  document.getElementById('training-sub').textContent = data.sub;
  
  const state = getTrainingState();
  const stageList = document.getElementById('stage-list');
  let html = '';
  
  data.stages.forEach((stage, si) => {
    const allDone = stage.tasks.every(t => state[t.id]);
    const doneCount = stage.tasks.filter(t => state[t.id]).length;
    html += '<div class="training-stage' + (allDone ? ' completed' : '') + '" data-stage="' + stage.id + '">';
    html += '<div class="stage-header" onclick="toggleStage(this)">';
    html += '<div class="stage-header-left">';
    html += '<div class="stage-num">' + (allDone ? '✓' : (si + 1)) + '</div>';
    html += '<div class="stage-title-wrap"><div class="stage-title">' + stage.title + '</div>';
    html += '<div class="stage-desc">' + stage.desc + '</div></div>';
    html += '</div>';
    if (allDone) {
      html += '<div class="stage-badge">✓ 已完成</div>';
    } else if (doneCount > 0) {
      html += '<div class="stage-badge active-task">' + doneCount + '/' + stage.tasks.length + ' 进行中</div>';
    } else {
      html += '<div class="stage-badge pending">待开始</div>';
    }
    html += '<div class="stage-arrow">▾</div>';
    html += '</div>';
    html += '<div class="stage-tasks"><!-- default collapsed -->';
    stage.tasks.forEach(task => {
      const done = state[task.id];
      html += '<div class="task-item' + (done ? ' completed' : '') + '" data-task="' + task.id + '">';
      html += '<div class="task-check" onclick="toggleTask(\'' + task.id + '\', \'' + major + '\')">✓</div>';
      html += '<div class="task-info">';
      html += '<div class="task-name">' + (done ? '✓ ' : '') + task.name + '</div>';
      html += '<div class="task-desc">' + task.desc + '</div>';
      html += '<div class="task-actions">';
      if (task.action === 'chat') {
        html += '<button class="task-btn primary" onclick="goToChat(\'' + task.id + '\', \'' + escapeHtml(task.actionMsg) + '\')">💬 ' + task.actionText + '</button>';
      } else if (task.action === 'plan') {
        html += '<button class="task-btn primary" onclick="goToPlan(\'' + task.id + '\', \'' + major + '\')">🗺️ ' + task.actionText + '</button>';
      } else if (task.action === 'marketing') {
        html += '<button class="task-btn primary" onclick="goToMarketing(\'' + task.id + '\', \'' + major + '\')">✨ ' + task.actionText + '</button>';
      }
      if (!done) {
        html += '<button class="task-btn" onclick="toggleTask(\'' + task.id + '\', \'' + major + '\')">✓ 标记完成</button>';
      } else {
        html += '<button class="task-btn" onclick="toggleTask(\'' + task.id + '\', \'' + major + '\')">↩ 取消完成</button>';
      }
      html += '</div></div></div>';
    });
    html += '</div></div>';
  });
  
  stageList.innerHTML = html;
}

function toggleStage(header) {
  header.classList.toggle('open');
  const tasks = header.parentElement.querySelector('.stage-tasks');
  if (tasks) tasks.classList.toggle('open');
}

function toggleTask(taskId, major) {
  const state = getTrainingState();
  if (state[taskId]) {
    delete state[taskId];
  } else {
    state[taskId] = { completedAt: new Date().toISOString() };
  }
  saveTrainingState(state);
  renderTrainingContent(major);
  updateProgress(major);
  checkReportButton(major);
  // Re-bind major card clicks
  initTrainingPage();
}

function goToChat(taskId, msg) {
  switchPage('chat');
  setTimeout(() => {
    const input = document.getElementById('msg-input');
    if (input) { input.value = msg; triggerSend(); }
  }, 400);
}

function goToPlan(taskId, major) {
  const data = TRAINING_DATA[major];
  let task = null;
  if (data && data.stages) {
    for (const s of data.stages) {
      for (const t of s.tasks) {
        if (t.id === taskId) { task = t; break; }
      }
      if (task) break;
    }
  }
  switchPage('plan');
  if (task) {
    setTimeout(() => {
      const destEl = document.getElementById('plan-destination');
      const daysEl = document.getElementById('plan-days');
      const crowdEl = document.getElementById('plan-crowd');
      if (destEl && task.dest) destEl.value = task.dest;
      if (daysEl && task.days) daysEl.value = task.days;
      if (crowdEl && task.crowd) crowdEl.value = task.crowd;
      // Select style tags
      if (task.tags) {
        const tags = task.tags.split(',');
        document.querySelectorAll('#plan-style-tags .tag').forEach(tag => {
          if (tags.some(tt => tag.textContent.trim().includes(tt.trim()))) {
            tag.classList.add('selected');
          }
        });
      }
    }, 500);
  }
}

function goToMarketing(taskId, major) {
  const data = TRAINING_DATA[major];
  let task = null;
  if (data && data.stages) {
    for (const s of data.stages) {
      for (const t of s.tasks) {
        if (t.id === taskId) { task = t; break; }
      }
      if (task) break;
    }
  }
  switchPage('marketing');
  if (task) {
    setTimeout(() => {
      const typeEl = document.getElementById('mkt-type');
      const destEl = document.getElementById('mkt-destination');
      const crowdEl = document.getElementById('mkt-crowd');
      const sellingEl = document.getElementById('mkt-selling');
      if (typeEl && task.actionType) typeEl.value = task.actionType;
      if (destEl && task.actionDest) destEl.value = task.actionDest;
      if (crowdEl && task.actionCrowd) crowdEl.value = task.actionCrowd;
      if (sellingEl && task.actionSelling) sellingEl.value = task.actionSelling;
    }, 500);
  }
}

function updateProgress(major) {
  const data = TRAINING_DATA[major];
  if (!data) return;
  const state = getTrainingState();
  let total = 0;
  let done = 0;
  data.stages.forEach(s => {
    s.tasks.forEach(t => {
      total++;
      if (state[t.id]) done++;
    });
  });
  const pct = total > 0 ? Math.round(done / total * 100) : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-text').textContent = done + ' / ' + total + ' 已完成';
}

function checkReportButton(major) {
  const data = TRAINING_DATA[major];
  if (!data) return;
  const state = getTrainingState();
  let total = 0, done = 0;
  data.stages.forEach(s => s.tasks.forEach(t => { total++; if (state[t.id]) done++; }));
  const btn = document.getElementById('gen-report-btn');
  if (btn) btn.disabled = done === 0;
}

// escapeHtml 已在顶部定义，此处移除重复定义

function generateTrainingReport() {
  const activeMajor = document.querySelector('.major-card.active');
  const major = activeMajor ? activeMajor.dataset.major : 'tourism';
  const data = TRAINING_DATA[major];
  if (!data) return;
  const state = getTrainingState();
  
  let totalTasks = 0, completedTasks = 0;
  let stageReport = '';
  let tagHtml = '';
  
  data.stages.forEach((stage, si) => {
    const tasks = stage.tasks;
    const doneCount = tasks.filter(t => state[t.id]).length;
    totalTasks += tasks.length;
    completedTasks += doneCount;
    
    stageReport += '<div class="report-section"><h3>' + (si + 1) + '. ' + stage.title + '</h3>';
    tasks.forEach(t => {
      const done = !!state[t.id];
      stageReport += '<div class="report-row"><span class="rr-label">' + (done ? '✅' : '⬜') + ' ' + t.name + '</span>';
      stageReport += '<span class="rr-value">' + (done ? '已完成' : '未完成') + '</span></div>';
      if (done && state[t.id] && state[t.id].completedAt) {
        stageReport += '<div style="font-size:11px;color:var(--ink-subtle);padding-left:28px;margin-bottom:4px">完成时间：' + new Date(state[t.id].completedAt).toLocaleString('zh-CN') + '</div>';
      }
    });
    stageReport += '</div>';
  });
  
  const pct = totalTasks > 0 ? Math.round(completedTasks / totalTasks * 100) : 0;
  
  // Skills acquired tags
  const skillTags = [];
  if (major === 'tourism') {
    if (state['t1'] && state['t2'] && state['t3']) skillTags.push('导览规划能力');
    if (state['t4'] || state['t5'] || state['t6']) skillTags.push('行程设计能力');
    if (state['t7'] || state['t8']) skillTags.push('客群分析能力');
    if (state['t9']) skillTags.push('综合运营能力');
  } else if (major === 'digital') {
    if (state['d1'] || state['d2'] || state['d3']) skillTags.push('文案创作能力');
    if (state['d4'] || state['d5'] || state['d6']) skillTags.push('短视频策划能力');
    if (state['d7'] || state['d8']) skillTags.push('活动策划能力');
    if (state['d9']) skillTags.push('品牌全案能力');
  } else if (major === 'creative') {
    if (state['c1'] || state['c2'] || state['c3']) skillTags.push('文化分析能力');
    if (state['c4'] || state['c5'] || state['c6']) skillTags.push('文创设计能力');
    if (state['c7'] || state['c8']) skillTags.push('商业落地能力');
    if (state['c9']) skillTags.push('品牌孵化能力');
  }
  
  skillTags.forEach(t => { tagHtml += '<span class="report-tag done">' + t + '</span>'; });
  
  const remaining = totalTasks - completedTasks;
  if (remaining > 0) {
    tagHtml += '<span class="report-tag">' + remaining + ' 项待完成</span>';
  }
  
  const now = new Date().toLocaleString('zh-CN');
  const html = `
<div class="report-overlay" id="report-overlay" onclick="if(event.target===this)closeReport()">
  <div class="report-modal">
    <h2>📋 实训报告</h2>
    <div class="rm-sub">${data.name}专业 · ${data.icon} · 生成时间：${now}</div>
    
    <div class="report-section">
      <h3>📊 总体情况</h3>
      <div class="report-row"><span class="rr-label">专业方向</span><span class="rr-value">${data.name}</span></div>
      <div class="report-row"><span class="rr-label">总任务数</span><span class="rr-value">${totalTasks} 项</span></div>
      <div class="report-row"><span class="rr-label">已完成</span><span class="rr-value">${completedTasks} 项</span></div>
      <div class="report-row"><span class="rr-label">完成率</span><span class="rr-value">${pct}%</span></div>
    </div>
    
    ${skillTags.length > 0 ? '<div class="report-section"><h3>🏅 已掌握技能</h3><div class="report-tags">' + tagHtml + '</div></div>' : ''}
    
    <div class="report-section">
      <h3>📝 任务详情</h3>
      ${stageReport}
    </div>
    
    <div class="rm-actions">
      <button class="rm-btn rm-btn-cancel" onclick="closeReport()">关闭</button>
      <button class="rm-btn rm-btn-export" onclick="exportTrainingReport('${major}')">📥 导出报告</button>
    </div>
  </div>
</div>`;
  
  const existing = document.getElementById('report-overlay');
  if (existing) existing.remove();
  document.body.insertAdjacentHTML('beforeend', html);
}

function closeReport() {
  const overlay = document.getElementById('report-overlay');
  if (overlay) overlay.remove();
}

function exportTrainingReport(major) {
  const data = TRAINING_DATA[major];
  if (!data) return;
  const state = getTrainingState();
  let totalTasks = 0, completedTasks = 0;
  
  let md = '# 智旅灵犀 · 实训报告\n\n';
  md += '**专业方向**：' + data.name + '\n\n';
  md += '**生成时间**：' + new Date().toLocaleString('zh-CN') + '\n\n';
  md += '---\n\n';
  
  data.stages.forEach((stage, si) => {
    const doneCount = stage.tasks.filter(t => state[t.id]).length;
    totalTasks += stage.tasks.length;
    completedTasks += doneCount;
    
    md += '## ' + (si + 1) + '. ' + stage.title + '\n\n';
    md += '> ' + stage.desc + '  |  ' + doneCount + '/' + stage.tasks.length + ' 完成\n\n';
    stage.tasks.forEach(t => {
      const done = !!state[t.id];
      md += '- ' + (done ? '[x]' : '[ ]') + ' **' + t.name + '**：' + t.desc;
      if (done && state[t.id].completedAt) {
        md += ' _(完成于 ' + new Date(state[t.id].completedAt).toLocaleString('zh-CN') + ')_';
      }
      md += '\n';
    });
    md += '\n';
  });
  
  const pct = totalTasks > 0 ? Math.round(completedTasks / totalTasks * 100) : 0;
  md += '---\n\n';
  md += '## 总结\n\n';
  md += '- 总任务：' + totalTasks + ' 项\n';
  md += '- 已完成：' + completedTasks + ' 项\n';
  md += '- 完成率：' + pct + '%\n\n';
  md += '*本报告由智旅灵犀实训系统自动生成*\n';
  
  const blob = new Blob([md], {type: 'text/markdown;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = '实训报告_' + data.name + '_' + new Date().toISOString().slice(0,10) + '.md';
  a.click();
  URL.revokeObjectURL(url);
}

// Trigger send on chat
function triggerSend() {
  var input = document.getElementById('msg-input');
  var msg = input ? input.value : '';
  if (!msg || !msg.trim()) {
    showToast('请输入内容', 'warning');
    return;
  }
  var sendBtn = document.getElementById('send-btn');
  if (sendBtn) sendBtn.click();
}

// Export for testing
window.__st={knownLocations:()=>knownLocations,linkifyLocations,collectKnownLocations,bindLocLinkEvents,geocodeAndJump,detectAndRenderTickets,openTicket,closeTicket,submitOrder,loadProfile,addProfileItem,renderAllProfileLists, initTrainingPage, generateTrainingReport};
</script>
