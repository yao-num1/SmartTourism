<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>智旅灵犀 · SmartTourism</title>
<style>
/* ===== Design Tokens — 作品集级设计语言 ===== */
/* Hallmark · genre: atmospheric · theme: custom
 * vibe: "深夜探索，暖光引路，自然质感"
 * paper: oklch(8% 0.008 170) · accent: oklch(72% 0.16 75)
 * display: Noto Serif SC · body: Inter · axes: dark / roman-serif / chromatic-amber
 * v1.1.0
 */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&display=swap');

:root {
  --paper: oklch(9% 0.008 170);
  --paper-2: oklch(13% 0.010 170);
  --paper-3: oklch(18% 0.013 170);
  --paper-4: oklch(22% 0.015 170);
  --ink: oklch(95% 0.003 60);
  --ink-2: oklch(78% 0.010 60);
  --ink-subtle: oklch(64% 0.010 60);
  --rule: oklch(28% 0.012 170);
  --rule-2: oklch(24% 0.010 170);
  --rule-bright: oklch(38% 0.015 170);
  --accent: oklch(74% 0.16 75);
  --accent-2: oklch(80% 0.14 85);
  --accent-glow: oklch(72% 0.16 75 / 0.15);
  --accent-dim: oklch(72% 0.16 75 / 0.08);
  --success: oklch(70% 0.14 150);
  --danger: oklch(62% 0.16 25);
  --focus-ring: oklch(72% 0.16 75 / 0.12);
  --shadow-sm: 0 1px 3px oklch(0% 0 0 / 0.3);
  --shadow-md: 0 4px 16px oklch(0% 0 0 / 0.4);
  --shadow-lg: 0 12px 40px oklch(0% 0 0 / 0.5);
  --shadow-glow: 0 0 20px oklch(72% 0.16 75 / 0.12);
  --font-display: "Noto Serif SC", "Source Han Serif CN", "Songti SC", serif;
  --font-body: "Inter", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  --font-mono: "Geist Mono", "SF Mono", "Fira Code", monospace;
  --space-3xs: 0.25rem; --space-2xs: 0.5rem; --space-xs: 0.75rem;
  --space-sm: 1rem; --space-md: 1.5rem; --space-lg: 2rem; --space-xl: 3rem;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-short: 220ms;
  --radius-sharp: 2px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
}
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font-body);background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;display:flex;flex-direction:column}
/* === Scrollbar === */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--rule-bright);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--ink-subtle)}
/* === Top Nav === */
.top-nav{display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:56px;background:oklch(10% 0.004 200 / 0.98);border-bottom:1px solid var(--rule);z-index:100;flex-shrink:0;backdrop-filter:blur(12px)}
.nav-brand{display:flex;align-items:center;gap:10px}
.nav-logo{width:34px;height:34px;background:linear-gradient(135deg,var(--accent),oklch(60% 0.14 65));border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:16px;color:#1a1a1a;font-weight:700;box-shadow:0 0 16px oklch(0.54 0.12 175 / 0.3),var(--shadow-sm)}
.nav-title{font-size:17px;font-weight:600;letter-spacing:.04em;color:var(--accent)}
.nav-subtitle{font-size:10px;color:var(--ink-subtle);letter-spacing:.08em;margin-left:8px;opacity:.7;text-transform:uppercase;font-weight:500}
.nav-tabs{display:flex;gap:0;background:transparent;border-radius:0;padding:0}
.nav-tab{padding:8px 18px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;color:var(--ink-subtle);cursor:pointer;transition:all var(--dur-short) var(--ease-out);background:transparent;border:none;letter-spacing:.03em;position:relative}
.nav-tab:hover{color:var(--ink-2);background:var(--paper-2)}
.nav-tab.active{color:var(--accent);font-weight:600}
.nav-tab.active::after{content:'';position:absolute;bottom:-1px;left:50%;transform:translateX(-50%);width:60%;height:2px;background:var(--accent);border-radius:2px;box-shadow:0 0 8px var(--accent-glow)}
.nav-status{display:flex;align-items:center;gap:8px}
.nav-status-dot{width:7px;height:7px;border-radius:50%;transition:all var(--dur-short) var(--ease-out)}
.nav-status-dot{background:var(--success);box-shadow:0 0 8px var(--success)}
.nav-status-dot.busy{background:var(--accent-2);box-shadow:0 0 10px var(--accent-2);animation:pulse-dot 1.2s infinite}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(0.8)}}
.nav-status-text{font-size:12px;color:var(--ink-2);font-weight:400}
.nav-settings-btn{background:none;border:1px solid var(--rule);color:var(--ink-2);width:36px;height:36px;border-radius:var(--radius-sm);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all var(--dur-short) var(--ease-out)}
.nav-settings-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
/* Pages */
.pages-container{flex:1;position:relative;min-height:0;overflow:visible}
.page{position:absolute;inset:0;display:none;opacity:0;pointer-events:none;transition:opacity 350ms cubic-bezier(0.4,0,0.2,1),transform 350ms cubic-bezier(0.4,0,0.2,1);transform:translateY(12px);overflow-y:auto;overflow-x:hidden}
.page.active{display:block;opacity:1;pointer-events:auto;transform:translateY(0)}
/* HOME */
.page-home{display:flex;flex-direction:column;padding:0;overflow-y:auto;overflow-x:hidden}
.hero{position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;padding:48px 72px;min-height:100%;background:url('bg.jpg') center top/cover no-repeat}
.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,oklch(9% 0.008 170 / 0.82) 0%,oklch(9% 0.008 170 / 0.65) 50%,oklch(9% 0.008 170 / 0.85) 100%);z-index:1}
.hero::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 30%,oklch(0.74 0.14 95 / 0.08) 0%,transparent 50%);z-index:2}
.hero-content{position:relative;z-index:10;display:flex;flex-direction:column;gap:0;max-width:680px;margin:0 auto;text-align:center}
.hero-brand{font-family:var(--font-display);font-size:clamp(2.5rem,5vw,3.75rem);font-weight:600;letter-spacing:.02em;color:var(--ink);line-height:1.15}
.hero-tagline{font-size:16px;color:var(--ink-2);font-weight:400;letter-spacing:.04em;line-height:1.6;margin-top:12px}
.hero-search-wrap{margin-top:32px;display:flex;flex-direction:column;gap:12px;align-items:center}
.hero-search{display:flex;gap:8px;width:100%;max-width:520px;padding:6px;border:1px solid var(--rule-bright);border-radius:var(--radius-lg);background:oklch(12% 0.010 170 / 0.8);backdrop-filter:blur(12px);box-shadow:var(--shadow-md)}
.hero-search input{flex:1;padding:12px 16px;border:none;border-radius:var(--radius-md);background:transparent;color:var(--ink);font-size:14px;font-family:var(--font-body);outline:none}
.hero-search input::placeholder{color:var(--ink-subtle)}
.hero-search button{padding:12px 28px;background:var(--accent);color:#1a1a1a;border:none;border-radius:var(--radius-md);font-size:14px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);white-space:nowrap}
.hero-search button:hover{background:var(--accent-2);box-shadow:var(--shadow-glow)}
.hero-quick-tags{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.hero-quick-tag{padding:5px 14px;border:1px solid var(--rule);border-radius:20px;font-size:12px;color:var(--ink-subtle);cursor:pointer;transition:all var(--dur-short) var(--ease-out);background:oklch(12% 0.010 170 / 0.6);font-family:var(--font-body)}
.hero-quick-tag:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.hero-features{position:relative;z-index:10;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px;max-width:760px;margin-left:auto;margin-right:auto}
.hero-nav-card{padding:24px 20px;border:1px solid var(--rule);border-radius:var(--radius-md);background:oklch(12% 0.010 170 / 0.5);cursor:pointer;transition:all var(--dur-short) var(--ease-out);display:flex;flex-direction:column;gap:8px;text-align:left;backdrop-filter:blur(8px);text-decoration:none}
.hero-nav-card:hover{border-color:var(--accent);background:oklch(15% 0.012 95 / 0.15);transform:translateY(-3px);box-shadow:var(--shadow-md),var(--shadow-glow)}
.hero-nav-card .hni{font-size:28px;margin-bottom:4px;transition:transform var(--dur-short) var(--ease-out)}
.hero-nav-card:hover .hni{transform:scale(1.1)}
.hero-nav-card .hnl{font-size:15px;color:var(--ink);font-weight:600;letter-spacing:.03em}
.hero-nav-card .hnd{font-size:12px;color:var(--ink-subtle);line-height:1.5;font-weight:400}
/* CHAT */
.page-chat{display:flex;flex-direction:column;overflow:hidden}
.chat-layout{display:flex;flex:1;min-height:0;height:100%;gap:0;overflow:hidden}
.chat-left{flex:1;display:flex;flex-direction:column;min-width:0;max-width:100%;min-height:0;height:100%;overflow:hidden}
.location-bar,.quick-chips{flex-shrink:0}
.quick-chips{display:flex;gap:8px;padding:12px 16px;flex-wrap:wrap;border-bottom:1px solid var(--rule);background:var(--paper-2)}
.chip{padding:7px 16px;border-radius:20px;border:1px solid var(--rule);background:var(--paper);color:var(--ink-2);font-size:12px;cursor:pointer;transition:all var(--dur-short) var(--ease-out);font-family:var(--font-body);letter-spacing:.03em;font-weight:500}
.chip:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim);transform:translateY(-1px)}
.chat-messages{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:20px;display:flex;flex-direction:column;gap:14px}
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--ink-subtle);gap:18px;text-align:center}
.empty-state .es-icon{font-size:48px;opacity:.4}
.empty-state .es-title{font-size:18px;font-weight:600;color:var(--ink-2);letter-spacing:.03em}
.empty-state .es-desc{font-size:14px;max-width:340px;line-height:1.7;font-weight:400;color:var(--ink-subtle)}
.msg{display:flex;flex-direction:column;max-width:85%;animation:msgIn 300ms cubic-bezier(0.4,0,0.2,1)}
@keyframes msgIn{from{opacity:0;transform:translateY(10px)}}
.msg.user{align-self:flex-end}
.msg.agent{align-self:flex-start}
.msg .bubble{padding:14px 18px;border-radius:var(--radius-md);font-size:14px;line-height:1.75;letter-spacing:.02em}
.msg.user .bubble{background:var(--accent);color:#1a1a1a;border-radius:var(--radius-md) var(--radius-md) 4px var(--radius-md);box-shadow:var(--shadow-sm)}
.msg.agent .bubble{background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md) var(--radius-md) var(--radius-md) 4px;color:var(--ink)}
.msg .bubble h3{font-size:16px;margin:12px 0 6px;color:var(--accent-2);font-weight:600;letter-spacing:.02em;border-bottom:1px solid oklch(0.28 0.04 95 / 0.12);padding-bottom:4px}
.msg .bubble h2{font-size:17px;margin:12px 0 6px;color:var(--ink);font-weight:600}
.msg .bubble h1{font-size:18px;margin:12px 0 6px;font-weight:600}
.msg .bubble p{margin:6px 0}
.msg .bubble ul,.msg .bubble ol{padding-left:22px;margin:8px 0}
.msg .bubble ul{list-style:none}
.msg .bubble ul>li{margin:4px 0;position:relative}
.msg .bubble ul>li::before{content:'•';position:absolute;left:-16px;color:var(--accent-2);font-weight:bold}
.msg .bubble ol{list-style:decimal}
.msg .bubble ol>li{margin:4px 0}
.msg .bubble li{margin:3px 0;position:relative}
.msg .bubble code{font-size:12px;background:oklch(0.22 0.005 200);padding:2px 6px;border-radius:4px;color:var(--accent-2);font-family:'SF Mono',monospace}
.msg .bubble strong{font-weight:600;color:var(--ink)}
.msg .bubble em{color:var(--ink-subtle)}
/* ========== 对话内位置卡片（横向排列） ========== */
.loc-cards-row{display:flex;gap:10px;overflow-x:auto;padding:8px 0 4px;scrollbar-width:thin;-webkit-overflow-scrolling:touch}
.loc-cards-row::-webkit-scrollbar{height:4px}
.loc-cards-row::-webkit-scrollbar-thumb{background:oklch(0.28 0.04 95 / 0.2);border-radius:2px}
.loc-card{flex-shrink:0;width:150px;border:1px solid var(--rule);border-radius:var(--radius-sm);overflow:hidden;background:var(--paper-3);transition:box-shadow var(--dur-short) var(--ease-out),transform var(--dur-short) var(--ease-out)}
.loc-card:hover{box-shadow:var(--shadow-sm);transform:translateY(-2px)}
.loc-card-img{width:100%;height:84px;object-fit:cover;display:block;background:var(--paper-2);border-bottom:1px solid var(--rule)}
.loc-card-info{padding:6px 10px 4px}
.loc-card-name{font-size:13px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px}
.loc-card-badge{display:inline-block;font-size:10px;padding:1px 8px;border-radius:999px;font-weight:500;letter-spacing:.02em}
.badge-scenic{background:oklch(0.20 0.04 145 / 0.15);color:var(--accent-2)}
.badge-hotel{background:oklch(0.20 0.04 260 / 0.15);color:oklch(0.55 0.08 260)}
.badge-food{background:oklch(0.20 0.05 35 / 0.15);color:oklch(0.58 0.10 35)}
.loc-card-nav{display:block;width:100%;padding:5px 0;border:none;background:var(--paper-4);color:var(--accent-2);font-size:12px;font-weight:500;cursor:pointer;transition:background var(--dur-short),color var(--dur-short);text-align:center}
.loc-card-nav:hover{background:var(--accent);color:#fff}
/* ========== 思考过程面板 (DeepSeek 风格) ========== */
.thinking-panel{margin-bottom:8px;border:1px solid oklch(0.28 0.04 95 / 0.2);border-radius:var(--radius-sm);background:oklch(0.16 0.01 95 / 0.08);overflow:hidden;transition:all var(--dur-short) var(--ease-out);font-size:13px}
.thinking-panel.collapsed .thinking-body{display:none}
.thinking-header{display:flex;align-items:center;gap:8px;padding:8px 14px;cursor:pointer;user-select:none;background:oklch(0.18 0.02 95 / 0.12);border-bottom:1px solid oklch(0.28 0.04 95 / 0.15);transition:background var(--dur-short)}
.thinking-header:hover{background:oklch(0.20 0.03 95 / 0.18)}
.thinking-icon{font-size:15px;flex-shrink:0}
.thinking-title{font-weight:500;color:var(--accent-2);font-size:12px;letter-spacing:.03em}
.thinking-status-text{flex:1;font-size:11px;color:var(--ink-subtle);opacity:0.8}
.thinking-toggle{font-size:11px;color:var(--ink-subtle);transition:transform var(--dur-short)}
.thinking-body{max-height:280px;overflow-y:auto;padding:10px 14px}
.thinking-content{font-size:12.5px;line-height:1.8;color:var(--ink-subtle);white-space:pre-wrap;word-break:break-word;font-family:var(--font-body)}
/* Ticket Cards */
.ticket-reco{display:flex;gap:12px;margin:10px 0 4px;padding:14px 16px;background:linear-gradient(135deg,oklch(0.16 0.014 95 / 0.15),oklch(0.13 0.008 200 / 0.6));border:1px solid oklch(0.28 0.04 95 / 0.25);border-radius:var(--radius-sm);align-items:center;cursor:pointer;transition:all var(--dur-short) var(--ease-out);flex-wrap:wrap}
.ticket-reco:hover{border-color:var(--accent-2);transform:translateY(-2px);box-shadow:0 6px 24px oklch(0.74 0.14 95 / 0.1)}
.ticket-reco-icon{font-size:28px;flex-shrink:0}
.ticket-reco-info{flex:1;min-width:140px}
.ticket-reco-name{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:2px}
.ticket-reco-meta{font-size:12px;color:var(--ink-subtle);display:flex;gap:8px;align-items:center}
.ticket-reco-tag{display:inline-block;font-size:10px;padding:1px 8px;border-radius:var(--radius-sm);background:oklch(0.22 0.06 85 / 0.18);color:var(--accent-2);font-weight:500}
.ticket-reco-price .tp-cur{font-size:22px;font-weight:600;color:var(--accent-2);line-height:1}
.ticket-reco-price .tp-orig{font-size:12px;color:var(--ink-subtle);text-decoration:line-through}
.ticket-reco-btn{padding:8px 20px;background:var(--accent-2);color:#000;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);white-space:nowrap;letter-spacing:.02em}
.ticket-reco-btn:hover{background:oklch(0.88 0.18 85);transform:scale(1.04);box-shadow:0 0 20px oklch(0.74 0.14 95 / 0.3)}
.ticket-reco-btn.sold-out{background:var(--ink-subtle);color:var(--ink-subtle);cursor:not-allowed}
/* Modal */
.ticket-overlay{position:fixed;inset:0;background:oklch(0 0 0 / 0.65);z-index:1000;display:flex;align-items:center;justify-content:center;animation:fadeIn 200ms ease}
@keyframes fadeIn{from{opacity:0}}
.ticket-modal{background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:var(--radius-md);padding:28px 32px;width:420px;max-width:92vw;max-height:85vh;overflow-y:auto;animation:slideUpIn 300ms cubic-bezier(0.4,0,0.2,1);box-shadow:0 20px 60px rgba(0,0,0,0.6)}
@keyframes slideUpIn{from{transform:translateY(30px);opacity:0}}
.ticket-modal h3{font-size:18px;font-weight:600;color:var(--ink);margin-bottom:4px;letter-spacing:.02em}
.ticket-modal .tm-sub{font-size:13px;color:var(--ink-subtle);margin-bottom:20px}
.ticket-modal label{display:block;font-size:11px;color:var(--ink-subtle);margin-bottom:6px;margin-top:14px;letter-spacing:.05em;text-transform:uppercase;font-weight:500}
.ticket-modal select,.ticket-modal input{width:100%;padding:10px 14px;border:1px solid var(--rule);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font-size:14px;font-family:var(--font-body);outline:none;transition:all var(--dur-short) var(--ease-out)}
.ticket-modal select:focus,.ticket-modal input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--focus-ring)}
.ticket-modal .tm-total{display:flex;justify-content:space-between;align-items:center;margin-top:20px;padding-top:16px;border-top:1px solid var(--rule)}
.ticket-modal .tm-total-label{font-size:14px;color:var(--ink-subtle)}
.ticket-modal .tm-total-price{font-size:28px;font-weight:700;color:var(--accent-2)}
.ticket-modal .tm-actions{display:flex;gap:10px;margin-top:20px}
.ticket-modal .tm-actions button{flex:1;padding:12px;border-radius:var(--radius-sm);font-size:14px;font-weight:500;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);border:none}
.tm-btn-cancel{background:var(--paper-2);color:var(--ink-subtle)}
.tm-btn-cancel:hover{background:var(--paper-3);color:var(--ink)}
.tm-btn-buy{background:var(--accent-2);color:#000;font-weight:600;letter-spacing:.03em}
.tm-btn-buy:hover{background:oklch(0.88 0.18 85);box-shadow:0 0 24px oklch(0.74 0.14 95 / 0.3)}
.ticket-success{text-align:center;padding:24px 0}
.ticket-success .ts-icon{font-size:52px;margin-bottom:12px}
.ticket-success .ts-msg{font-size:16px;color:var(--ink);font-weight:600;margin-bottom:4px}
.ticket-success .ts-order{font-size:13px;color:var(--ink-subtle);margin-bottom:8px}
.ticket-success .ts-price{font-size:30px;font-weight:700;color:var(--accent-2)}
/* Buttons & Input */
.typing-indicator{display:flex;gap:5px;padding:6px 4px}
.typing-indicator span{width:6px;height:6px;border-radius:50%;background:var(--ink-subtle);animation:typing 1.4s infinite ease-in-out}
.typing-indicator span:nth-child(2){animation-delay:0.2s}
.typing-indicator span:nth-child(3){animation-delay:0.4s}
@keyframes typing{0%,60%,100%{opacity:.15;transform:scale(.7)}30%{opacity:1;transform:scale(1)}}
.chat-input-area{flex-shrink:0;position:sticky;bottom:0;z-index:20;padding:14px 18px;border-top:1px solid var(--rule);background:var(--paper-2)}
.input-row{display:flex;gap:10px;align-items:flex-end}
.mic-btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--rule);background:var(--paper-3);color:var(--ink-2);font-size:16px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all var(--dur-short) var(--ease-out)}
.mic-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.mic-btn.listening{background:var(--danger);color:#fff;border-color:var(--danger);animation:mic-pulse 1.2s infinite}
@keyframes mic-pulse{0%,100%{box-shadow:0 0 0 0 oklch(62% 0.16 25 / 0.45)}50%{box-shadow:0 0 0 10px oklch(62% 0.16 25 / 0)}}
#msg-input{flex:1;padding:12px 16px;border:1px solid var(--rule);border-radius:var(--radius-md);background:var(--paper);color:var(--ink);font-size:14px;font-family:var(--font-body);resize:none;transition:all var(--dur-short) var(--ease-out);line-height:1.5}
#msg-input::placeholder{color:var(--ink-subtle)}
#msg-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--focus-ring);outline:none}
.btn{padding:10px 20px;border-radius:var(--radius-sm);border:none;font-size:14px;font-weight:500;cursor:pointer;transition:all var(--dur-short) var(--ease-out);font-family:var(--font-body);letter-spacing:.03em;white-space:nowrap}
.btn-primary{background:var(--accent);color:#1a1a1a;font-weight:600}
.btn-primary:hover{background:var(--accent-2);box-shadow:var(--shadow-glow)}
.btn-primary:active{transform:scale(.96)}
.btn-secondary{background:transparent;color:var(--ink-2);border:1px solid var(--rule)}
.btn-secondary:hover{background:var(--paper-3);color:var(--ink);border-color:var(--rule-bright)}
.btn-accent{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.btn-accent:hover{background:oklch(0.20 0.02 95 / 0.15);border-color:var(--accent-2);color:var(--accent-2)}
.btn-sm{padding:6px 14px;font-size:12px;border-radius:6px}
.map-btn{padding:7px 12px;border:1px solid oklch(0.22 0.008 200 / 0.8);background:oklch(0.12 0.006 200 / 0.85);color:var(--ink-subtle);border-radius:var(--radius-sm);cursor:pointer;font-size:12px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);text-align:center;font-weight:500}
.map-btn:hover{background:var(--paper-3);border-color:var(--rule-bright);color:var(--ink)}
/* PLAN */
.page-plan{display:flex;flex-direction:column}
.plan-layout{display:flex;flex:1;min-height:0}
.plan-sidebar{width:280px;flex-shrink:0;border-right:1px solid var(--rule);padding:22px;display:flex;flex-direction:column;gap:18px;overflow-y:auto;background:var(--paper-2)}
.sidebar-section h3{font-size:12px;font-weight:600;color:var(--ink-subtle);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
.field{margin-bottom:12px}
.field label{display:block;font-size:11px;color:var(--ink-subtle);margin-bottom:5px;letter-spacing:.04em;font-weight:500;text-transform:uppercase}
.field input,.field select{width:100%;padding:9px 12px;border:1px solid var(--rule);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font-size:13px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.field input:focus,.field select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--focus-ring);outline:none}
.field input::placeholder{color:var(--ink-subtle)}
.tag-row{display:flex;flex-wrap:wrap;gap:6px}
.tag{padding:5px 12px;border:1px solid var(--rule);border-radius:14px;font-size:11px;color:var(--ink-2);cursor:pointer;transition:all var(--dur-short) var(--ease-out);background:transparent;font-family:var(--font-body);letter-spacing:.03em;user-select:none;font-weight:500}
.tag:hover{border-color:var(--rule-bright);color:var(--ink);background:var(--paper-3)}
.tag.selected{border-color:var(--accent);background:var(--accent-dim);color:var(--accent);font-weight:600}
.plan-plan-btn{width:100%;padding:12px;background:var(--accent);color:#1a1a1a;border:none;border-radius:var(--radius-sm);font-size:15px;font-weight:600;cursor:pointer;letter-spacing:.04em;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.plan-plan-btn:hover{background:var(--accent-2);box-shadow:var(--shadow-glow);transform:translateY(-1px)}
.plan-timeline{flex:1;padding:28px 24px;overflow-y:auto;min-width:0}
.plan-timeline::-webkit-scrollbar{width:4px}
.plan-timeline::-webkit-scrollbar-thumb{background:var(--rule-bright);border-radius:2px}
.plan-streaming{padding:24px;text-align:center;color:var(--ink-subtle);font-size:14px;letter-spacing:.03em;font-weight:400}
.plan-stream-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent-glow);animation:pulse 800ms infinite;margin-right:8px;vertical-align:middle}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(0.8)}}
.plan-content{font-size:15px;line-height:1.85;color:var(--ink);letter-spacing:.02em}
.plan-content h2{font-size:22px;font-weight:600;color:var(--accent-2);margin:24px 0 14px;letter-spacing:.03em}
.plan-content h3{font-size:18px;font-weight:600;color:var(--ink);margin:18px 0 10px;letter-spacing:.02em}
.plan-content h4{font-size:15px;font-weight:500;color:var(--ink-subtle);margin:14px 0 8px}
.plan-content p{margin:10px 0}
.plan-content li{margin:5px 0 5px 22px}
.plan-content table{width:100%;border-collapse:collapse;margin:14px 0;font-size:13px;border-radius:var(--radius-sm);overflow:hidden}
.plan-content td,.plan-content th{padding:10px 14px;border:1px solid var(--rule);text-align:left}
.plan-content th{background:var(--paper-3);font-weight:600;color:var(--accent-2);font-size:12px;text-transform:uppercase;letter-spacing:.04em}
.timeline-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.timeline-title{font-size:20px;font-weight:300;letter-spacing:.04em}
.timeline-actions{display:flex;gap:8px}
.day-card{margin-bottom:24px;position:relative;padding-left:28px}
.day-card::before{content:'';position:absolute;left:7px;top:32px;bottom:-24px;width:1px;background:linear-gradient(to bottom,var(--rule-bright),transparent)}
.day-card:last-child::before{display:none}
.day-dot{position:absolute;left:0;top:4px;width:15px;height:15px;border-radius:50%;background:var(--accent);border:2px solid var(--paper);box-shadow:0 0 12px oklch(0.52 0.10 175 / 0.4)}
.day-label{font-size:15px;font-weight:500;color:var(--accent-2);margin-bottom:10px;letter-spacing:.04em}
.activity-item{padding:12px 14px;margin:8px 0;background:var(--paper-2);border:1px solid var(--rule);border-radius:var(--radius-sm);display:flex;gap:12px;align-items:flex-start;transition:all var(--dur-short) var(--ease-out)}
.activity-item:hover{border-color:var(--rule-bright)}
.act-icon{font-size:20px;flex-shrink:0;margin-top:2px}
.act-info{flex:1;min-width:0}
.act-time{font-size:11px;color:var(--ink-subtle);letter-spacing:.04em}
.act-name{font-size:14px;font-weight:500;color:var(--ink);margin:2px 0}
.act-type{font-size:11px;color:var(--ink-subtle)}
.activity-img{width:64px;height:48px;border-radius:6px;object-fit:cover;flex-shrink:0;background:var(--paper-2);border:1px solid var(--rule)}
.plan-map{width:360px;flex-shrink:0;border-left:1px solid var(--rule);position:relative}
#plan-map-container{width:100%;height:100%}
.plan-map-controls{position:absolute;bottom:16px;right:12px;z-index:100;display:flex;flex-direction:column;gap:6px}
/* Plan Route Summary */
.plan-route-summary{margin-top:20px;padding:18px 20px;background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md);animation:slideUpIn 350ms ease}
.route-summary-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.route-summary-title{font-size:15px;font-weight:600;color:var(--accent-2);letter-spacing:.03em}
.route-clear-btn{background:transparent;border:1px solid var(--rule);color:var(--ink-subtle);padding:5px 12px;border-radius:6px;cursor:pointer;font-size:12px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.route-clear-btn:hover{background:var(--paper-3);color:var(--ink)}
.route-flow{display:flex;align-items:center;flex-wrap:wrap;gap:6px}
.route-item{display:flex;align-items:center;gap:4px;padding:5px 10px;background:var(--paper-2);border-radius:20px;font-size:12px;border:1px solid var(--rule)}
.route-num{width:20px;height:20px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0}
.route-icon{font-size:14px}
.route-name{color:var(--ink);font-weight:500;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.route-arrow{color:var(--ink-subtle);font-size:14px}
/* Transport mode selector */
.plan-transport-bar{position:absolute;top:12px;left:12px;z-index:100;display:flex;gap:4px;background:oklch(0.12 0.006 200 / 0.9);border:1px solid var(--rule);border-radius:var(--radius-sm);padding:4px;backdrop-filter:blur(8px)}
.plan-transport-btn{padding:5px 10px;border:none;background:transparent;color:var(--ink-subtle);border-radius:4px;cursor:pointer;font-size:12px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);display:flex;align-items:center;gap:3px}
.plan-transport-btn:hover{background:var(--paper-3);color:var(--ink)}
.plan-transport-btn.active{background:var(--accent);color:#000;font-weight:600}
/* Enhanced route summary */
.route-info-bar{display:flex;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.route-info-chip{display:flex;align-items:center;gap:4px;padding:4px 12px;background:var(--paper-2);border:1px solid var(--rule);border-radius:20px;font-size:12px;color:var(--ink-2)}
.route-info-chip strong{color:var(--accent-2);font-weight:600}
.route-segments{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.route-segment{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--paper-2);border:1px solid var(--rule);border-radius:var(--radius-sm);font-size:13px;transition:all var(--dur-short) var(--ease-out)}
.route-segment:hover{border-color:var(--accent);background:var(--paper-3)}
.route-seg-from{display:flex;align-items:center;gap:4px;min-width:80px}
.route-seg-to{display:flex;align-items:center;gap:4px;min-width:80px}
.route-seg-info{flex:1;color:var(--ink-subtle);font-size:12px}
.route-seg-actions{display:flex;gap:4px}
.route-seg-btn{padding:4px 8px;border:1px solid var(--rule);background:var(--paper-3);color:var(--ink-2);border-radius:4px;cursor:pointer;font-size:11px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);white-space:nowrap}
.route-seg-btn:hover{background:var(--accent);color:#000;border-color:var(--accent)}
.route-seg-btn.nav{background:var(--accent);color:#000;font-weight:500;border-color:var(--accent)}
.route-seg-btn.nav:hover{opacity:0.85}
.route-start-marker{width:24px;height:24px;border-radius:50%;background:oklch(0.52 0.10 175);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;border:2px solid oklch(0.92 0.002 185)}
/* Transport detail modal */
.route-transport-modal{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:oklch(0 0 0 / 0.5);backdrop-filter:blur(4px);animation:fadeIn 200ms ease}
.route-transport-modal-content{background:var(--paper);border:1px solid var(--rule);border-radius:var(--radius-md);padding:24px;max-width:500px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:var(--shadow-lg)}
.route-transport-modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.route-transport-modal-title{font-size:16px;font-weight:600;color:var(--ink)}
.route-transport-modal-close{width:28px;height:28px;border:1px solid var(--rule);background:var(--paper-3);border-radius:6px;cursor:pointer;font-size:16px;color:var(--ink-subtle);display:flex;align-items:center;justify-content:center;transition:all var(--dur-short) var(--ease-out)}
.route-transport-modal-close:hover{background:var(--accent);color:#000}
.route-transport-options{display:flex;flex-direction:column;gap:10px}
.route-transport-option{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--rule);border-radius:var(--radius-sm);cursor:pointer;transition:all var(--dur-short) var(--ease-out);background:var(--paper-2)}
.route-transport-option:hover{border-color:var(--accent);background:var(--paper-3);transform:translateX(4px)}
.route-transport-icon{font-size:28px;flex-shrink:0}
.route-transport-detail{flex:1}
.route-transport-name{font-size:14px;font-weight:600;color:var(--ink)}
.route-transport-meta{font-size:12px;color:var(--ink-subtle);margin-top:2px}
.route-transport-go{padding:6px 14px;background:var(--accent);color:#000;border:none;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;transition:all var(--dur-short) var(--ease-out);flex-shrink:0}
.route-transport-go:hover{opacity:0.85}
@keyframes slideUpIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
/* Plan Action Bar */
.plan-action-bar{margin-top:28px;padding:22px;background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md);animation:slideUpIn 350ms ease}
.plan-action-title{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:16px;letter-spacing:.03em}
.plan-action-row{display:flex;gap:10px;flex-wrap:wrap}
.plan-act-btn{padding:10px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;cursor:pointer;font-family:var(--font-body);border:none;transition:all var(--dur-short) var(--ease-out);letter-spacing:.03em}
.plan-act-save{background:var(--accent);color:#000;font-weight:600}
.plan-act-save:hover{background:var(--accent-2);box-shadow:0 0 24px oklch(0.80 0.16 85 / 0.3);transform:translateY(-1px)}
.plan-act-edit{background:var(--paper-2);color:var(--ink);border:1px solid var(--rule-bright)}
.plan-act-edit:hover{background:var(--paper-3);border-color:var(--accent-glow)}
.plan-act-redo{background:var(--paper-2);color:var(--ink-subtle);border:1px solid var(--rule)}
.plan-act-redo:hover{color:var(--ink);border-color:var(--rule-bright)}
.plan-act-export{background:transparent;color:var(--ink-subtle);border:1px solid var(--rule)}
.plan-act-export:hover{color:var(--ink);border-color:var(--rule-bright)}
/* Plan Ticket Section */
.plan-ticket-section{margin-top:28px;padding:22px;background:linear-gradient(135deg,oklch(0.16 0.006 200),oklch(0.13 0.006 200));border:1px solid oklch(0.38 0.08 95 / 0.2);border-radius:var(--radius-md);animation:slideUpIn 400ms ease}
.plan-ticket-header{font-size:14px;font-weight:600;color:var(--accent-2);margin-bottom:16px;letter-spacing:.04em}
.plan-ticket-list{display:flex;flex-direction:column;gap:8px}
.plan-ticket-card{display:flex;align-items:center;gap:12px;padding:15px 18px;background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-sm);cursor:pointer;transition:all var(--dur-short) var(--ease-out)}
.plan-ticket-card:hover{border-color:oklch(0.74 0.14 95 / 0.4);box-shadow:0 0 20px oklch(0.74 0.14 95 / 0.06);transform:translateY(-1px)}
.ptc-icon{font-size:26px;flex-shrink:0}
.ptc-info{flex:1;min-width:0}
.ptc-name{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:2px}
.ptc-meta{font-size:12px;color:var(--ink-subtle)}
.ptc-price{font-size:18px;font-weight:700;color:var(--accent-2);flex-shrink:0;margin-right:4px}
.ptc-buy{background:var(--accent);color:#000;border:none;border-radius:6px;padding:8px 18px;font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font-body);flex-shrink:0;transition:all var(--dur-short) var(--ease-out)}
.ptc-buy:hover{background:var(--accent-2);box-shadow:0 0 14px oklch(0.80 0.16 85 / 0.3)}
/* Plan Recommendation Cards */
.plan-reco-section{margin-top:28px;padding:22px;background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md);animation:slideUpIn 380ms var(--ease-out)}
.plan-reco-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:16px}
.plan-reco-title{font-size:15px;font-weight:700;color:var(--ink);letter-spacing:.03em}
.plan-reco-subtitle{font-size:12px;color:var(--ink-subtle);line-height:1.5;margin-top:4px}
.plan-reco-source{font-size:11px;color:var(--ink-subtle);padding:4px 9px;border:1px solid var(--rule);border-radius:999px;background:var(--paper-2);white-space:nowrap}
.plan-reco-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.plan-reco-tab{padding:7px 13px;border:1px solid var(--rule);border-radius:999px;background:var(--paper-2);color:var(--ink-2);font-size:12px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.plan-reco-tab:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.plan-reco-tab.active{background:var(--accent);border-color:var(--accent);color:#111}
.plan-reco-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.plan-reco-card{overflow:hidden;background:var(--paper-2);border:1px solid var(--rule);border-radius:var(--radius-md);cursor:pointer;transition:border-color var(--dur-short) var(--ease-out),transform var(--dur-short) var(--ease-out),background var(--dur-short) var(--ease-out);display:flex;flex-direction:column;min-height:310px}
.plan-reco-card:hover{border-color:oklch(0.74 0.16 75 / .65);background:oklch(0.20 0.014 170);transform:translateY(-2px)}
.plan-reco-img-wrap{height:132px;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--paper-4),var(--paper-2))}
.plan-reco-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 360ms var(--ease-out)}
.plan-reco-card:hover .plan-reco-img{transform:scale(1.04)}
.plan-reco-img-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:34px;background:linear-gradient(135deg,oklch(0.24 0.018 170),oklch(0.16 0.010 170))}
.plan-reco-badge{position:absolute;left:10px;top:10px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:700;background:oklch(0.10 0.006 170 / .78);color:var(--accent-2);border:1px solid oklch(0.80 0.14 85 / .28)}
.plan-reco-body{padding:14px 15px 15px;display:flex;flex-direction:column;gap:9px;flex:1}
.plan-reco-name{font-size:15px;font-weight:700;color:var(--ink);line-height:1.35}
.plan-reco-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;color:var(--ink-subtle)}
.plan-reco-rating{color:var(--accent-2);font-weight:700}
.plan-reco-address{font-size:12px;line-height:1.55;color:var(--ink-2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:38px}
.plan-reco-review{font-size:12px;line-height:1.6;color:var(--ink-subtle);background:var(--paper);border:1px solid var(--rule-2);border-radius:var(--radius-sm);padding:9px 10px;margin-top:auto}
.plan-reco-actions{display:flex;gap:8px;margin-top:2px}
.plan-reco-btn{flex:1;padding:8px 10px;border-radius:var(--radius-sm);border:1px solid var(--rule);background:transparent;color:var(--ink-2);font-size:12px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.plan-reco-btn:hover{border-color:var(--accent);color:var(--accent)}
.plan-reco-btn.primary{background:var(--accent);border-color:var(--accent);color:#111}
.plan-reco-btn.primary:hover{background:var(--accent-2);color:#111}
.plan-reco-empty{padding:18px;border:1px dashed var(--rule);border-radius:var(--radius-sm);color:var(--ink-subtle);font-size:13px;line-height:1.7;background:var(--paper-2)}
.plan-reco-skeleton{height:310px;border-radius:var(--radius-md);background:linear-gradient(90deg,var(--paper-2),var(--paper-4),var(--paper-2));background-size:220% 100%;animation:recoSkeleton 1.2s ease-in-out infinite;border:1px solid var(--rule)}
@keyframes recoSkeleton{0%{background-position:120% 0}100%{background-position:-120% 0}}
.poi-detail-modal{position:fixed;inset:0;z-index:220;display:flex;align-items:center;justify-content:center;padding:24px;background:oklch(0% 0 0 / .62)}
.poi-detail-card{width:min(860px,96vw);max-height:88vh;overflow:auto;background:var(--paper-2);border:1px solid var(--rule-bright);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);animation:slideUpIn 220ms var(--ease-out)}
.poi-detail-hero{height:230px;position:relative;background:var(--paper-4);overflow:hidden;border-radius:var(--radius-lg) var(--radius-lg) 0 0}
.poi-detail-hero img{width:100%;height:100%;object-fit:cover;display:block}
.poi-detail-hero-fallback{height:100%;display:flex;align-items:center;justify-content:center;font-size:48px;background:linear-gradient(135deg,var(--paper-4),var(--paper))}
.poi-detail-close{position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:50%;border:1px solid oklch(1 0 0 / .18);background:oklch(0 0 0 / .46);color:#fff;font-size:18px;cursor:pointer}
.poi-detail-body{padding:22px}
.poi-detail-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:14px}
.poi-detail-title{font-size:22px;font-weight:800;color:var(--ink);line-height:1.25}
.poi-detail-type{font-size:12px;color:var(--accent-2);margin-top:6px;line-height:1.5}
.poi-detail-score{padding:9px 12px;border-radius:var(--radius-sm);background:var(--paper);border:1px solid var(--rule);color:var(--accent-2);font-weight:800;white-space:nowrap}
.poi-detail-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;margin-top:16px}
.poi-detail-panel{background:var(--paper);border:1px solid var(--rule);border-radius:var(--radius-md);padding:15px}
.poi-detail-panel h4{font-size:13px;color:var(--ink);margin-bottom:10px;letter-spacing:.03em}
.poi-detail-panel p{font-size:13px;line-height:1.75;color:var(--ink-2);margin:0}
.poi-detail-facts{display:flex;flex-direction:column;gap:9px}
.poi-detail-fact{font-size:13px;color:var(--ink-2);line-height:1.55}
.poi-detail-fact strong{color:var(--ink);font-weight:700}
.poi-detail-reviews{display:flex;flex-direction:column;gap:10px}
.poi-detail-review{padding:12px 14px;border:1px solid var(--rule-2);border-radius:var(--radius-sm);background:var(--paper-2);font-size:13px;line-height:1.7;color:var(--ink-2)}
.poi-review-meta{display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap}
.poi-review-author{color:var(--accent-2);font-size:12px;font-weight:700}
.poi-review-time{color:var(--ink-3);font-size:11px}
.poi-review-stars{font-size:11px;letter-spacing:1px;color:var(--accent)}
.poi-review-text{color:var(--ink-2)}
.poi-detail-actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
.poi-detail-action{padding:10px 16px;border-radius:var(--radius-sm);border:1px solid var(--rule);background:transparent;color:var(--ink-2);font-size:13px;font-weight:700;cursor:pointer;font-family:var(--font-body)}
.poi-detail-action.primary{background:var(--accent);border-color:var(--accent);color:#111}
@media (max-width:760px){.plan-reco-head,.poi-detail-top{flex-direction:column;align-items:stretch}.plan-reco-grid{grid-template-columns:1fr}.poi-detail-grid{grid-template-columns:1fr}.poi-detail-hero{height:190px}.loc-card{width:130px}.loc-card-img{height:72px}}
/* MARKETING */
.page-marketing{display:flex;flex-direction:column}
.mkt-layout{display:flex;flex:1;min-height:0}
.mkt-form-panel{width:340px;flex-shrink:0;border-right:1px solid var(--rule);padding:24px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;background:var(--paper-2)}
.mkt-form-panel h3{font-size:15px;font-weight:600;color:var(--ink);letter-spacing:.03em;margin-bottom:4px}
.mkt-preview-panel{flex:1;padding:24px;display:flex;flex-direction:column;gap:16px;overflow-y:auto}
.mkt-preview-card{background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md);padding:28px;min-height:220px;line-height:1.75;font-size:15px;color:var(--ink);letter-spacing:.02em;white-space:pre-wrap;transition:all var(--dur-short) var(--ease-out)}
.mkt-preview-card.empty{display:flex;align-items:center;justify-content:center;color:var(--ink-subtle);font-size:15px}
.mkt-preview-actions{display:flex;gap:10px}
.mkt-history{margin-top:20px}
.mkt-history h3{font-size:13px;font-weight:600;color:var(--ink-subtle);margin-bottom:12px;letter-spacing:.04em;text-transform:uppercase}
.mkt-history-item{padding:12px 14px;border:1px solid var(--rule);border-radius:var(--radius-sm);margin-bottom:8px;cursor:pointer;transition:all var(--dur-short) var(--ease-out);background:var(--paper-2)}
.mkt-history-item:hover{border-color:var(--rule-bright);background:var(--paper-3)}
.mkt-generate-btn{padding:12px 24px;background:var(--accent);color:#1a1a1a;border:none;border-radius:var(--radius-sm);font-size:15px;font-weight:600;cursor:pointer;letter-spacing:.04em;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);margin-top:8px}
.mkt-generate-btn:hover{background:var(--accent-2);box-shadow:var(--shadow-glow);transform:translateY(-1px)}
/* MARKETING — 热门文创产品展示 */
.mkt-inspire{margin-bottom:4px}
.mkt-inspire-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px}
.mkt-inspire-title{font-size:16px;font-weight:700;color:var(--ink);letter-spacing:.03em;display:flex;align-items:center;gap:8px}
.mkt-inspire-title .icon{font-size:20px}
.mkt-inspire-subtitle{font-size:12px;color:var(--ink-subtle);margin-top:2px;line-height:1.5}
.market-hot-status{font-size:11px;color:var(--ink-subtle);margin-top:5px;line-height:1.5}
.mkt-inspire-filters{display:flex;gap:8px;flex-wrap:wrap}
.mkt-inspire-chip{padding:6px 14px;border-radius:20px;border:1px solid var(--rule);background:var(--paper-3);color:var(--ink-2);font-size:12px;font-weight:500;cursor:pointer;transition:all var(--dur-short) var(--ease-out);font-family:var(--font-body)}
.mkt-inspire-chip:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-dim)}
.mkt-inspire-chip.active{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;border-color:transparent;box-shadow:0 2px 10px oklch(74% .16 75 / .2)}
.mkt-inspire-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
.mkt-product-card{background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-md);overflow:hidden;cursor:pointer;transition:all var(--dur-short) var(--ease-out);display:flex;flex-direction:column;position:relative}
.mkt-product-card:hover{border-color:var(--accent);box-shadow:0 8px 28px oklch(0% 0 0 / .12);transform:translateY(-3px)}
.mkt-product-card .badge{position:absolute;top:10px;left:10px;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;z-index:2;letter-spacing:.03em}
.mkt-product-card .badge.hot{background:linear-gradient(135deg,oklch(65% .22 25),oklch(58% .20 25));color:#fff}
.mkt-product-card .badge.new{background:linear-gradient(135deg,oklch(62% .16 155),oklch(55% .14 155));color:#fff}
.mkt-product-card .badge.pick{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#1a1a1a}
.mkt-product-img{width:100%;height:140px;object-fit:cover;display:block;transition:transform .4s var(--ease-out)}
.mkt-product-card:hover .mkt-product-img{transform:scale(1.06)}
.mkt-product-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
.mkt-product-name{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4}
.mkt-product-brand{font-size:11px;color:var(--ink-subtle);letter-spacing:.04em}
.mkt-product-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:2px}
.mkt-product-tag{font-size:10px;padding:2px 8px;border-radius:10px;background:var(--accent-dim);color:var(--accent);font-weight:600;letter-spacing:.03em}
.mkt-product-desc{font-size:12px;color:var(--ink-2);line-height:1.55;margin-top:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.mkt-product-footer{display:flex;align-items:center;justify-content:space-between;margin-top:8px;padding-top:8px;border-top:1px solid var(--rule)}
.mkt-product-price{font-size:17px;font-weight:700;color:var(--accent-2)}
.mkt-product-price small{font-size:11px;color:var(--ink-subtle);font-weight:400;margin-left:2px}
.mkt-product-sales{font-size:11px;color:var(--ink-subtle)}
.mkt-inspire-btn{padding:6px 14px;border-radius:6px;border:none;background:var(--accent-dim);color:var(--accent);font-size:12px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);display:inline-flex;align-items:center;gap:4px}
.mkt-inspire-btn:hover{background:var(--accent);color:#fff;box-shadow:0 2px 10px oklch(74% .16 75 / .2)}
.mkt-inspire-btn.saved{background:oklch(62% .16 155 / .15);color:oklch(50% .14 155);border:1px solid oklch(62% .16 155 / .3)}
/* 文创详情弹窗 */
.mkt-product-modal{display:none;position:fixed;inset:0;z-index:600;align-items:center;justify-content:center;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);animation:fadeIn 200ms ease}
.mkt-product-modal.open{display:flex}
.mkt-product-modal-inner{background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:var(--radius-lg);width:560px;max-width:92vw;max-height:86vh;overflow-y:auto;box-shadow:0 24px 70px rgba(0,0,0,.4);color:var(--ink)}
.mkt-product-modal-hero{width:100%;height:220px;object-fit:cover;border-radius:var(--radius-lg) var(--radius-lg) 0 0}
.mkt-product-modal-body{padding:24px 28px 28px}
.mkt-product-modal-body h3{font-size:20px;font-weight:700;margin-bottom:4px}
.mkt-product-modal-brand{font-size:12px;color:var(--ink-subtle);margin-bottom:16px;letter-spacing:.04em}
.mkt-product-modal-section{margin-bottom:18px}
.mkt-product-modal-section h4{font-size:13px;font-weight:600;color:var(--accent);margin-bottom:8px;letter-spacing:.04em;text-transform:uppercase}
.mkt-product-modal-section p{font-size:14px;line-height:1.7;color:var(--ink-2)}
.mkt-product-modal-inspire{background:var(--accent-dim);border:1px solid oklch(75% .09 55);border-radius:var(--radius-md);padding:16px;margin:16px 0}
.mkt-product-modal-inspire h4{font-size:13px;font-weight:600;color:var(--accent);margin-bottom:10px}
.mkt-product-modal-inspire ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.mkt-product-modal-inspire li{font-size:13px;line-height:1.6;color:var(--ink-2);padding-left:20px;position:relative}
.mkt-product-modal-inspire li::before{content:'✦';position:absolute;left:0;color:var(--accent);font-size:12px}
.mkt-product-modal-actions{display:flex;gap:10px;margin-top:20px;flex-wrap:wrap}
.mkt-product-modal-close{position:absolute;top:12px;right:14px;width:32px;height:32px;border-radius:50%;border:none;background:rgba(0,0,0,.4);color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--dur-short) var(--ease-out);z-index:3}
.mkt-product-modal-close:hover{background:rgba(0,0,0,.65);transform:rotate(90deg)}
.mkt-inspire-empty{text-align:center;padding:32px;color:var(--ink-subtle);font-size:14px;grid-column:1/-1}
/* SETTINGS */
.settings-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:500;align-items:center;justify-content:center;animation:fadeIn 200ms ease}
.settings-overlay.open{display:flex}
.settings-card{background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:var(--radius-md);padding:32px;width:460px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,0.5);color:var(--ink)}
.settings-card h2{font-size:18px;font-weight:600;margin-bottom:20px;letter-spacing:.04em}
.settings-card label{display:block;font-size:11px;font-weight:600;color:var(--ink-subtle);margin:14px 0 5px;letter-spacing:.05em;text-transform:uppercase}
.settings-card input,.settings-card select{width:100%;padding:10px 14px;border:1px solid var(--rule);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font-size:14px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.settings-card input:focus,.settings-card select:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--focus-ring)}
.settings-card .btn-row{display:flex;gap:8px;margin-top:20px;justify-content:flex-end}
/* RESPONSIVE */
@media(max-width:900px){
  .hero{padding:32px 24px}
  .hero-brand{font-size:2.5rem}
  .hero-features{grid-template-columns:repeat(2,1fr);margin-top:32px}
  .plan-sidebar{width:100%;border-right:none;border-bottom:1px solid var(--rule)}
  .plan-layout{flex-direction:column}
  .plan-map{width:100%;height:280px;border-left:none;border-top:1px solid var(--rule)}
  .plan-transport-bar{flex-wrap:wrap;max-width:200px}
  .mkt-form-panel{width:100%;border-right:none;border-bottom:1px solid var(--rule)}
  .mkt-layout{flex-direction:column}
}
@media(max-width:600px){
  .top-nav{padding:0 12px}
  .nav-tab{padding:6px 10px;font-size:12px}
  .hero-nav-card{min-width:70px;padding:12px 14px}
  .mkt-inspire-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .mkt-product-img{height:100px}
  .mkt-inspire-header{flex-direction:column;align-items:flex-start}
  .mkt-product-modal-inner{width:96vw;max-height:80vh}
  .mkt-product-modal-hero{height:160px}
  .route-segment{flex-wrap:wrap;gap:4px}
  .route-seg-from,.route-seg-to{min-width:60px}
  .route-seg-actions{width:100%;justify-content:flex-end}
  .route-transport-modal-content{width:95vw;padding:16px}
}

/* ===== TRAINING PAGE ===== */
.page-training{display:flex;flex-direction:column}
.training-layout{display:flex;flex:1;min-height:0}
/* Training Sidebar */
.training-sidebar{width:280px;flex-shrink:0;border-right:1px solid var(--rule);padding:24px 20px;display:flex;flex-direction:column;gap:22px;overflow-y:auto;background:var(--paper-2)}
.training-sidebar-title{font-size:14px;font-weight:600;color:var(--ink);margin-bottom:4px;letter-spacing:.04em}
.training-major-list{display:flex;flex-direction:column;gap:8px}
.major-card{padding:16px;border:1px solid var(--rule);border-radius:var(--radius-sm);cursor:pointer;transition:all var(--dur-short) var(--ease-out);display:flex;gap:14px;align-items:center;background:var(--paper)}
.major-card:hover{border-color:var(--rule-bright);background:var(--paper-3);transform:translateY(-1px)}
.major-card.active{border-color:var(--accent-2);background:oklch(0.18 0.015 95 / 0.12);box-shadow:0 0 20px oklch(0.74 0.14 95 / 0.08)}
.major-icon{font-size:32px;flex-shrink:0;transition:transform var(--dur-short) var(--ease-out)}
.major-card:hover .major-icon{transform:scale(1.08)}
.major-info{flex:1;min-width:0}
.major-name{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:3px;letter-spacing:.03em}
.major-desc{font-size:12px;color:var(--ink-subtle);line-height:1.5}
.training-progress-wrap{padding-top:16px;border-top:1px solid var(--rule)}
.training-progress-label{font-size:12px;font-weight:600;color:var(--ink-subtle);margin-bottom:10px;letter-spacing:.04em;text-transform:uppercase}
.training-progress-bar{height:6px;background:var(--paper-3);border-radius:3px;overflow:hidden;margin-bottom:8px}
.training-progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2));border-radius:3px;transition:width 500ms cubic-bezier(0.4,0,0.2,1);width:0%}
.training-progress-text{font-size:12px;color:var(--ink-subtle);letter-spacing:.03em}
/* Training Content */
.training-content{flex:1;padding:28px 32px;overflow-y:auto;display:flex;flex-direction:column;gap:24px}
.training-content::-webkit-scrollbar{width:4px}
.training-content::-webkit-scrollbar-thumb{background:var(--rule-bright);border-radius:2px}
.training-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--rule)}
.training-header-left{display:flex;gap:16px;align-items:center}
.training-header-icon{font-size:36px;flex-shrink:0}
.training-header-title{font-size:22px;font-weight:300;color:var(--ink);letter-spacing:.04em;margin-bottom:4px}
.training-header-sub{font-size:14px;color:var(--ink-subtle);letter-spacing:.03em}
.training-report-btn{padding:10px 20px;background:var(--paper-2);border:1px solid var(--accent);color:var(--accent);border-radius:var(--radius-sm);font-size:13px;font-weight:500;cursor:pointer;transition:all var(--dur-short) var(--ease-out);font-family:var(--font-body);white-space:nowrap;letter-spacing:.03em}
.training-report-btn:hover{background:oklch(0.20 0.02 95 / 0.15);border-color:var(--accent-2);color:var(--accent-2);box-shadow:0 0 20px oklch(0.74 0.14 95 / 0.1)}
.training-report-btn:disabled{opacity:.4;cursor:not-allowed}
.training-stage-list{display:flex;flex-direction:column;gap:20px}
/* Stage / Task Cards */
.training-stage{background:var(--paper-2);border:1px solid var(--rule);border-radius:var(--radius-md);overflow:hidden;transition:all var(--dur-short) var(--ease-out)}
.training-stage.completed{border-color:oklch(0.50 0.10 150 / 0.3)}
.stage-header{padding:18px 22px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;transition:background all var(--dur-short) var(--ease-out);user-select:none}
.stage-header:hover{background:var(--paper-3)}
.stage-header-left{display:flex;gap:14px;align-items:center}
.stage-num{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0;background:var(--paper-3);color:var(--ink-subtle);border:1px solid var(--rule)}
.training-stage.completed .stage-num{background:var(--success);color:#fff;border-color:var(--success)}
.stage-title-wrap{display:flex;flex-direction:column;gap:2px}
.stage-title{font-size:16px;font-weight:500;color:var(--ink);letter-spacing:.03em}
.stage-desc{font-size:12px;color:var(--ink-subtle)}
.stage-badge{padding:3px 10px;border-radius:10px;font-size:11px;font-weight:500;letter-spacing:.03em}
.training-stage.completed .stage-badge{background:oklch(0.28 0.06 150 / 0.15);color:var(--success)}
.stage-badge.pending{background:oklch(0.22 0.005 200);color:var(--ink-subtle)}
.stage-badge.active-task{background:oklch(0.22 0.05 175 / 0.15);color:var(--accent-glow);animation:pulse-dot-bg 2s ease-in-out infinite}
@keyframes pulse-dot-bg{0%,100%{opacity:1}50%{opacity:.6}}
.stage-arrow{font-size:18px;color:var(--ink-subtle);transition:transform var(--dur-short) var(--ease-out)}
.stage-header.open .stage-arrow{transform:rotate(180deg)}
.stage-tasks{padding:0 22px 18px;display:none;flex-direction:column;gap:10px}
.stage-tasks.open{display:flex}
.task-item{padding:14px 16px;border:1px solid var(--rule);border-radius:var(--radius-sm);display:flex;gap:14px;align-items:flex-start;transition:all var(--dur-short) var(--ease-out);background:var(--paper);position:relative}
.task-item:hover{border-color:var(--rule-bright)}
.task-item.completed{border-color:oklch(0.50 0.10 150 / 0.25);background:oklch(0.18 0.012 150 / 0.08)}
.task-check{width:24px;height:24px;border-radius:50%;border:2px solid var(--rule-bright);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all var(--dur-short) var(--ease-out);margin-top:2px;cursor:pointer;font-size:12px;color:transparent;background:transparent}
.task-item.completed .task-check{border-color:var(--success);background:var(--success);color:#fff}
.task-check:hover{border-color:var(--accent-glow);box-shadow:0 0 8px oklch(0.54 0.12 175 / 0.3)}
.task-info{flex:1;min-width:0}
.task-name{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:4px;letter-spacing:.03em}
.task-desc{font-size:12px;color:var(--ink-subtle);line-height:1.6;margin-bottom:8px}
.task-actions{display:flex;gap:8px;flex-wrap:wrap}
.task-btn{padding:6px 14px;border-radius:14px;font-size:12px;cursor:pointer;transition:all var(--dur-short) var(--ease-out);font-family:var(--font-body);border:1px solid var(--rule);background:var(--paper-2);color:var(--ink-subtle);letter-spacing:.03em}
.task-btn:hover{border-color:var(--accent-glow);color:var(--accent-glow);background:oklch(0.18 0.015 175 / 0.12)}
.task-btn.primary{border-color:var(--accent);color:var(--accent-glow);background:oklch(0.22 0.05 175 / 0.15);font-weight:500}
.task-btn.primary:hover{background:var(--accent);color:#fff}
/* Training Report Modal */
.report-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;display:flex;align-items:center;justify-content:center;animation:fadeIn 200ms ease}
.report-modal{background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:var(--radius-md);padding:32px 36px;width:600px;max-width:92vw;max-height:88vh;overflow-y:auto;animation:slideUpIn 300ms cubic-bezier(0.4,0,0.2,1);box-shadow:0 20px 60px rgba(0,0,0,0.6)}
.report-modal h2{font-size:20px;font-weight:600;color:var(--ink);margin-bottom:6px;letter-spacing:.03em}
.report-modal .rm-sub{font-size:13px;color:var(--ink-subtle);margin-bottom:24px;letter-spacing:.03em}
.report-section{margin-bottom:20px}
.report-section h3{font-size:14px;font-weight:600;color:var(--accent-2);margin-bottom:10px;letter-spacing:.04em}
.report-row{display:flex;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--rule);font-size:14px;letter-spacing:.03em}
.report-row:last-child{border-bottom:none}
.report-row .rr-label{color:var(--ink-subtle)}
.report-row .rr-value{color:var(--ink);font-weight:500}
.report-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.report-tag{padding:4px 12px;border-radius:var(--radius-sm);font-size:12px;background:oklch(0.22 0.04 175 / 0.12);color:var(--accent-glow);font-weight:500}
.report-tag.done{background:oklch(0.28 0.06 150 / 0.15);color:var(--success)}
.report-modal .rm-actions{display:flex;gap:10px;margin-top:24px;justify-content:flex-end}
.rm-btn{padding:10px 22px;border-radius:var(--radius-sm);font-size:14px;font-weight:500;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out);border:none;letter-spacing:.03em}
.rm-btn-cancel{background:var(--paper-2);color:var(--ink-subtle)}
.rm-btn-cancel:hover{background:var(--paper-3);color:var(--ink)}
.rm-btn-export{background:var(--accent);color:#000;font-weight:600}
.rm-btn-export:hover{background:var(--accent-2);box-shadow:0 0 20px oklch(0.80 0.16 85 / 0.25)}
@media(max-width:900px){
  .training-layout{flex-direction:column}
  .training-sidebar{width:100%;border-right:none;border-bottom:1px solid var(--rule)}
  .training-major-list{flex-direction:row;flex-wrap:wrap}
  .major-card{min-width:140px;flex:1}
}

/* ===== PROFILE PAGE (Personal Center) ===== */
.page-profile{display:flex;flex-direction:column}
.profile-layout{display:flex;flex:1;min-height:0}
.profile-sidebar{width:260px;flex-shrink:0;border-right:1px solid var(--rule);padding:28px 22px;display:flex;flex-direction:column;gap:24px;background:var(--paper-2)}
.profile-avatar{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;padding-bottom:24px;border-bottom:1px solid var(--rule)}
.pa-circle{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-glow));display:flex;align-items:center;justify-content:center;font-size:32px;box-shadow:0 0 24px oklch(0.54 0.12 175 / 0.3)}
.pa-name{font-size:18px;font-weight:600;color:var(--ink);letter-spacing:.03em}
.pa-sub{font-size:12px;color:var(--ink-subtle);letter-spacing:.04em}
.profile-tabs{display:flex;flex-direction:column;gap:4px}
.ptab{padding:11px 16px;border-radius:var(--radius-sm);font-size:14px;color:var(--ink-subtle);cursor:pointer;transition:all var(--dur-short) var(--ease-out);letter-spacing:.03em;border:1px solid transparent}
.ptab:hover{background:var(--paper-3);color:var(--ink)}
.ptab.active{background:oklch(0.20 0.015 95 / 0.12);color:var(--accent-2);font-weight:500;border-color:oklch(0.38 0.08 95 / 0.25)}
.profile-content{flex:1;padding:28px 32px;overflow-y:auto}
.profile-content::-webkit-scrollbar{width:4px}
.profile-content::-webkit-scrollbar-thumb{background:var(--rule-bright);border-radius:2px}
.profile-section{display:none;flex-direction:column;gap:16px}
.profile-section.active{display:flex}
.profile-section h3{font-size:18px;font-weight:400;color:var(--ink);letter-spacing:.03em}
.profile-list{display:flex;flex-direction:column;gap:10px}
.profile-empty{text-align:center;padding:48px 20px;color:var(--ink-subtle);font-size:14px;line-height:1.8}
.profile-empty span{font-size:12px;color:var(--ink-subtle);opacity:.6}
.pf-card{display:flex;gap:14px;padding:16px 18px;background:var(--paper-3);border:1px solid var(--rule);border-radius:var(--radius-sm);align-items:center;transition:all var(--dur-short) var(--ease-out)}
.pf-card:hover{border-color:var(--rule-bright);background:var(--paper-3);box-shadow:0 2px 8px oklch(0% 0 0 / 0.2)}
.pf-card-icon{font-size:24px;flex-shrink:0;width:44px;height:44px;border-radius:10px;background:oklch(0.16 0.010 200);display:flex;align-items:center;justify-content:center}
.pf-card-info{flex:1;min-width:0}
.pf-card-title{font-size:14px;font-weight:500;color:var(--ink);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pf-card-meta{font-size:12px;color:var(--ink-subtle);display:flex;gap:10px;flex-wrap:wrap}
.pf-card-badge{display:inline-block;font-size:10px;padding:2px 8px;border-radius:var(--radius-sm);font-weight:500}
.pf-badge-confirmed{background:oklch(0.22 0.06 150 / 0.25);color:oklch(0.62 0.10 150)}
.pf-badge-pending{background:oklch(0.22 0.06 85 / 0.25);color:var(--accent-2)}
.pf-card-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.pf-card-price{font-size:18px;font-weight:600;color:var(--accent-2)}
.pf-card-del{background:none;border:1px solid var(--rule);color:var(--ink-subtle);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit;transition:all var(--dur-short) var(--ease-out)}
.pf-card-del:hover{border-color:#fa5252;color:#fa5252;background:oklch(0.20 0.04 25 / 0.2)}
.pf-card-view{background:var(--paper-2);border:1px solid var(--accent);color:var(--accent-glow);padding:4px 10px;border-radius:6px;cursor:pointer;font-size:11px;font-family:inherit;transition:all var(--dur-short) var(--ease-out);margin-right:4px}
.pf-card-view:hover{background:oklch(0.52 0.10 175 / 0.15);border-color:var(--accent-glow)}
.pf-add-btn{padding:8px 16px;border:1px dashed var(--rule-bright);background:transparent;color:var(--ink-subtle);border-radius:var(--radius-sm);cursor:pointer;font-size:13px;font-family:inherit;transition:all var(--dur-short) var(--ease-out);align-self:flex-start}
.pf-add-btn:hover{border-color:var(--accent-2);color:var(--accent-2);background:oklch(0.18 0.012 95 / 0.08)}
/* Profile add modal */
.pf-modal-overlay{position:fixed;inset:0;background:oklch(0 0 0 / 0.6);z-index:1100;display:flex;align-items:center;justify-content:center;animation:fadeIn 200ms ease}
.pf-modal{background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:var(--radius-md);padding:28px 32px;width:420px;max-width:92vw;display:flex;flex-direction:column;gap:14px;box-shadow:0 20px 60px rgba(0,0,0,0.6)}
.pf-modal h3{font-size:16px;font-weight:600;color:var(--ink);letter-spacing:.03em}
.pf-modal label{font-size:11px;color:var(--ink-subtle);text-transform:uppercase;letter-spacing:.05em;font-weight:600}
.pf-modal input,.pf-modal select{width:100%;padding:10px 14px;border:1px solid var(--rule);border-radius:var(--radius-sm);background:var(--paper);color:var(--ink);font-size:14px;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.pf-modal input:focus,.pf-modal select:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--focus-ring)}
.pf-modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:4px}
.pf-modal-actions button{padding:8px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;cursor:pointer;font-family:inherit;border:none;transition:all var(--dur-short) var(--ease-out)}
.pf-btn-cancel{background:oklch(0.20 0.005 185);color:var(--ink-subtle)}
.pf-btn-cancel:hover{background:oklch(0.25 0.005 185);color:var(--ink)}
.pf-btn-save{background:var(--accent-2);color:#000;font-weight:600}
.pf-btn-save:hover{background:oklch(0.85 0.16 85)}
@media(max-width:900px){
  .profile-sidebar{width:100%;border-right:none;border-bottom:1px solid var(--rule);flex-direction:row;align-items:center;padding:16px 20px;gap:16px}
  .profile-layout{flex-direction:column}
  .profile-avatar{flex-direction:row;gap:10px}
  .pa-circle{width:40px;height:40px;font-size:20px}
  .profile-tabs{flex-direction:row;flex-wrap:wrap;gap:6px}
  .ptab{padding:6px 12px;font-size:12px}
  .profile-content{padding:20px 16px}
}


/* ===== 2026 Culture-Commerce UI Redesign ===== */
:root{
  --cinnabar: oklch(58% 0.18 32);
  --jade: oklch(62% 0.13 165);
  --lake: oklch(46% 0.09 205);
  --silk: oklch(92% 0.020 75);
  --shadow-theatre: 0 30px 80px oklch(0% 0 0 / .55);
}
.top-nav{height:64px;padding:0 30px;background:linear-gradient(90deg,oklch(10% .010 170 / .96),oklch(7% .006 170 / .98));box-shadow:0 1px 0 var(--rule),0 18px 50px oklch(0% 0 0 / .35)}
.nav-logo{border-radius:12px;background:linear-gradient(145deg,var(--accent),var(--cinnabar));box-shadow:0 0 0 1px oklch(90% .08 75 / .18),0 12px 28px oklch(65% .15 55 / .2)}
.nav-title{font-weight:800;letter-spacing:.02em}
.nav-tab{min-width:58px;color:var(--ink-2)}
.nav-tab.active{color:var(--accent)}
.nav-tab.active::after{width:28px;height:3px;bottom:-14px}
.nav-status{padding:6px 10px;border:1px solid var(--rule);border-radius:999px;background:oklch(14% .010 170 / .6)}
.nav-status-dot{width:8px;height:8px}
.pages-container{background:radial-gradient(circle at 12% 8%,oklch(58% .18 32 / .12),transparent 32%),radial-gradient(circle at 80% 20%,oklch(62% .13 165 / .08),transparent 34%),var(--paper)}
.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.75fr);gap:42px;align-items:center;padding:46px clamp(28px,5vw,76px);background:url('bg.jpg') center/cover no-repeat}
.hero::before{background:linear-gradient(90deg,oklch(6% .010 170 / .92) 0%,oklch(7% .010 170 / .78) 54%,oklch(5% .008 170 / .9) 100%)}
.hero::after{background:radial-gradient(circle at 77% 36%,oklch(75% .16 75 / .2),transparent 28%),linear-gradient(135deg,transparent 0 35%,oklch(58% .18 32 / .08) 35% 36%,transparent 36% 100%)}
.hero-content{max-width:720px;margin:0;text-align:left}
.hero-cultural-mark{display:inline-flex;align-items:center;gap:10px;margin-bottom:18px;padding:7px 12px;border:1px solid oklch(75% .13 75 / .24);border-radius:999px;background:oklch(16% .014 75 / .48);color:var(--accent-2);font-size:12px;font-weight:700;letter-spacing:.08em}
.hero-cultural-mark::before{content:'非遗 · 城市漫游 · AI Agent';}
.hero-brand{font-size:clamp(3.4rem,7vw,6.4rem);line-height:.96;font-weight:700;letter-spacing:-.035em;text-wrap:balance;color:var(--silk);text-shadow:0 18px 60px oklch(0% 0 0 / .55)}
.hero-brand::after{content:'把一座城讲成一条会转化的路线';display:block;margin-top:14px;font-family:var(--font-body);font-size:clamp(1.1rem,2vw,1.55rem);font-weight:600;letter-spacing:.02em;color:var(--accent)}
.hero-tagline{max-width:620px;margin-top:22px;color:var(--ink-2);font-size:16px;line-height:1.9}
.hero-tagline::after{content:'适合景区运营、酒店营销、文创策划与高校实训：从咨询、规划、地图到营销内容，一屏完成。';display:block;margin-top:8px;color:var(--ink-subtle);font-size:14px}
.hero-search-wrap{align-items:flex-start;margin-top:34px;gap:14px}
.hero-search{max-width:640px;border:1px solid oklch(78% .14 75 / .32);border-radius:18px;background:linear-gradient(180deg,oklch(17% .012 170 / .86),oklch(11% .009 170 / .86));box-shadow:var(--shadow-theatre),0 0 0 1px oklch(100% 0 0 / .03)}
.hero-search::before{content:'⌘';display:flex;align-items:center;justify-content:center;width:38px;color:var(--accent);font-family:var(--font-mono);font-weight:700}
.hero-search input{font-size:15px}
.hero-search button{border-radius:13px;background:linear-gradient(135deg,var(--accent),oklch(70% .18 45));box-shadow:0 12px 30px oklch(72% .16 75 / .22)}
.hero-quick-tags{justify-content:flex-start}
.hero-quick-tag{padding:7px 15px;background:oklch(14% .012 170 / .68);border-color:oklch(75% .12 75 / .18);color:var(--ink-2)}
.hero-features{grid-column:1 / -1;max-width:none;width:100%;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:10px}
.hero-nav-card{position:relative;overflow:hidden;padding:22px 22px 20px;border-radius:18px;background:linear-gradient(160deg,oklch(16% .014 170 / .72),oklch(10% .010 170 / .82));border-color:oklch(78% .10 75 / .18);box-shadow:0 14px 40px oklch(0% 0 0 / .28)}
.hero-nav-card::after{content:'';position:absolute;inset:auto -20% -40% -20%;height:70px;background:radial-gradient(ellipse,var(--accent-dim),transparent 64%);opacity:0;transition:opacity var(--dur-short) var(--ease-out)}
.hero-nav-card:hover::after{opacity:1}
.hero-nav-card .hni{font-size:30px;filter:drop-shadow(0 10px 20px oklch(0% 0 0 / .42))}
.hero-nav-card .hnl{font-size:16px}
.hero-nav-card .hnd{font-size:12px;color:var(--ink-2)}
.hero-stage{position:relative;z-index:10;min-height:520px;border:1px solid oklch(76% .12 75 / .18);border-radius:28px;background:linear-gradient(160deg,oklch(18% .016 170 / .66),oklch(10% .012 170 / .86));box-shadow:var(--shadow-theatre);overflow:hidden}
.hero-stage::before{content:'';position:absolute;inset:-30%;background:conic-gradient(from 210deg,transparent,oklch(72% .16 75 / .16),transparent,oklch(62% .13 165 / .12),transparent);animation:stageSpin 18s linear infinite}
.hero-stage-inner{position:absolute;inset:1px;border-radius:27px;background:linear-gradient(180deg,oklch(11% .012 170 / .94),oklch(8% .010 170 / .96));padding:24px;display:flex;flex-direction:column;gap:16px}
@keyframes stageSpin{to{transform:rotate(360deg)}}
.stage-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.stage-label{font-size:12px;color:var(--accent);letter-spacing:.12em;font-weight:800}
.stage-city{font-family:var(--font-display);font-size:34px;font-weight:700;color:var(--silk)}
.stage-badge{padding:6px 10px;border-radius:999px;background:oklch(22% .04 165 / .5);border:1px solid oklch(70% .12 165 / .26);color:var(--jade);font-size:12px;font-weight:700}
.culture-map{position:relative;flex:1;border-radius:22px;border:1px solid var(--rule);background:radial-gradient(circle at 50% 42%,oklch(72% .16 75 / .14),transparent 24%),linear-gradient(135deg,oklch(16% .012 180),oklch(9% .010 170));overflow:hidden}
.culture-map::before{content:'';position:absolute;inset:12%;border:1px solid oklch(80% .13 75 / .22);border-radius:45% 55% 48% 52%;transform:rotate(-12deg)}
.culture-node{position:absolute;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 8px oklch(72% .16 75 / .12),0 0 24px var(--accent)}
.culture-node.n1{left:28%;top:38%}.culture-node.n2{left:62%;top:30%}.culture-node.n3{left:72%;top:64%}.culture-node.n4{left:38%;top:70%}
.route-float{position:absolute;left:24px;right:24px;bottom:24px;padding:16px;border-radius:18px;background:oklch(10% .010 170 / .88);border:1px solid oklch(90% .04 75 / .16);backdrop-filter:blur(12px)}
.route-float-title{display:flex;justify-content:space-between;margin-bottom:12px;font-weight:800;color:var(--ink)}
.route-line{display:grid;grid-template-columns:24px 1fr;gap:10px;align-items:start;margin-top:10px;color:var(--ink-2);font-size:13px}
.route-line span:first-child{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:#1a1a1a;font-weight:800;font-size:12px}
.stage-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stage-metric{padding:12px;border-radius:16px;background:oklch(16% .012 170 / .72);border:1px solid var(--rule)}
.stage-metric strong{display:block;color:var(--accent);font-size:18px}.stage-metric span{font-size:11px;color:var(--ink-subtle)}
.location-bar{padding:10px 22px!important;background:linear-gradient(90deg,oklch(13% .012 170),oklch(10% .010 170))!important;color:var(--ink-2)!important}
.quick-chips{padding:14px 20px;background:oklch(11% .010 170)!important}
.chip{padding:9px 16px;border-radius:999px;background:oklch(16% .012 170);border-color:oklch(70% .1 75 / .14)}
.chip::before{margin-right:6px}.chip:nth-child(1)::before{content:'🧭'}.chip:nth-child(2)::before{content:'🏨'}.chip:nth-child(3)::before{content:'🥢'}.chip:nth-child(4)::before{content:'✍️'}
.empty-state{background:radial-gradient(circle at center,oklch(72% .16 75 / .055),transparent 36%)}
.empty-state .es-icon{font-size:64px;opacity:.62;filter:drop-shadow(0 16px 34px oklch(0% 0 0 / .45))}
.empty-state .es-title{font-size:22px;color:var(--ink);font-weight:800}
.chat-input-area{padding:18px 22px;background:linear-gradient(180deg,oklch(11% .010 170),oklch(8% .008 170));box-shadow:0 -18px 50px oklch(0% 0 0 / .28)}
#msg-input{min-height:56px;border-radius:18px;background:oklch(12% .010 170);border-color:oklch(76% .12 75 / .18)}
#send-btn{min-height:56px;border-radius:16px;padding-inline:28px}
#new-chat-btn{min-height:56px;border-radius:16px!important}
.plan-layout,.mkt-layout,.training-layout,.profile-layout{background:linear-gradient(180deg,oklch(8% .008 170),oklch(6% .006 170))}
.plan-sidebar,.mkt-form-panel,.training-sidebar,.profile-sidebar{background:linear-gradient(180deg,oklch(12% .010 170),oklch(9% .008 170));box-shadow:12px 0 40px oklch(0% 0 0 / .22)}
.field label,.sidebar-section h3,.mkt-history h3,.training-progress-label{color:var(--ink-2)}
.field input,.field select,.settings-card input,.settings-card select,.pf-modal input,.pf-modal select{min-height:46px;border-radius:14px;background:oklch(11% .010 170);border-color:oklch(72% .1 75 / .14)}
.tag{padding:7px 14px;border-radius:999px}
.plan-plan-btn,.mkt-generate-btn{min-height:58px;border-radius:16px;font-size:16px;box-shadow:0 16px 32px oklch(72% .16 75 / .18)}
.mkt-preview-card.empty::before{content:'生成后的文案会在这里形成可复制的营销稿、短视频脚本或海报文案';display:block;max-width:360px;text-align:center;color:var(--ink-2)}
.mkt-preview-card.empty{color:transparent;background:radial-gradient(circle at center,oklch(72% .16 75 / .06),transparent 42%),var(--paper-3)}
.profile-empty,.mkt-preview-card.empty{border:1px dashed oklch(76% .12 75 / .2)}
button:focus-visible,.chip:focus-visible,.tag:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media(max-width:1000px){.hero{grid-template-columns:1fr;overflow:auto}.hero-stage{min-height:460px}.hero-features{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.top-nav{padding:0 12px}.nav-subtitle,.nav-status{display:none}.nav-tab{min-width:auto;padding:7px 9px}.hero{padding:28px 18px}.hero-brand{font-size:3rem}.hero-search{flex-direction:column}.hero-search::before{display:none}.hero-search button{width:100%}.hero-features{grid-template-columns:1fr}.stage-metrics{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.hero-stage::before,.portal-showcase::before{animation:none}.page{transition:opacity 150ms ease}}
/* ===== Commercial Light Portal Theme ===== */
:root{
  --paper: oklch(98% 0.018 88);
  --paper-2: oklch(95% 0.022 88);
  --paper-3: oklch(100% 0.006 88);
  --paper-4: oklch(91% 0.030 88);
  --ink: oklch(20% 0.030 80);
  --ink-2: oklch(40% 0.030 80);
  --ink-subtle: oklch(52% 0.025 80);
  --rule: oklch(84% 0.028 88);
  --rule-2: oklch(89% 0.020 88);
  --rule-bright: oklch(74% 0.055 75);
  --accent: oklch(56% 0.18 38);
  --accent-2: oklch(64% 0.16 52);
  --accent-glow: oklch(64% 0.16 52 / 0.20);
  --accent-dim: oklch(93% 0.045 58);
  --success: oklch(52% 0.13 155);
  --focus-ring: oklch(60% 0.17 42 / 0.24);
  --shadow-sm: 0 1px 2px oklch(35% 0.05 60 / .08);
  --shadow-md: 0 14px 32px oklch(35% 0.05 60 / .12);
  --shadow-lg: 0 28px 70px oklch(35% 0.05 60 / .18);
  --shadow-glow: 0 18px 45px oklch(62% 0.16 52 / .18);
}
body{background:var(--paper);color:var(--ink)}
body.portal-mode .top-nav{display:none}
.top-nav{height:68px;background:oklch(100% 0.006 88 / .92);border-bottom:1px solid var(--rule);box-shadow:0 14px 40px oklch(35% .05 70 / .08)}
.nav-logo{color:white;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 12px 28px oklch(60% .16 44 / .22)}
.nav-title{color:var(--accent)}
.nav-subtitle,.nav-tab,.nav-status-text{color:var(--ink-2)}
.nav-tab:hover{background:var(--accent-dim);color:var(--accent)}
.nav-tab.active{color:var(--accent)}
.nav-status{background:var(--paper-3);border-color:var(--rule);box-shadow:var(--shadow-sm)}
.nav-settings-btn{color:var(--ink-2);border-color:var(--rule);background:var(--paper-3)}
.pages-container{background:linear-gradient(180deg,oklch(99% .018 88),oklch(94% .028 88))}
.page:not(.page-home){background:linear-gradient(180deg,oklch(99% .018 88),oklch(95% .026 88))}
.portal-hero{position:relative;min-height:100%;padding:28px clamp(22px,5vw,72px) 52px;background:radial-gradient(circle at 8% 10%,oklch(85% .11 45 / .38),transparent 28%),radial-gradient(circle at 86% 14%,oklch(82% .10 160 / .30),transparent 30%),linear-gradient(135deg,oklch(99% .018 88),oklch(94% .034 88))}
.portal-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 0 54%,oklch(62% .16 38 / .08) 54% 55%,transparent 55% 100%);pointer-events:none}
.portal-header{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 auto 44px;max-width:1180px}
.portal-logo{display:flex;align-items:center;gap:12px;font-weight:900;color:var(--accent);font-size:22px}
.portal-logo-mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;box-shadow:var(--shadow-md)}
.portal-nav{display:flex;gap:10px;align-items:center;color:var(--ink-2);font-size:14px}
.portal-nav span{padding:8px 12px;border-radius:999px;background:oklch(100% 0 0 / .56);border:1px solid var(--rule)}
.portal-main{position:relative;z-index:2;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.9fr);gap:48px;align-items:center}
.portal-main>div{min-width:0}
.portal-kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;padding:8px 14px;border-radius:999px;background:oklch(100% 0 0 / .72);border:1px solid oklch(76% .08 55);color:var(--accent);font-size:13px;font-weight:800;letter-spacing:.08em}
.portal-title{margin:0;font-family:var(--font-display);font-size:clamp(3.4rem,7vw,6.8rem);line-height:.96;letter-spacing:-.04em;color:var(--ink);text-wrap:balance}
.portal-title strong{display:block;color:var(--accent);font-weight:800}
.portal-desc{max-width:680px;margin:26px 0 0;color:var(--ink-2);font-size:18px;line-height:1.9}
.portal-hot-window{position:relative;width:100%;max-width:720px;margin:28px 0 0;border-radius:26px;overflow:hidden;background:oklch(100% 0 0 / .70);border:1px solid oklch(82% .050 70);box-shadow:var(--shadow-md)}
.portal-hot-window::before,.portal-hot-window::after{content:'';position:absolute;top:0;bottom:0;width:74px;z-index:3;pointer-events:none}
.portal-hot-window::before{left:0;background:linear-gradient(90deg,oklch(99% .018 88),transparent)}
.portal-hot-window::after{right:0;background:linear-gradient(270deg,oklch(99% .018 88),transparent)}
.portal-hot-head{position:relative;z-index:4;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px 10px}
.portal-hot-title{font-size:15px;font-weight:900;color:var(--ink);letter-spacing:.02em}
.portal-hot-note{font-size:12px;font-weight:800;color:var(--accent);padding:6px 10px;border-radius:999px;background:var(--accent-dim)}
.portal-hot-track{display:flex;width:max-content;gap:14px;padding:4px 18px 18px;animation:hotMarqueeLtr 34s linear infinite;will-change:transform}
.portal-hot-window:hover .portal-hot-track{animation-play-state:paused}
.hot-card{position:relative;flex:0 0 178px;height:126px;border:0;border-radius:22px;overflow:hidden;box-shadow:0 16px 34px oklch(44% .08 60 / .18);background:var(--hot-bg);isolation:isolate;text-align:left;cursor:pointer;font-family:var(--font-body);transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out)}
.hot-card:hover{transform:translateY(-4px);box-shadow:0 22px 44px oklch(44% .08 60 / .24)}
.hot-card:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
.hot-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 22% 20%,oklch(100% 0 0 / .65),transparent 26%),linear-gradient(180deg,transparent 25%,oklch(22% .05 48 / .72));z-index:1}
.hot-card::after{content:attr(data-icon);position:absolute;right:12px;top:8px;font-size:38px;filter:drop-shadow(0 8px 14px oklch(15% .02 60 / .24));z-index:2}
.hot-card .hot-tag{position:absolute;left:12px;top:10px;z-index:2;padding:5px 8px;border-radius:999px;background:oklch(100% 0 0 / .78);color:var(--accent);font-size:11px;font-weight:900}
.hot-card strong{position:absolute;left:12px;right:12px;bottom:28px;z-index:2;color:white;font-size:17px;letter-spacing:.01em;text-shadow:0 2px 10px oklch(0% 0 0 / .32)}
.hot-card span:last-child{position:absolute;left:12px;right:12px;bottom:10px;z-index:2;color:oklch(96% .015 85);font-size:12px;font-weight:600;text-shadow:0 2px 8px oklch(0% 0 0 / .28)}
.hot-card.scenic{--hot-bg:linear-gradient(135deg,oklch(72% .15 150),oklch(58% .12 205) 46%,oklch(84% .09 95))}
.hot-card.culture{--hot-bg:linear-gradient(135deg,oklch(72% .16 35),oklch(82% .12 75) 52%,oklch(58% .11 20))}
.hot-card.food{--hot-bg:linear-gradient(135deg,oklch(78% .16 58),oklch(68% .18 32) 50%,oklch(92% .09 88))}
.hot-card.night{--hot-bg:linear-gradient(135deg,oklch(54% .13 255),oklch(67% .13 305) 48%,oklch(78% .11 45))}
.hot-card.hotel{--hot-bg:linear-gradient(135deg,oklch(72% .09 205),oklch(88% .07 85) 50%,oklch(64% .12 165))}
.hot-card.market{--hot-bg:linear-gradient(135deg,oklch(72% .15 18),oklch(82% .12 52) 48%,oklch(70% .13 165))}
@keyframes hotMarqueeLtr{from{transform:translateX(-50%)}to{transform:translateX(0)}}
.portal-detail-overlay{position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;padding:24px;background:oklch(18% .035 50 / .42);backdrop-filter:blur(16px)}
.portal-detail-overlay.show{display:flex}
.portal-detail-card{width:min(980px,96vw);max-height:90vh;overflow:auto;border-radius:28px;background:var(--paper-3);border:1px solid oklch(82% .050 70);box-shadow:0 34px 90px oklch(18% .04 50 / .32)}
.portal-detail-media{position:relative;min-height:300px;background:linear-gradient(135deg,oklch(90% .04 80),oklch(78% .08 165));overflow:hidden}
.portal-detail-media img{width:100%;height:360px;object-fit:cover;display:block}
.portal-detail-close{position:absolute;right:18px;top:18px;width:42px;height:42px;border:0;border-radius:50%;background:oklch(100% 0 0 / .88);color:var(--ink);font-size:22px;cursor:pointer;box-shadow:var(--shadow-sm)}
.portal-detail-close:hover{background:white;color:var(--accent)}
.portal-detail-body{padding:26px clamp(20px,4vw,36px) 34px}
.portal-detail-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}
.portal-detail-tag{display:inline-flex;margin-bottom:10px;padding:6px 10px;border-radius:999px;background:var(--accent-dim);color:var(--accent);font-size:12px;font-weight:900}
.portal-detail-title{margin:0;font-family:var(--font-display);font-size:clamp(2rem,4vw,3.3rem);line-height:1.05;color:var(--ink);letter-spacing:-.03em}
.portal-detail-score{min-width:96px;padding:12px 14px;border-radius:18px;background:oklch(97% .030 78);border:1px solid var(--rule);text-align:center;color:var(--accent);font-weight:900}
.portal-detail-score span{display:block;margin-top:3px;color:var(--ink-subtle);font-size:12px;font-weight:700}
.portal-detail-desc{margin:0;color:var(--ink-2);font-size:16px;line-height:1.85}
.portal-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}
.portal-detail-section{padding:18px;border-radius:20px;background:oklch(98% .012 88);border:1px solid var(--rule)}
.portal-detail-section h3{margin:0 0 12px;color:var(--ink);font-size:17px}
.portal-detail-list{margin:0;padding:0;list-style:none;display:grid;gap:10px;color:var(--ink-2);font-size:14px;line-height:1.65}
.portal-detail-list li{padding-left:18px;position:relative}
.portal-detail-list li::before{content:'';position:absolute;left:0;top:.72em;width:7px;height:7px;border-radius:50%;background:var(--accent)}
.portal-review{padding:12px 0;border-bottom:1px solid var(--rule)}
.portal-review:last-child{border-bottom:0}
.portal-review strong{display:block;color:var(--ink);font-size:14px}.portal-review span{display:block;margin-top:4px;color:var(--ink-2);font-size:13px;line-height:1.65}
.portal-detail-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.portal-detail-action{border:0;border-radius:16px;padding:13px 18px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;font-size:14px;font-weight:900;cursor:pointer;font-family:var(--font-body)}
.portal-detail-action.secondary{background:var(--accent-dim);color:var(--accent);border:1px solid oklch(78% .08 55)}
.portal-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
.portal-btn{border:none;min-height:56px;padding:0 26px;border-radius:16px;font-size:16px;font-weight:800;letter-spacing:.02em;cursor:pointer;font-family:var(--font-body);transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out),background var(--dur-short) var(--ease-out)}
.portal-btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;box-shadow:var(--shadow-glow)}
.portal-btn.secondary{background:var(--paper-3);color:var(--accent);border:1px solid oklch(78% .08 55);box-shadow:var(--shadow-sm)}
.portal-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.portal-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:38px;max-width:720px}
.portal-proof-item{padding:16px;border-radius:18px;background:oklch(100% 0 0 / .68);border:1px solid var(--rule);box-shadow:var(--shadow-sm)}
.portal-proof-item strong{display:block;color:var(--accent);font-size:26px}.portal-proof-item span{display:block;margin-top:4px;color:var(--ink-subtle);font-size:13px}
.portal-showcase{position:relative;min-height:580px;border-radius:34px;background:linear-gradient(145deg,oklch(100% .006 88),oklch(94% .032 88));border:1px solid oklch(83% .045 70);box-shadow:var(--shadow-lg);overflow:hidden}
.portal-showcase::before{content:'';position:absolute;inset:-20%;background:conic-gradient(from 180deg,oklch(64% .16 52 / .18),transparent,oklch(52% .13 155 / .18),transparent);animation:stageSpin 20s linear infinite}
.portal-showcase::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 18% 16%,oklch(78% .13 55 / .18),transparent 28%),radial-gradient(circle at 82% 78%,oklch(70% .12 165 / .16),transparent 30%);pointer-events:none}
.portal-card{position:absolute;inset:18px;border-radius:28px;background:oklch(100% 0 0 / .88);border:1px solid var(--rule);padding:24px;display:flex;flex-direction:column;gap:18px;z-index:1;backdrop-filter:blur(18px)}
.portal-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.portal-card-label{font-size:12px;color:var(--accent);font-weight:900;letter-spacing:.12em}
.portal-card-title{margin-top:8px;font-family:var(--font-display);font-size:34px;font-weight:800;color:var(--ink)}
.portal-chip{padding:7px 12px;border-radius:999px;background:var(--accent-dim);color:var(--accent);font-size:12px;font-weight:800}
.portal-dashboard-time{margin-top:6px;color:var(--ink-subtle);font-size:12px;font-weight:800;letter-spacing:.04em}
.ops-kpi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.ops-kpi{position:relative;padding:14px;border-radius:20px;background:linear-gradient(160deg,oklch(100% 0 0 / .92),oklch(96% .018 88 / .78));border:1px solid var(--rule);box-shadow:var(--shadow-sm);overflow:hidden;cursor:pointer;text-align:left;font-family:var(--font-body);transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out),border-color var(--dur-short) var(--ease-out)}
.ops-kpi:hover,.ops-kpi:focus-visible,.ops-trend-item:hover,.ops-trend-item:focus-visible,.ops-task:hover,.ops-task:focus-visible,.ops-brief:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);border-color:oklch(75% .09 55)}
.ops-kpi::after{content:'';position:absolute;right:-18px;top:-22px;width:70px;height:70px;border-radius:50%;background:var(--kpi-glow,oklch(72% .12 55 / .14))}
.ops-kpi-label{position:relative;z-index:1;font-size:11px;color:var(--ink-subtle);font-weight:900;letter-spacing:.08em}
.ops-kpi-value{position:relative;z-index:1;margin-top:8px;font-size:28px;line-height:1;font-weight:950;color:var(--ink);letter-spacing:-.04em}
.ops-kpi-trend{position:relative;z-index:1;margin-top:7px;font-size:12px;color:var(--accent);font-weight:900}
.ops-kpi:nth-child(2){--kpi-glow:oklch(68% .14 165 / .16)}.ops-kpi:nth-child(3){--kpi-glow:oklch(74% .14 35 / .14)}
.ops-board-main{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;min-height:0;flex:1}
.ops-live-panel,.ops-task-panel{border-radius:24px;background:oklch(100% 0 0 / .72);border:1px solid var(--rule);box-shadow:var(--shadow-sm);padding:16px;min-width:0;overflow:hidden}
.ops-panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.ops-panel-title{font-size:14px;font-weight:950;color:var(--ink);letter-spacing:.02em}.ops-live-dot{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:900;color:var(--accent);padding:5px 9px;border-radius:999px;background:var(--accent-dim)}
.ops-live-dot::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 oklch(64% .14 50 / .38);animation:opsPulse 1.8s infinite}
@keyframes opsPulse{70%{box-shadow:0 0 0 10px oklch(64% .14 50 / 0)}100%{box-shadow:0 0 0 0 oklch(64% .14 50 / 0)}}
.ops-trend-list{display:grid;gap:12px}
.ops-trend-item{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;border:0;background:transparent;text-align:left;font-family:var(--font-body);cursor:pointer;border-radius:16px;padding:4px;transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out),background var(--dur-short) var(--ease-out)}
.ops-trend-item:hover{background:oklch(98% .014 88 / .72)}
.ops-trend-rank{width:26px;height:26px;border-radius:10px;display:grid;place-items:center;background:oklch(97% .034 78);color:var(--accent);font-size:12px;font-weight:950}
.ops-trend-name{min-width:0;color:var(--ink);font-size:13px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ops-trend-meta{font-size:11px;color:var(--ink-subtle);margin-top:4px}
.ops-trend-score{font-size:12px;color:var(--accent);font-weight:950}
.ops-bar{grid-column:2/4;height:7px;border-radius:999px;background:oklch(91% .018 88);overflow:hidden}
.ops-bar span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent-2));animation:opsGrow 900ms var(--ease-out) both}
@keyframes opsGrow{from{width:12%}}
.ops-task-list{display:grid;gap:11px}
.ops-task{display:flex;gap:10px;align-items:flex-start;padding:11px;border-radius:16px;background:oklch(98% .014 88 / .86);border:1px solid oklch(86% .04 76 / .72);font-family:var(--font-body);text-align:left;cursor:pointer;transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out),border-color var(--dur-short) var(--ease-out)}
.ops-task-icon{width:30px;height:30px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;font-size:15px;box-shadow:var(--shadow-sm);flex-shrink:0}
.ops-task b{display:block;color:var(--ink);font-size:13px;margin-bottom:3px}.ops-task span{display:block;color:var(--ink-subtle);font-size:12px;line-height:1.45}
.ops-brief{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:22px;background:linear-gradient(135deg,oklch(20% .045 62),oklch(34% .08 164));color:white;box-shadow:0 18px 44px oklch(28% .06 80 / .2);cursor:pointer;transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out)}
.ops-brief strong{display:block;font-size:15px}.ops-brief span{display:block;margin-top:4px;color:oklch(94% .015 88 / .82);font-size:12px}.ops-brief button{border:0;border-radius:14px;padding:10px 14px;background:oklch(100% 0 0 / .92);color:var(--accent);font-weight:950;cursor:pointer;font-family:var(--font-body);white-space:nowrap}
.ops-loading{display:grid;place-items:center;min-height:320px;color:var(--ink-subtle);font-size:14px;text-align:center;border-radius:24px;background:oklch(100% 0 0 / .62);border:1px dashed var(--rule)}
.ops-detail-overlay{display:none;position:fixed;inset:0;z-index:1250;align-items:center;justify-content:center;padding:22px;background:rgba(15,23,42,.56);backdrop-filter:blur(5px)}
.ops-detail-overlay.open{display:flex}.ops-detail-card{width:min(620px,94vw);max-height:86vh;overflow:auto;border-radius:28px;background:var(--paper-3);border:1px solid var(--rule-bright);box-shadow:0 28px 86px rgba(0,0,0,.34);padding:24px;color:var(--ink);position:relative}.ops-detail-close{position:absolute;right:16px;top:14px;width:34px;height:34px;border:0;border-radius:50%;background:rgba(0,0,0,.08);color:var(--ink);font-size:20px;cursor:pointer}.ops-detail-kicker{font-size:12px;font-weight:950;letter-spacing:.1em;color:var(--accent);margin-bottom:10px}.ops-detail-title{font-family:var(--font-display);font-size:30px;line-height:1.15;margin:0 36px 12px 0}.ops-detail-meta{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}.ops-detail-meta span{padding:6px 10px;border-radius:999px;background:var(--accent-dim);color:var(--accent);font-size:12px;font-weight:900}.ops-detail-desc{font-size:14px;line-height:1.8;color:var(--ink-2);margin:0 0 16px}.ops-detail-list{display:grid;gap:9px;margin:0;padding:0;list-style:none}.ops-detail-list li{padding:10px 12px;border-radius:14px;background:oklch(98% .014 88);border:1px solid var(--rule);font-size:13px;line-height:1.55;color:var(--ink-2)}.ops-detail-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.ops-detail-actions button,.ops-detail-actions a{border:0;text-decoration:none;border-radius:14px;padding:11px 14px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;font-weight:950;font-family:var(--font-body);cursor:pointer}.ops-detail-actions .secondary{background:var(--accent-dim);color:var(--accent);border:1px solid oklch(75% .09 55)}
.portal-visual{position:relative;flex:1;border-radius:24px;background:linear-gradient(135deg,oklch(95% .026 88),oklch(89% .060 160));border:1px solid var(--rule);overflow:hidden}
.portal-visual::before{content:'';position:absolute;inset:14%;border:2px solid oklch(66% .12 48 / .22);border-radius:44% 56% 50% 50%;transform:rotate(-12deg)}
.portal-node{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 10px oklch(64% .16 52 / .14)}
.portal-node.a{left:24%;top:36%}.portal-node.b{left:66%;top:26%}.portal-node.c{left:76%;top:64%}.portal-node.d{left:36%;top:72%}
.portal-route{position:absolute;left:22px;right:22px;bottom:22px;padding:16px;border-radius:20px;background:oklch(100% 0 0 / .84);border:1px solid var(--rule);box-shadow:var(--shadow-md);backdrop-filter:blur(12px)}
.portal-route h3{margin:0 0 12px;font-size:16px;color:var(--ink)}
.portal-route p{margin:8px 0;color:var(--ink-2);font-size:13px}
.portal-entry-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin:42px auto 0;max-width:1180px;position:relative;z-index:2}
.portal-entry{padding:20px;border-radius:22px;background:oklch(100% 0 0 / .74);border:1px solid var(--rule);box-shadow:var(--shadow-sm);cursor:pointer;transition:all var(--dur-short) var(--ease-out);text-align:left;font-family:var(--font-body)}
.portal-entry:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:oklch(72% .10 55)}
.portal-entry b{display:block;margin-bottom:8px;color:var(--ink);font-size:17px}.portal-entry span{color:var(--ink-subtle);font-size:13px;line-height:1.6}
.community-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px;min-height:100%;padding:24px}
.community-main,.community-side{min-width:0;display:flex;flex-direction:column;gap:18px}
.community-hero{padding:24px;border-radius:26px;background:linear-gradient(135deg,oklch(100% 0 0 / .82),oklch(94% .034 88));border:1px solid var(--rule);box-shadow:var(--shadow-md)}
.community-hero h2{margin:0;font-family:var(--font-display);font-size:32px;color:var(--ink);letter-spacing:-.02em}
.community-hero p{margin:10px 0 0;color:var(--ink-2);line-height:1.8}
.community-compose{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px;border-radius:22px;background:var(--paper-3);border:1px solid var(--rule);box-shadow:var(--shadow-sm)}
.community-compose input,.community-compose textarea{width:100%;border:1px solid var(--rule);border-radius:14px;background:oklch(99% .008 88);color:var(--ink);padding:12px 14px;font-family:var(--font-body);font-size:14px}
.community-compose textarea{grid-column:1/-1;min-height:88px;resize:vertical}
.community-compose button{justify-self:start;border:0;border-radius:14px;padding:12px 18px;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;font-weight:900;cursor:pointer;font-family:var(--font-body)}
.community-filter{display:flex;gap:10px;flex-wrap:wrap}
.community-filter button{border:1px solid var(--rule);border-radius:999px;background:var(--paper-3);color:var(--ink-2);padding:8px 14px;font-weight:800;cursor:pointer}
.community-filter button.active,.community-filter button:hover{background:var(--accent-dim);color:var(--accent);border-color:oklch(75% .09 55)}
.community-feed{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.community-post{overflow:hidden;border-radius:24px;background:var(--paper-3);border:1px solid var(--rule);box-shadow:var(--shadow-sm);cursor:pointer;transition:transform var(--dur-short) var(--ease-out),box-shadow var(--dur-short) var(--ease-out)}
.community-post:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
.community-post-img{height:170px;background:linear-gradient(135deg,oklch(78% .13 45),oklch(72% .10 165));position:relative;overflow:hidden}
.community-post-img img{width:100%;height:100%;object-fit:cover;display:block}
.community-post-img::after{content:attr(data-tag);position:absolute;left:14px;top:14px;padding:6px 10px;border-radius:999px;background:oklch(100% 0 0 / .84);color:var(--accent);font-size:12px;font-weight:900}
.community-post-body{padding:16px}
.community-post h3{margin:0;color:var(--ink);font-size:18px;line-height:1.35}
.community-post p{margin:8px 0 12px;color:var(--ink-2);font-size:13px;line-height:1.7}
.community-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--ink-subtle);font-size:12px}
.community-actions{display:flex;gap:10px}
.community-actions button{border:0;background:var(--accent-dim);color:var(--accent);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:900;cursor:pointer}
.community-detail-modal{display:none;position:fixed;inset:0;z-index:620;align-items:center;justify-content:center;background:rgba(15,23,42,.58);backdrop-filter:blur(4px);padding:22px}
.community-detail-modal.open{display:flex}
.community-detail-inner{position:relative;width:min(760px,94vw);max-height:88vh;overflow-y:auto;background:var(--paper-3);border:1px solid var(--rule-bright);border-radius:26px;box-shadow:0 24px 70px rgba(0,0,0,.28);color:var(--ink)}
.community-detail-close{position:absolute;right:14px;top:12px;width:34px;height:34px;border:0;border-radius:50%;background:rgba(0,0,0,.46);color:white;font-size:20px;cursor:pointer;z-index:2}
.community-detail-hero{height:260px;background:linear-gradient(135deg,oklch(78% .13 45),oklch(72% .10 165));overflow:hidden;border-radius:26px 26px 0 0}
.community-detail-hero img{width:100%;height:100%;object-fit:cover;display:block}
.community-detail-body{padding:24px 28px 28px}
.community-detail-tag{display:inline-flex;margin-bottom:12px;padding:6px 12px;border-radius:999px;background:var(--accent-dim);color:var(--accent);font-size:12px;font-weight:900}
.community-detail-body h3{margin:0 0 10px;color:var(--ink);font-size:24px;line-height:1.35}
.community-detail-meta{display:flex;gap:10px;flex-wrap:wrap;color:var(--ink-subtle);font-size:13px;margin-bottom:18px}
.community-detail-content{padding:16px 18px;border-radius:18px;background:oklch(98% .012 88);border:1px solid var(--rule);color:var(--ink-2);font-size:15px;line-height:1.85;white-space:pre-wrap}
.community-detail-note{margin-top:14px;color:var(--ink-subtle);font-size:12px;line-height:1.7}
.community-detail-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.community-detail-actions button,.community-detail-actions a{border:0;border-radius:999px;padding:10px 14px;font-size:13px;font-weight:900;text-decoration:none;cursor:pointer}
.community-detail-actions .primary{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff}
.community-detail-actions .ghost{background:var(--accent-dim);color:var(--accent)}
.community-panel{padding:18px;border-radius:22px;background:var(--paper-3);border:1px solid var(--rule);box-shadow:var(--shadow-sm)}
.community-panel h3{margin:0 0 14px;color:var(--ink);font-size:17px}
.market-refresh-btn{border:1px solid var(--rule);border-radius:999px;background:var(--paper-3);color:var(--accent);padding:7px 12px;font-size:12px;font-weight:800;cursor:pointer;font-family:var(--font-body);transition:all var(--dur-short) var(--ease-out)}
.market-refresh-btn:hover{border-color:var(--accent);background:var(--accent-dim)}
.market-refresh-btn.loading{pointer-events:none;opacity:.62}
.rank-list{display:grid;gap:10px}
.rank-item{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:10px;border-radius:14px;background:oklch(98% .012 88);border:1px solid var(--rule);cursor:pointer}
.rank-no{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--accent-dim);color:var(--accent);font-weight:900}
.rank-title{font-size:13px;color:var(--ink);font-weight:800;line-height:1.35}.rank-num{font-size:12px;color:var(--ink-subtle);font-weight:800}
.platform-hot{display:grid;gap:10px}
.platform-hot a{display:block;text-decoration:none;padding:12px;border-radius:16px;background:linear-gradient(135deg,oklch(99% .014 88),oklch(95% .028 88));border:1px solid var(--rule);color:var(--ink)}
.platform-hot b{display:block;font-size:14px}.platform-hot span{display:block;margin-top:5px;color:var(--ink-subtle);font-size:12px;line-height:1.5}
.platform-hot .platform-status{padding:12px;border-radius:16px;background:oklch(98% .012 88);border:1px dashed var(--rule);color:var(--ink-2);font-size:12px;line-height:1.6}
.platform-hot .platform-meta{display:flex;gap:8px;align-items:center;margin-bottom:6px;color:var(--accent);font-size:12px;font-weight:900}
.chat-layout,.plan-layout,.mkt-layout,.training-layout,.profile-layout{background:linear-gradient(180deg,oklch(99% .018 88),oklch(95% .026 88))}
.location-bar,.quick-chips,.chat-input-area,.plan-sidebar,.mkt-form-panel,.training-sidebar,.profile-sidebar{background:oklch(100% 0.006 88 / .92)!important;color:var(--ink-2)!important;border-color:var(--rule)!important;box-shadow:var(--shadow-sm)}
.chip,.tag,.task-btn,.ptab,.map-btn{background:var(--paper-3);color:var(--ink-2);border-color:var(--rule)}
.chip:hover,.tag:hover,.task-btn:hover,.ptab:hover,.map-btn:hover{background:var(--accent-dim);color:var(--accent);border-color:oklch(75% .09 55)}
.empty-state{background:radial-gradient(circle at center,oklch(86% .08 55 / .25),transparent 42%)}
.msg.agent .bubble,.mkt-preview-card,.training-stage,.major-card,.pf-card,.plan-route-summary,.plan-action-bar,.plan-ticket-section{background:var(--paper-3);border-color:var(--rule);box-shadow:var(--shadow-sm);color:var(--ink)}
.msg.user .bubble,.btn-primary,.plan-plan-btn,.mkt-generate-btn,.ptc-buy,.pf-btn-save{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white}
.field input,.field select,#msg-input,.settings-card input,.settings-card select,.pf-modal input,.pf-modal select{background:var(--paper-3);color:var(--ink);border-color:var(--rule)}
.plan-content,.mkt-preview-card,.training-content,.profile-content{color:var(--ink)}
.xhs-layout{display:grid;grid-template-columns:300px 1fr;min-height:100%;background:linear-gradient(180deg,oklch(99% .018 88),oklch(95% .026 88))}
.xhs-sidebar{padding:22px;border-right:1px solid var(--rule);background:oklch(100% 0.006 88 / .92);overflow-y:auto}
.xhs-sidebar h3{font-size:15px;color:var(--ink);margin-bottom:8px}
.xhs-sidebar p{font-size:12px;color:var(--ink-subtle);line-height:1.7;margin-bottom:16px}
.xhs-main{padding:26px;overflow-y:auto}
.xhs-toolbar{display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
.xhs-search{flex:1;min-width:240px;padding:11px 14px;border:1px solid var(--rule);border-radius:var(--radius-sm);background:var(--paper-3);color:var(--ink);font-family:var(--font-body)}
.xhs-search:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--focus-ring)}
.xhs-summary{font-size:13px;color:var(--ink-subtle);margin-bottom:14px}
.xhs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.xhs-card{padding:18px;border:1px solid var(--rule);border-radius:var(--radius-md);background:var(--paper-3);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:12px;transition:all var(--dur-short) var(--ease-out);cursor:pointer}
.xhs-card:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:var(--shadow-md)}
.xhs-card-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.xhs-badge{font-size:11px;padding:4px 9px;border-radius:999px;background:var(--accent-dim);color:var(--accent);white-space:nowrap}
.xhs-score{font-size:12px;color:var(--ink-subtle)}
.xhs-card h3{font-size:17px;line-height:1.45;color:var(--ink)}
.xhs-meta{font-size:12px;color:var(--ink-subtle);display:flex;gap:8px;flex-wrap:wrap}
.xhs-card p{font-size:13px;line-height:1.75;color:var(--ink-2)}
.xhs-tags{display:flex;gap:6px;flex-wrap:wrap}
.xhs-tag{font-size:11px;padding:4px 8px;border:1px solid var(--rule);border-radius:999px;color:var(--ink-subtle);background:oklch(100% 0 0 / .42)}
.xhs-list{margin:0;padding-left:18px;color:var(--ink-subtle);font-size:12px;line-height:1.7}
.xhs-actions{display:flex;gap:8px;margin-top:auto;flex-wrap:wrap}
.xhs-actions a,.xhs-actions button{padding:8px 12px;border-radius:var(--radius-sm);border:1px solid var(--rule);background:transparent;color:var(--ink-2);font-size:12px;font-family:var(--font-body);cursor:pointer;text-decoration:none;transition:all var(--dur-short) var(--ease-out)}
.xhs-actions a.primary,.xhs-actions button.primary{background:var(--accent);color:#1a1a1a;border-color:var(--accent);font-weight:600}
.xhs-actions a:hover,.xhs-actions button:hover{border-color:var(--accent);color:var(--accent)}
.xhs-actions a.primary:hover,.xhs-actions button.primary:hover{color:#1a1a1a;background:var(--accent-2)}
.xhs-empty{padding:48px;text-align:center;color:var(--ink-subtle);border:1px dashed var(--rule);border-radius:var(--radius-md);background:var(--paper-3)}
.xhs-compliance{margin-top:18px;padding:12px;border:1px solid var(--rule);border-radius:var(--radius-sm);font-size:12px;color:var(--ink-subtle);line-height:1.7;background:var(--paper-3)}
@media(max-width:980px){.xhs-layout{grid-template-columns:1fr}.xhs-sidebar{border-right:none;border-bottom:1px solid var(--rule)}}
@media(max-width:980px){.portal-main{grid-template-columns:1fr}.portal-showcase{min-height:620px}.portal-hot-window{max-width:100%}.community-layout{grid-template-columns:1fr}.ops-board-main{grid-template-columns:1fr}.ops-kpi-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:640px){.portal-card{padding:18px;inset:12px}.portal-card-title{font-size:28px}.ops-kpi-grid{grid-template-columns:1fr}.ops-board-main{grid-template-columns:1fr}.portal-showcase{min-height:920px}.ops-brief{align-items:flex-start;flex-direction:column}.ops-brief button{width:100%}}
@media(max-width:620px){.portal-hero{padding:18px}.portal-header{align-items:flex-start}.portal-nav{display:none}.portal-title{font-size:3.2rem}.portal-actions{flex-direction:column}.portal-btn{width:100%}.portal-proof{grid-template-columns:1fr}.portal-entry-grid{grid-template-columns:1fr}.portal-showcase{min-height:520px}.portal-hot-head{align-items:flex-start;flex-direction:column}.hot-card{flex-basis:156px;height:118px}.portal-detail-grid{grid-template-columns:1fr}.portal-detail-top{flex-direction:column}.portal-detail-media img{height:260px}.community-layout{padding:16px}.community-compose{grid-template-columns:1fr}.community-feed{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.portal-showcase::before,.portal-hot-track,.ops-live-dot::before,.ops-bar span{animation:none}.portal-hot-track{transform:none}}
/* Hide old decorative overlays - replaced by bg.jpg */
.mountains-bg,.mountain-layer,.mt-back,.mt-mid,.mt-front,.light-rays,.plants-silhouette,.particles,.particle{display:none!important}
</style>
</head>
<body class="portal-mode">

<!-- ===== TOP NAV ===== -->
<div class="top-nav">
  <div class="nav-brand">
    <div class="nav-logo">灵</div>
    <span class="nav-title">智旅灵犀</span>
    <span class="nav-subtitle">SMART TOURISM</span>
  </div>
  <div class="nav-tabs" id="nav-tabs">
    <button class="nav-tab active" data-page="home">首页</button>
    <button class="nav-tab" data-page="chat">对话</button>
    <button class="nav-tab" data-page="plan">规划</button>
    <button class="nav-tab" data-page="marketing">营销</button>
    <button class="nav-tab" data-page="community">社区</button>
    <button class="nav-tab" data-page="training">实训</button>
    <button class="nav-tab" data-page="profile">我的</button>
  </div>
  <div class="nav-status">
    <span class="nav-status-dot" id="status-dot"></span>
    <span class="nav-status-text" id="status-text">就绪</span>
    <button class="nav-settings-btn" id="settings-btn" title="设置">⚙</button>
  </div>
</div>

<!-- ===== PAGES CONTAINER ===== -->
<div class="pages-container">

  <!-- PAGE 1: PORTAL ENTRY -->
  <div class="page page-home active" id="page-home">
    <section class="portal-hero" aria-labelledby="portal-title">
      <header class="portal-header">
        <div class="portal-logo" aria-label="智旅灵犀">
          <span class="portal-logo-mark">灵</span>
          <span>智旅灵犀</span>
        </div>
        <nav class="portal-nav" aria-label="产品能力">
          <span>文旅垂直大模型</span>
          <span>景区运营</span>
          <span>高校实训</span>
        </nav>
      </header>

      <div class="portal-main">
        <div>
          <div class="portal-kicker">COMMERCIAL TOURISM AI PLATFORM</div>
          <h1 class="portal-title" id="portal-title">
            文旅行业的
            <strong>智能增长入口</strong>
          </h1>
          <p class="portal-desc">
            面向景区、酒店、餐饮、文创与文旅院校，提供智能问答、行程规划、营销生成、专业实训与用户画像的一体化工作台。
          </p>
          <div class="portal-hot-window" aria-label="热门文旅内容滚动橱窗">
            <div class="portal-hot-head">
              <div class="portal-hot-title">热门灵感橱窗</div>
              <div class="portal-hot-note">景点 · 文创 · 餐食 · 夜游</div>
            </div>
            <div class="portal-hot-track">
              <button class="hot-card scenic" type="button" data-icon="🏞️" onclick="openPortalHotDetail('westlake')" tabindex="-1" aria-hidden="true"><span class="hot-tag">热门景点</span><strong>西湖宋韵线</strong><span>晨游、茶事、非遗讲解</span></button>
              <button class="hot-card culture" type="button" data-icon="🏺" onclick="openPortalHotDetail('liangzhu')" tabindex="-1" aria-hidden="true"><span class="hot-tag">文创作品</span><strong>良渚玉鸟礼盒</strong><span>博物馆联名伴手礼</span></button>
              <button class="hot-card food" type="button" data-icon="🍜" onclick="openPortalHotDetail('hangbang')" tabindex="-1" aria-hidden="true"><span class="hot-tag">热门餐食</span><strong>杭帮风味宴</strong><span>东坡肉、龙井虾仁</span></button>
              <button class="hot-card night" type="button" data-icon="🌉" onclick="openPortalHotDetail('canal')" tabindex="-1" aria-hidden="true"><span class="hot-tag">夜游活动</span><strong>运河灯影游</strong><span>夜航、市集、沉浸演艺</span></button>
              <button class="hot-card hotel" type="button" data-icon="🏨" onclick="openPortalHotDetail('courtyard')" tabindex="-1" aria-hidden="true"><span class="hot-tag">精选住宿</span><strong>江南庭院民宿</strong><span>亲子与情侣客群优选</span></button>
              <button class="hot-card market" type="button" data-icon="🧧" onclick="openPortalHotDetail('songmarket')" tabindex="-1" aria-hidden="true"><span class="hot-tag">非遗市集</span><strong>宋式雅集</strong><span>手作体验与国风打卡</span></button>
              <button class="hot-card scenic" type="button" data-icon="🏞️" onclick="openPortalHotDetail('westlake')"><span class="hot-tag">热门景点</span><strong>西湖宋韵线</strong><span>晨游、茶事、非遗讲解</span></button>
              <button class="hot-card culture" type="button" data-icon="🏺" onclick="openPortalHotDetail('liangzhu')"><span class="hot-tag">文创作品</span><strong>良渚玉鸟礼盒</strong><span>博物馆联名伴手礼</span></button>
              <button class="hot-card food" type="button" data-icon="🍜" onclick="openPortalHotDetail('hangbang')"><span class="hot-tag">热门餐食</span><strong>杭帮风味宴</strong><span>东坡肉、龙井虾仁</span></button>
              <button class="hot-card night" type="button" data-icon="🌉" onclick="openPortalHotDetail('canal')"><span class="hot-tag">夜游活动</span><strong>运河灯影游</strong><span>夜航、市集、沉浸演艺</span></button>
              <button class="hot-card hotel" type="button" data-icon="🏨" onclick="openPortalHotDetail('courtyard')"><span class="hot-tag">精选住宿</span><strong>江南庭院民宿</strong><span>亲子与情侣客群优选</span></button>
              <button class="hot-card market" type="button" data-icon="🧧" onclick="openPortalHotDetail('songmarket')"><span class="hot-tag">非遗市集</span><strong>宋式雅集</strong><span>手作体验与国风打卡</span></button>
            </div>
          </div>
          <div class="portal-actions" aria-label="进入功能页面">
            <button class="portal-btn primary" onclick="switchPage('chat')">进入智能工作台</button>
            <button class="portal-btn secondary" onclick="switchPage('plan')">查看行程规划</button>
          </div>
          <div class="portal-proof" aria-label="平台概览">
            <div class="portal-proof-item"><strong>5</strong><span>核心业务场景</span></div>
            <div class="portal-proof-item"><strong>4</strong><span>AI 能力模块</span></div>
            <div class="portal-proof-item"><strong>12</strong><span>实训任务模板</span></div>
          </div>
        </div>

        <aside class="portal-showcase" aria-label="今日运营看板">
          <div class="portal-card">
            <div class="portal-card-head">
              <div>
                <div class="portal-card-label">TODAY OPS DASHBOARD</div>
                <div class="portal-card-title">今日运营看板</div>
                <div class="portal-dashboard-time" id="ops-dashboard-time">正在读取真实运营数据...</div>
              </div>
              <span class="portal-chip">动态运营中</span>
            </div>
            <div class="ops-kpi-grid" id="ops-kpi-grid" aria-label="今日核心指标">
              <div class="ops-loading">正在聚合热点、灵感库和票务数据...</div>
            </div>
            <div class="ops-board-main">
              <section class="ops-live-panel" aria-label="实时热点">
                <div class="ops-panel-head">
                  <div class="ops-panel-title">实时热点机会</div>
                  <div class="ops-live-dot">LIVE</div>
                </div>
                <div class="ops-trend-list" id="ops-trend-list"></div>
              </section>
              <section class="ops-task-panel" aria-label="今日建议任务">
                <div class="ops-panel-head">
                  <div class="ops-panel-title">今日建议任务</div>
                  <div class="ops-live-dot">AI</div>
                </div>
                <div class="ops-task-list" id="ops-task-list"></div>
              </section>
            </div>
            <div class="ops-brief" id="ops-brief" role="button" tabindex="0">
              <div><strong id="ops-brief-title">今日重点正在生成...</strong><span id="ops-brief-desc">正在读取真实运营数据。</span></div>
              <button type="button" onclick="switchPage('marketing')">生成营销内容</button>
            </div>
          </div>
        </aside>
      </div>

      <div class="portal-entry-grid" aria-label="快捷进入">
        <button class="portal-entry" onclick="switchPage('chat')">
          <b>智能对话</b>
          <span>多模型文旅问答、景点讲解、酒店餐饮推荐。</span>
        </button>
        <button class="portal-entry" onclick="switchPage('plan')">
          <b>行程规划</b>
          <span>生成多日路线，并联动地图展示游览动线。</span>
        </button>
        <button class="portal-entry" onclick="switchPage('marketing')">
          <b>营销内容</b>
          <span>一键生成小红书、抖音、公众号等平台文案。</span>
        </button>
        <button class="portal-entry" onclick="switchPage('community')">
          <b>社区攻略</b>
          <span>融合小红书灵感与用户游记，筛选路线、餐食、打卡和避坑内容。</span>
        </button>
        <button class="portal-entry" onclick="switchPage('training')">
          <b>专业实训</b>
          <span>面向高校文旅专业的任务式 AI 实训场景。</span>
        </button>
      </div>
    </section>
  </div>

  <!-- PAGE 2: CHAT -->
  <div class="page page-chat" id="page-chat">
    <div class="chat-layout">
      <div class="chat-left">
        <div class="location-bar" style="display:flex;align-items:center;gap:8px;padding:6px 16px;border-bottom:1px solid var(--rule);background:var(--paper-2);font-size:12px;color:var(--ink-subtle)">
          <span id="location-icon" style="font-size:14px">📍</span>
          <span id="location-display" style="flex:1">定位中...</span>
          <button onclick="correctMyLocation()" style="background:none;border:1px solid var(--rule);color:var(--ink-subtle);padding:2px 10px;border-radius:var(--radius-sm);cursor:pointer;font-size:11px;font-family:var(--font-body)">修正</button>
          <button onclick="initUserLocation()" style="background:none;border:1px solid var(--rule);color:var(--ink-subtle);padding:2px 10px;border-radius:var(--radius-sm);cursor:pointer;font-size:11px;font-family:var(--font-body)">重新定位</button>
        </div>
        <div class="quick-chips">
          <button class="chip" data-msg="帮我规划一个3天的行程">行程规划</button>
          <button class="chip" data-msg="推荐几家性价比高的酒店">酒店推荐</button>
          <button class="chip" data-msg="附近有什么特色美食推荐">美食探索</button>
          <button class="chip" data-msg="帮我写一篇景区推广文案">营销文案</button>
        </div>
        <div class="chat-messages" id="chat-messages">
          <div class="empty-state">
            <div class="es-icon">🏯</div>
            <div class="es-title">欢迎使用智旅灵犀</div>
            <div class="es-desc">选择上方快捷场景或输入你的文旅需求</div>
          </div>
        </div>
        <div class="chat-input-area">
          <div class="input-row">
            <button class="btn" id="new-chat-btn" title="新建对话" style="padding:10px 14px;border:1px solid var(--rule);background:var(--paper-3);color:var(--ink-subtle);font-size:16px" onclick="newConversation()">+</button>
            <textarea id="msg-input" rows="2" placeholder="输入文旅需求... Enter 发送" maxlength="4000"></textarea>
            <button class="mic-btn" id="mic-btn" title="语音输入" onclick="toggleVoice()">🎤</button>
            <button class="btn btn-primary" id="send-btn">发送</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Ticket Purchase Modal Overlay -->
  <div class="ticket-overlay" id="ticket-overlay" style="display:none" onclick="if(event.target===this)closeTicket()">
    <div class="ticket-modal" id="ticket-modal">
      <!-- Dynamic content injected by JS -->
    </div>
  </div>

  <!-- PAGE 3: PLAN -->
  <div class="page page-plan" id="page-plan">
    <div class="plan-layout">
      <div class="plan-sidebar">
        <div class="sidebar-section">
          <h3>行程设置</h3>
          <div class="field">
            <label>目的地城市</label>
            <input type="text" id="plan-city" placeholder="杭州">
          </div>
          <div class="field">
            <label>出行天数</label>
            <select id="plan-days">
              <option value="1">1 天</option>
              <option value="2">2 天</option>
              <option value="3" selected>3 天</option>
              <option value="4">4 天</option>
              <option value="5">5 天</option>
              <option value="7">7 天</option>
            </select>
          </div>
          <div class="field">
            <label>预算范围</label>
            <select id="plan-budget">
              <option value="">不限</option>
              <option value="budget">经济型</option>
              <option value="mid">舒适型</option>
              <option value="luxury">豪华型</option>
            </select>
          </div>
          <div class="field">
            <label>同行关系</label>
            <select id="plan-relationship">
              <option value="couple">情侣/伴侣</option>
              <option value="family">亲子家庭</option>
              <option value="friends">朋友/闺蜜</option>
              <option value="senior">银发同行</option>
              <option value="business">商务差旅</option>
              <option value="team">团建团队</option>
              <option value="solo">独自旅行</option>
            </select>
          </div>
          <div class="field">
            <label>消费倾向</label>
            <select id="plan-consumption-goal">
              <option value="balanced">体验与预算平衡</option>
              <option value="save">控制预算</option>
              <option value="experience">愿意为特色体验付费</option>
              <option value="premium">品质升级</option>
              <option value="souvenir">纪念消费/文创伴手礼</option>
              <option value="social">社交分享/打卡传播</option>
            </select>
          </div>
          <div class="field">
            <label>路线节奏</label>
            <select id="plan-pace">
              <option value="slow">轻松慢游</option>
              <option value="medium" selected>适中节奏</option>
              <option value="packed">高密度特种兵</option>
            </select>
          </div>
        </div>
        <div class="sidebar-section">
          <h3>兴趣偏好</h3>
          <div class="tag-row" id="plan-tags">
            <span class="tag" data-tag="nature">自然风光</span>
            <span class="tag selected" data-tag="culture">人文历史</span>
            <span class="tag selected" data-tag="food">美食探店</span>
            <span class="tag" data-tag="shopping">购物休闲</span>
            <span class="tag" data-tag="photo">拍照打卡</span>
            <span class="tag" data-tag="adventure">户外探险</span>
            <span class="tag" data-tag="family">亲子乐园</span>
            <span class="tag" data-tag="night">夜生活</span>
            <span class="tag" data-tag="creative">文创非遗</span>
            <span class="tag" data-tag="wellness">康养慢游</span>
          </div>
        </div>
        <div class="sidebar-section">
          <h3>个性化画像</h3>
          <div class="tag-row" id="plan-personas">
            <span class="tag selected" data-tag="relaxed">松弛慢游</span>
            <span class="tag" data-tag="explorer">探索尝鲜</span>
            <span class="tag selected" data-tag="photo">拍照分享</span>
            <span class="tag" data-tag="culture">文化深度</span>
            <span class="tag" data-tag="planner">计划确定</span>
            <span class="tag" data-tag="value">性价比</span>
            <span class="tag" data-tag="premium">品质体验</span>
          </div>
          <div class="field" style="margin-top:12px">
            <label>多人偏好差异</label>
            <input type="text" id="plan-companion-preferences" placeholder="例：我喜欢历史，她喜欢拍照和甜品">
          </div>
          <div class="field">
            <label>重点促进消费</label>
            <input type="text" id="plan-conversion-focus" placeholder="例：夜游、情侣套餐、文创伴手礼、特色餐饮">
          </div>
          <div class="field">
            <label>不想要 / 特殊需求</label>
            <input type="text" id="plan-special-needs" placeholder="例：不要太累、雨天备选、少排队">
          </div>
        </div>
        <button class="plan-plan-btn" onclick="generatePlan()">✨ 生成场景智能行程</button>
      </div>
      <div class="plan-timeline" id="plan-timeline">
        <div class="timeline-header">
          <div class="timeline-title">你的专属行程</div>
          <div class="timeline-actions">
            <button class="btn btn-secondary btn-sm" onclick="exportPlan()">导出行程</button>
            <button class="btn btn-accent btn-sm" onclick="sharePlan()">分享</button>
          </div>
        </div>
        <div class="empty-state" id="plan-empty">
          <div class="es-icon">🗺️</div>
          <div class="es-title">还没有行程计划</div>
          <div class="es-desc">设置左侧参数，点击"生成行程"开始规划</div>
        </div>
        <div id="plan-days-container" style="display:none"></div>
      </div>
      <div class="plan-map">
        <div id="plan-map-container"></div>
        <div class="plan-transport-bar" id="plan-transport-bar">
          <button class="plan-transport-btn active" data-mode="driving" onclick="setRouteMode('driving',this)">🚗 驾车</button>
          <button class="plan-transport-btn" data-mode="transit" onclick="setRouteMode('transit',this)">🚌 公交</button>
          <button class="plan-transport-btn" data-mode="walking" onclick="setRouteMode('walking',this)">🚶 步行</button>
          <button class="plan-transport-btn" data-mode="bicycling" onclick="setRouteMode('bicycling',this)">🚲 骑行</button>
        </div>
        <div class="plan-map-controls">
          <button class="map-btn" onclick="autoRoutePlan()">🚗 一键规划路线</button>
          <button class="map-btn" onclick="fitPlanRoute()">查看全部</button>
          <button class="map-btn" onclick="clearPlanRoute()">清除路线</button>
        </div>
      </div>
    </div>
  </div>

  <!-- PAGE 4: MARKETING -->
  <div class="page page-marketing" id="page-marketing">
    <div class="mkt-layout">
      <div class="mkt-form-panel">
        <h3>营销内容生成</h3>
        <div class="field">
          <label>目标客群</label>
          <select id="mkt-crowd">
            <option value="">自动识别</option>
            <option value="family">亲子家庭</option>
            <option value="couple">情侣蜜月</option>
            <option value="senior">银发一族</option>
            <option value="team">公司团建</option>
            <option value="student">大学生</option>
            <option value="business">商务出差</option>
          </select>
        </div>
        <div class="field">
          <label>内容类型</label>
          <select id="mkt-type">
            <option value="social">社交媒体文案</option>
            <option value="article">公众号推文</option>
            <option value="video_script">短视频脚本</option>
            <option value="poster">海报文案</option>
            <option value="event">活动策划</option>
            <option value="product">文创产品概念</option>
          </select>
        </div>
        <div class="field">
          <label>风格调性</label>
          <select id="mkt-tone">
            <option value="fashion">时尚潮流</option>
            <option value="literary">文艺清新</option>
            <option value="funny">幽默风趣</option>
            <option value="professional">专业深度</option>
            <option value="warm">温暖治愈</option>
          </select>
        </div>
        <div class="field">
          <label>目的地 / 产品</label>
          <input type="text" id="mkt-destination" placeholder="杭州西湖">
        </div>
        <div class="field">
          <label>补充说明</label>
          <input type="text" id="mkt-extra" placeholder="特色、亮点、关键词...">
        </div>
        <div class="field">
          <label>经营目标</label>
          <input type="text" id="mkt-business-goal" placeholder="例：提升七夕情侣套餐预订与文创加购">
        </div>
        <div class="field">
          <label>主推产品 / 产品线</label>
          <input type="text" id="mkt-product-line" placeholder="例：夜游船票+双人下午茶+香囊礼盒">
        </div>
        <div class="field">
          <label>转化目标</label>
          <input type="text" id="mkt-conversion-target" placeholder="例：购票、预约、到店、文创加购">
        </div>
        <div class="field">
          <label>投放渠道</label>
          <input type="text" id="mkt-channels" placeholder="小红书、抖音、公众号、OTA">
        </div>
        <button class="mkt-generate-btn" onclick="generateMarketing()">✦ 生成内容</button>

        <div class="mkt-history" id="mkt-history">
          <h3>历史生成</h3>
          <div id="mkt-history-list">
            <div style="color:var(--ink-subtle);font-size:13px;text-align:center;padding:12px">暂无历史记录</div>
          </div>
        </div>
      </div>
      <div class="mkt-preview-panel">
        <!-- 热门文创产品展示 -->
        <div class="mkt-inspire" id="mkt-inspire">
          <div class="mkt-inspire-header">
            <div>
              <div class="mkt-inspire-title"><span class="icon">🎨</span> 热门文创产品 · 灵感库</div>
              <div class="mkt-inspire-subtitle">浏览当下热门文创产品，提取设计灵感、营销卖点和文化元素，一键填充到营销内容生成</div>
              <div class="market-hot-status" id="mkt-inspire-live-status">根据市场热点自动补充新品灵感。</div>
            </div>
            <div class="mkt-inspire-filters" id="mkt-inspire-filters">
              <button class="mkt-inspire-chip active" data-cat="all" onclick="filterInspireProducts('all',this)">全部</button>
              <button class="mkt-inspire-chip" data-cat="国潮" onclick="filterInspireProducts('国潮',this)">国潮</button>
              <button class="mkt-inspire-chip" data-cat="非遗" onclick="filterInspireProducts('非遗',this)">非遗</button>
              <button class="mkt-inspire-chip" data-cat="博物馆" onclick="filterInspireProducts('博物馆',this)">博物馆</button>
              <button class="mkt-inspire-chip" data-cat="文创IP" onclick="filterInspireProducts('文创IP',this)">文创IP</button>
              <button class="mkt-inspire-chip" data-cat="节庆" onclick="filterInspireProducts('节庆',this)">节庆</button>
              <button class="market-refresh-btn" id="mkt-market-refresh" onclick="refreshMarketHotContent(true)">更新热点</button>
            </div>
          </div>
          <div class="mkt-inspire-grid" id="mkt-inspire-grid"></div>
        </div>
        <div class="mkt-preview-card empty" id="mkt-preview">生成的内容将在这里展示</div>
        <div class="mkt-preview-actions" id="mkt-actions" style="display:none">
          <button class="btn btn-accent btn-sm" onclick="copyMarketing()">📋 复制内容</button>
          <button class="btn btn-secondary btn-sm" onclick="regenerateMarketing()">🔄 重新生成</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 文创产品详情弹窗 -->
  <div class="mkt-product-modal" id="mkt-product-modal" onclick="if(event.target===this)closeProductModal(event)">
    <div class="mkt-product-modal-inner" style="position:relative">
      <button class="mkt-product-modal-close" onclick="closeProductModal(event)" aria-label="关闭">×</button>
      <img class="mkt-product-modal-hero" id="mpm-img" src="" alt="">
      <div class="mkt-product-modal-body">
        <h3 id="mpm-name"></h3>
        <div class="mkt-product-modal-brand" id="mpm-brand"></div>
        <div class="mkt-product-modal-section">
          <h4>产品简介</h4>
          <p id="mpm-desc"></p>
        </div>
        <div class="mkt-product-modal-section">
          <h4>设计灵感</h4>
          <p id="mpm-design"></p>
        </div>
        <div class="mkt-product-modal-inspire" id="mpm-inspire">
          <h4>✦ 可提取的营销灵感</h4>
          <ul id="mpm-inspire-list"></ul>
        </div>
        <div class="mkt-product-modal-section">
          <h4>文化元素</h4>
          <p id="mpm-culture"></p>
        </div>
        <div class="mkt-product-modal-section">
          <h4>目标客群</h4>
          <p id="mpm-audience"></p>
        </div>
        <div class="mkt-product-modal-actions">
          <button class="btn btn-accent btn-sm" onclick="useProductInspiration()">✦ 提取灵感填充营销</button>
          <button class="mkt-inspire-btn" id="mpm-save-btn" onclick="toggleSaveProduct()">☆ 收藏灵感</button>
          <button class="btn btn-secondary btn-sm" onclick="closeProductModal(event)">关闭</button>
        </div>
      </div>
    </div>
  </div>
  <div class="page page-community" id="page-community">
    <div class="community-layout">
      <main class="community-main">
        <section class="community-hero">
          <h2>文旅社区攻略</h2>
          <p>统一承载小红书/抖音平台灵感、用户游记、路线心得、餐食体验和文创打卡内容，让用户在一个页面完成了解、筛选、跳转原文和加入行程。</p>
        </section>
        <section class="community-panel" aria-label="小红书灵感筛选">
          <div class="timeline-header">
            <div>
              <div class="timeline-title">平台灵感与社区精选</div>
              <div class="xhs-summary" id="xhs-summary">正在加载...</div>
              <div class="market-hot-status" id="community-market-status">市场热点会自动更新，也可手动刷新。</div>
            </div>
            <div class="timeline-actions">
              <button class="market-refresh-btn" id="community-market-refresh" onclick="refreshMarketHotContent(true)">更新市场热点</button>
              <button class="btn btn-secondary btn-sm" onclick="resetXhsFilters()">重置筛选</button>
            </div>
          </div>
          <div class="xhs-toolbar">
            <input class="xhs-search" id="xhs-keyword" placeholder="搜索城市、玩法、标签，例如：杭州 夜市、亲子、Citywalk">
            <select id="xhs-source-filter" class="xhs-search" style="max-width:150px">
              <option value="全部">全部平台</option>
            </select>
            <select id="xhs-city-filter" class="xhs-search" style="max-width:150px">
              <option value="全部">全部城市</option>
            </select>
            <select id="xhs-theme-filter" class="xhs-search" style="max-width:150px">
              <option value="全部">全部主题</option>
            </select>
            <select id="xhs-crowd-filter" class="xhs-search" style="max-width:150px">
              <option value="全部">全部人群</option>
            </select>
            <button class="btn btn-primary btn-sm" onclick="loadXhsNotes()">搜索</button>
          </div>
          <div class="xhs-compliance" style="margin-top:0;margin-bottom:14px">
            当前平台灵感不复制小红书正文、图片、评论，也不搬运抖音视频，仅保存公开入口、人工摘要与筛选标签；完整内容跳转原平台查看。
          </div>
          <div class="xhs-grid" id="xhs-grid">
            <div class="xhs-empty">正在读取灵感库...</div>
          </div>
        </section>
        <section class="community-compose" aria-label="发布旅游心得">
          <input id="community-title" placeholder="标题：例如 西湖夜游怎么拍最出片">
          <input id="community-tags" placeholder="标签：西湖, 夜游, 拍照">
          <textarea id="community-content" placeholder="分享你的旅游心得、路线攻略、避坑经验或文创/餐食推荐..."></textarea>
          <button type="button" onclick="publishCommunityPost()">发布攻略</button>
        </section>
        <div class="community-filter" aria-label="社区内容筛选">
          <button class="active" data-community-filter="all" onclick="filterCommunity('all', this)">全部</button>
          <button data-community-filter="route" onclick="filterCommunity('route', this)">路线攻略</button>
          <button data-community-filter="food" onclick="filterCommunity('food', this)">美食餐饮</button>
          <button data-community-filter="culture" onclick="filterCommunity('culture', this)">文创非遗</button>
          <button data-community-filter="photo" onclick="filterCommunity('photo', this)">拍照打卡</button>
        </div>
        <div class="community-feed" id="community-feed"></div>
      </main>
      <aside class="community-side">
        <section class="community-panel">
          <h3>点击率排行</h3>
          <div class="rank-list" id="community-click-rank"></div>
        </section>
        <section class="community-panel">
          <h3>收藏排行</h3>
          <div class="rank-list" id="community-fav-rank"></div>
        </section>
        <section class="community-panel">
          <h3>外部平台热点供给</h3>
          <div class="platform-hot" id="platform-hot-list">
            <div class="platform-status">正在读取官方/授权平台数据...</div>
          </div>
        </section>
      </aside>
    </div>
  </div>

  <!-- 社区攻略详情弹窗 -->
  <div class="community-detail-modal" id="community-detail-modal" onclick="if(event.target===this)closeCommunityPostModal(event)">
    <div class="community-detail-inner">
      <button class="community-detail-close" onclick="closeCommunityPostModal(event)" aria-label="关闭">×</button>
      <div class="community-detail-hero">
        <img id="cdm-img" src="" alt="">
      </div>
      <div class="community-detail-body">
        <span class="community-detail-tag" id="cdm-tag"></span>
        <h3 id="cdm-title"></h3>
        <div class="community-detail-meta" id="cdm-meta"></div>
        <div class="community-detail-content" id="cdm-content"></div>
        <div class="community-detail-note" id="cdm-note"></div>
        <div class="community-detail-actions">
          <button class="primary" onclick="favoriteCommunityPostFromModal()">收藏这篇攻略</button>
          <a class="ghost" id="cdm-source" href="#" target="_blank" rel="noopener" style="display:none">查看原平台入口</a>
          <button class="ghost" onclick="closeCommunityPostModal(event)">关闭</button>
        </div>
