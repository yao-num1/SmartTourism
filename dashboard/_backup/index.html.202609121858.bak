<script>

// ===== 全局错误处理与状态提示 =====

// HTML 转义函数
function escapeHtml(s) {
  if (!s) return '';
  var d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

// Toast 通知系统：底部弹出式提示
function showToast(msg, type) {
  type = type || 'info'; // info | success | warning | error
  var colors = {info:'#2196F3', success:'#4CAF50', warning:'#FF9800', error:'#f44336'};
  var icons = {info:'ℹ️', success:'✅', warning:'⚠️', error:'❌'};
  var toast = document.createElement('div');
  toast.className = 'toast toast-' + type;
  toast.innerHTML = '<span class="toast-icon">' + (icons[type]||'') + '</span><span class="toast-msg">' + escapeHtml(msg) + '</span>';
  toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:10000;'
    + 'padding:12px 24px;border-radius:10px;background:' + colors[type] + ';color:#fff;'
    + 'font-size:14px;box-shadow:0 8px 32px rgba(0,0,0,.4);display:flex;align-items:center;gap:8px;'
    + 'animation:toastIn .3s ease, toastOut .3s ease 3s forwards;max-width:400px;';
  document.body.appendChild(toast);
  setTimeout(function(){ if(toast.parentNode) toast.parentNode.removeChild(toast); }, 3500);
}
// 注入 toast 动画 CSS（如果还没有）
if (!document.getElementById('toast-anim-style')) {
  var toastStyleEl = document.createElement('style');
  toastStyleEl.id = 'toast-anim-style';
  toastStyleEl.textContent = '@keyframes toastIn{from{opacity:0;transform:translateX(-50%) translateY(20px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}@keyframes toastOut{from{opacity:1;transform:translateX(-50%) translateY(0)}to{opacity:0;transform:translateX(-50%) translateY(-10px)}}';
  document.head.appendChild(toastStyleEl);
}

// 统一 API 请求封装（超时、错误处理、Toast 反馈）
function apiFetch(url, options) {
  options = options || {};
  var timeout = options.timeout || 30000;
  var controller = new AbortController();
  var timer = setTimeout(function(){ controller.abort(); }, timeout);
  var fetchOpts = Object.assign({}, options, { signal: controller.signal });
  delete fetchOpts.timeout;
  delete fetchOpts.__noToast; // 内部标记：抑制 auto-toast，由调用方自行处理

  return fetch(url, fetchOpts)
    .then(function(resp) {
      clearTimeout(timer);
      if (!resp.ok) {
        return resp.json().then(function(err) {
          throw new Error(err.error || err.message || ('服务器错误 HTTP ' + resp.status));
        }).catch(function(parseErr) {
          // 如果 json 解析也失败，抛出原始 HTTP 错误
          if (parseErr.message && parseErr.message.indexOf('服务器错误') === 0) throw parseErr;
          throw new Error('服务器错误 HTTP ' + resp.status);
        });
      }
      return resp.json();
    })
    .catch(function(err) {
      clearTimeout(timer);
      if (err.name === 'AbortError') {
        showToast('请求超时，请检查网络后重试', 'warning');
        throw new Error('请求超时');
      }
      if (err.message === 'Failed to fetch' || (err.message && err.message.indexOf('NetworkError') !== -1)) {
        showToast('网络连接失败，请检查网络设置', 'error');
        throw err;
      }
      // 如果错误消息本身已经通过 showToast 展示过（如超时/网络错误），不再重复 toast
      var isAlreadyToasted = (err.name === 'AbortError') ||
        (err.message === 'Failed to fetch') ||
        (err.message && err.message.indexOf('NetworkError') !== -1);
      if (!isAlreadyToasted && !options.__noToast) {
        showToast(err.message || '操作失败，请稍后重试', 'error');
      }
      throw err;
    });
}

// ===== STATE =====
const BACKEND = window.location.origin || 'http://localhost:5000';
let conversationId = localStorage.getItem('st_conversation_id') || '';
let messages = [];
let amapKey = '';
let planMapLoaded = false;
let planData = [];
let mktHistory = [];
let userGPS = null; // { lng, lat, city, district, accuracy, source }

// ===== PORTAL HOT DETAIL DATA =====
const portalHotDetails = {
