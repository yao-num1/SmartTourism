// ===== AUTO GEOLOCATION ON PAGE LOAD =====
async function initUserLocation() {
  // Strategy: AMap Geolocation (official, most accurate) > Browser GPS > Backend IP (fallback) > Cached
  // 高德官方定位优先：使用 GPS/WiFi/基站定位，精度最高

  // === Helper: 逆地理编码补充地址信息 ===
  async function reverseGeocode(lng, lat) {
    try {
      var rg = await fetch(BACKEND + '/api/map/regeo', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({lng: lng, lat: lat})
      });
      var rd = await rg.json();
      if (rd.status === 'ok') {
        return {
          city: rd.city || '',
          district: rd.district || '',
          address: rd.formatted_address || '',
          province: rd.province || ''
        };
      }
    } catch(e) {
      console.warn('[Location] Reverse geocode failed:', e);
    }
    return null;
  }

  // === Helper: show location result ===
  function showLocationResult(source) {
    if (!userGPS) return;
    // 优先显示城市+区，其次显示完整地址，最后显示坐标
    var label = (userGPS.city || '') + (userGPS.district ? ' ' + userGPS.district : '');
    if (!label && userGPS.address) label = userGPS.address;
    if (!label) label = userGPS.lng.toFixed(4) + ', ' + userGPS.lat.toFixed(4);
    // 附加精度和来源信息
    var accLabel = userGPS.accuracy ? (' ±' + userGPS.accuracy + 'm') : '';
    var sourceLabel = '';
    if (userGPS.source === 'amap') sourceLabel = '高德定位';
    else if (userGPS.source === 'gps') sourceLabel = 'GPS';
    else if (userGPS.source === 'backend-ip') sourceLabel = 'IP定位';
    else if (userGPS.source === 'cached') sourceLabel = '缓存';
    setStatus(label, 'oklch(0.62 0.14 175)');
    console.log('[Location] ' + source + ': ' + userGPS.lng.toFixed(6) + ', ' + userGPS.lat.toFixed(6) + ' (' + label + ', accuracy=' + (userGPS.accuracy || '?') + 'm, source=' + userGPS.source + ')');
    var el = document.getElementById('location-display');
    if (el) el.textContent = label + accLabel + (sourceLabel ? ' [' + sourceLabel + ']' : '');
  }

  // === Try 1: AMap Geolocation plugin (高德官方定位，精度最高) ===
  try {
    if (typeof AMap !== 'undefined' && AMap.Geolocation) {
      var geolocation = new AMap.Geolocation({
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 0,
        noIpLocate: 0,
        useNative: true,
        GeoLocationFirst: true
      });
      var result = await new Promise(function(resolve, reject) {
        geolocation.getCurrentPosition(function(status, res) {
          if (status === 'complete') resolve(res);
          else reject(res);
        });
      });
      if (result && result.position) {
        userGPS = {
          lng: result.position.lng,
          lat: result.position.lat,
          city: (result.addressComponent && result.addressComponent.city) || '',
          district: (result.addressComponent && result.addressComponent.district) || '',
          address: (result.formattedAddress) || '',
          accuracy: Math.round(result.accuracy || 0),
          source: 'amap'
        };
        // 如果高德定位未返回地址信息，通过后端逆地理编码补充
        if (!userGPS.city && !userGPS.district && !userGPS.address) {
          var addrInfo = await reverseGeocode(userGPS.lng, userGPS.lat);
          if (addrInfo) {
            userGPS.city = addrInfo.city;
            userGPS.district = addrInfo.district;
            userGPS.address = addrInfo.address;
          }
        }
        showLocationResult('AMap');
        localStorage.setItem('st_last_gps', JSON.stringify(userGPS));
        return;
      }
    }
  } catch(e) {
    console.warn('[Location] AMap Geolocation failed:', e.message || e.info || e);
  }

  // === Try 2: Browser native GPS (高德 SDK 未加载时使用) ===
  if (navigator.geolocation) {
    try {
      var pos = await new Promise(function(resolve, reject) {
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          enableHighAccuracy: true, timeout: 10000, maximumAge: 0
        });
      });
      userGPS = {
        lng: pos.coords.longitude,
        lat: pos.coords.latitude,
        accuracy: Math.round(pos.coords.accuracy),
        source: 'gps'
      };
      // 逆地理编码获取城市/区/地址信息
      var addrInfo = await reverseGeocode(userGPS.lng, userGPS.lat);
      if (addrInfo) {
        userGPS.city = addrInfo.city;
        userGPS.district = addrInfo.district;
        userGPS.address = addrInfo.address;
      }
      showLocationResult('GPS');
      localStorage.setItem('st_last_gps', JSON.stringify(userGPS));
      return;
    } catch(e) {
      console.warn('[Location] Browser GPS failed:', e.message || e);
    }
  }

  // === Try 3: Backend IP location (兜底方案，精度约城市级) ===
  try {
    var r = await fetch(BACKEND + '/api/my-location', { cache: 'no-store' });
    if (r.ok) {
      var d = await r.json();
      if (d.status === 'ok' && d.lng && d.lat) {
        userGPS = {
          lng: d.lng,
          lat: d.lat,
          city: d.city || '',
          district: d.district || '',
          address: d.address || '',
          accuracy: 3000,
          source: 'backend-ip'
        };
        showLocationResult('Backend IP');
        localStorage.setItem('st_last_gps', JSON.stringify(userGPS));
        return;
      }
    }
  } catch(e) {
    console.warn('[Location] Backend proxy failed:', e);
  }

  // === Try 4: Use last known good GPS from localStorage ===
  if (!userGPS) {
    try {
      var cached = localStorage.getItem('st_last_gps');
      if (cached) {
        userGPS = JSON.parse(cached);
        userGPS.source = 'cached';
        showLocationResult('Cached');
      }
    } catch(e) {}
  }
}

// === Manual location correction: user types city name, backend geocodes ===
function correctMyLocation() {
  var city = prompt('请输入你当前所在城市（如：杭州）：');
  if (!city || !city.trim()) return;
  city = city.trim();
  fetch(BACKEND + '/api/map/geocode', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({address: city})
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'ok' && d.lng && d.lat) {
      userGPS = {
        lng: d.lng,
        lat: d.lat,
        city: city,
        district: '',
        accuracy: 1000,
        source: 'manual'
      };
      setStatus('[Manual] ' + city, 'oklch(0.62 0.14 175)');
      var el = document.getElementById('location-display');
      if (el) el.textContent = city;
      localStorage.setItem('st_last_gps', JSON.stringify(userGPS));
      showToast('Location updated: ' + city, 'success');
    } else {
      showToast('Unable to find location for: ' + city, 'warning');
    }
  })
  .catch(function(e) { showToast('Geocoding failed: ' + e, 'warning'); });
}

// 网络状态监听
window.addEventListener('online', function() {
  showToast('网络已恢复', 'success');
});
window.addEventListener('offline', function() {
  showToast('网络已断开，部分功能不可用', 'warning');
});

// ===== TICKET PURCHASE ENGINE (DeepTrip 2.0 + Satisfi Labs inspired) =====
let ticketCache = {}; // Cache fetched products by keyword
let currentTicketProduct = null;

// Detect if AI response mentions ticket-eligible attractions and inject purchase cards
function detectAndRenderTickets(content) {
  if (!content) return '';
  // Quick keyword match — full semantic matching in production via LLM
  const ticketTriggers = [
    '门票','购票','票价','预订','订票','出行','游玩',
    '景区','景点','游船','长城','故宫','兵马俑','熊猫',
    '酒店','住宿','房间','大床房','双床房','套房','海景',
  ];
  if (!ticketTriggers.some(t => content.includes(t))) return '';
  
  // Avoid injecting into streaming bubble (done in renderMessages)
  return '<div class="ticket-reco-placeholder" data-content="' + encodeURIComponent(content) + '"></div>';
}

// Fetch ticket products matching the conversation context
async function fetchTicketProducts(context) {
  const dest = document.getElementById('destination').value || '';
  const keywords = [dest];
  // Extract city names from context
  const cities = ['杭州','三亚','北京','成都','西安','大理','丽江','桂林','张家界'];
  for (const c of cities) { if (context.includes(c)) keywords.push(c); }
  const kw = keywords.filter(Boolean).join(',');
  const cacheKey = kw || '__all__';
  if (ticketCache[cacheKey]) return ticketCache[cacheKey];
  
  try {
    const resp = await fetch(BACKEND + '/api/tickets/products?keyword=' + encodeURIComponent(kw || ''));
    const data = await resp.json();
    if (data.success) { ticketCache[cacheKey] = data.products; return data.products; }
  } catch(e) { console.error('Ticket fetch error:', e); }
  return [];
}

// Async: replace placeholder with actual ticket cards
async function renderTicketCardsAsync(content) {
  const products = await fetchTicketProducts(content);
  if (!products.length) return '';
  // Pick top 2 products (highest discount ratio)
  const ranked = products
    .filter(p => p.stock > 0)
    .sort((a,b) => ((b.orig_price-b.price)/b.orig_price) - ((a.orig_price-a.price)/a.orig_price))
    .slice(0, 2);
  if (!ranked.length) return '';
  
  return '<div class="ticket-reco-group" style="margin-top:10px;display:flex;flex-direction:column;gap:8px">' +
    '<div style="font-size:11px;color:var(--ink-subtle);letter-spacing:.04em;margin-bottom:2px">TICKETS &amp; HOTELS — 点击购票</div>' +
    ranked.map(p => '<div class="ticket-reco" onclick="openTicket(\'' + p.id + '\')">' +
      '<div class="ticket-reco-icon">' + (p.type === '酒店' ? '🏨' : '🎫') + '</div>' +
      '<div class="ticket-reco-info">' +
        '<div class="ticket-reco-name">' + escHtml(p.name) + '</div>' +
        '<div class="ticket-reco-meta">' +
          '<span>' + p.city + '</span>' +
          (p.tags || []).map(t => '<span class="ticket-reco-tag">' + t + '</span>').join('') +
        '</div>' +
      '</div>' +
      '<div class="ticket-reco-price">' +
        '<div class="tp-cur">CNY <small>' + p.price.toFixed(0) + '</small></div>' +
        (p.orig_price > p.price ? '<div class="tp-ori">CNY ' + p.orig_price.toFixed(0) + '</div>' : '') +
      '</div>' +
      '<button class="ticket-reco-btn" onclick="event.stopPropagation();openTicket(\'' + p.id + '\')">去购票</button>' +
    '</div>').join('') +
    '<div style="font-size:10px;color:var(--ink-subtle);text-align:right;margin-top:4px">DeepTrip 2.0 轻量化 Skill · 零跳转闭环</div>' +
  '</div>';
}

// ===== Auto Ticket Recommendation Toast =====
let toastTimer = null;
function showTicketToast(products) {
  // 禁用自动购票浮窗：避免用户刚进入网页或 AI 回复渲染后反复弹出虚拟购票提示。
  // 手动点击“去购票”仍会调用 openTicket() 打开购票弹窗。
  return;
  if (!products || !products.length) return;
  // Clear previous toast
  if (toastTimer) clearTimeout(toastTimer);
  const old = document.getElementById('ticket-toast');
  if (old) old.remove();
  
  const p = products[0]; // Show top product
  const toast = document.createElement('div');
  toast.id = 'ticket-toast';
  toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:999;background:var(--paper-3);border:1px solid oklch(0.35 0.08 95 / 0.5);border-radius:16px;padding:14px 20px;display:flex;align-items:center;gap:14px;box-shadow:0 8px 40px rgba(0,0,0,0.5),0 0 30px oklch(0.72 0.12 95 / 0.1);animation:slideUp 300ms ease;max-width:480px;cursor:pointer';
  toast.onclick = function() { openTicket(p.id); toast.remove(); };
  
  const discount = p.orig_price > p.price ? Math.round((1 - p.price / p.orig_price) * 100) : 0;
  toast.innerHTML =
    '<div style="font-size:28px;flex-shrink:0">' + (p.type === '酒店' ? '🏨' : '🎫') + '</div>' +
    '<div style="flex:1;min-width:0">' +
      '<div style="font-size:14px;font-weight:500;color:var(--ink);margin-bottom:2px">' + escHtml(p.name) + '</div>' +
      '<div style="font-size:12px;color:var(--ink-subtle)">' + escHtml(p.city) + (discount > 10 ? ' · ' + discount + '% OFF' : '') + ' · 点击立即购票</div>' +
    '</div>' +
    '<div style="font-size:20px;font-weight:700;color:var(--accent-2);flex-shrink:0">CNY ' + p.price.toFixed(0) + '</div>' +
    '<button style="background:var(--accent-2);color:#000;border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit" onclick="event.stopPropagation();openTicket(\'' + p.id + '\'); toast.remove();">去购票</button>' +
    '<button style="background:none;border:none;color:var(--ink-subtle);font-size:16px;cursor:pointer;padding:0 4px" onclick="event.stopPropagation();toast.remove();">✕</button>';
  
  document.body.appendChild(toast);
  toastTimer = setTimeout(function() { toast.remove(); }, 15000);
}

// Open ticket purchase modal
function openTicket(productId) {
  const keyword = document.getElementById('destination').value || '';
  fetchTicketProducts(keyword).then(products => {
    const product = products.find(p => p.id === productId);
    if (!product) return;
    currentTicketProduct = product;
    
    const outOfStock = product.stock <= 0;
    const modal = document.getElementById('ticket-modal');
    modal.innerHTML = 
      '<h3>' + escHtml(product.name) + '</h3>' +
      '<div class="tm-sub">' + escHtml(product.city) + ' · ' + escHtml(product.type) + ' · ' + escHtml(product.desc || '') + '</div>' +
      '<label>票种选择</label>' +
      '<select id="ticket-type">' +
        '<option value="adult">成人票 · CNY ' + product.price.toFixed(0) + '/张</option>' +
        '<option value="child"' + (product.type==='酒店'?' disabled':'') + '>儿童票 · CNY ' + (product.price*0.5).toFixed(0) + '/张</option>' +
        '<option value="senior"' + (product.type==='酒店'?' disabled':'') + '>长者票 · CNY ' + (product.price*0.7).toFixed(0) + '/张</option>' +
      '</select>' +
      '<label>购买数量</label>' +
      '<input type="number" id="ticket-qty" value="1" min="1" max="' + product.stock + '" onchange="updateTicketTotal()">' +
      '<label>联系人姓名</label>' +
      '<input type="text" id="ticket-name" placeholder="请输入姓名">' +
      '<label>手机号码</label>' +
      '<input type="tel" id="ticket-phone" placeholder="请输入手机号">' +
      '<div class="tm-total">' +
        '<span class="tm-total-label">合计金额</span>' +
        '<span class="tm-total-price" id="ticket-total-price">CNY ' + product.price.toFixed(0) + '</span>' +
      '</div>' +
      '<div class="tm-actions">' +
        '<button class="tm-btn-cancel" onclick="closeTicket()">取消</button>' +
        (outOfStock
          ? '<button class="ticket-reco-btn sold-out" disabled>已售罄</button>'
          : '<button class="tm-btn-buy" id="ticket-buy-btn" onclick="submitOrder()">确认购买</button>') +
      '</div>';
    
    document.getElementById('ticket-overlay').style.display = 'flex';
    if (!outOfStock) {
      document.getElementById('ticket-type').addEventListener('change', updateTicketTotal);
      document.getElementById('ticket-qty').addEventListener('input', updateTicketTotal);
    }
  });
}

function updateTicketTotal() {
  if (!currentTicketProduct) return;
  const type = document.getElementById('ticket-type').value;
  const qty = parseInt(document.getElementById('ticket-qty').value) || 1;
  let price = currentTicketProduct.price;
  if (type === 'child') price *= 0.5;
  if (type === 'senior') price *= 0.7;
  const total = price * qty;
  document.getElementById('ticket-total-price').textContent = 'CNY ' + total.toFixed(0);
}

function closeTicket() {
  document.getElementById('ticket-overlay').style.display = 'none';
  currentTicketProduct = null;
}

async function submitOrder() {
  const name = document.getElementById('ticket-name').value.trim();
  const phone = document.getElementById('ticket-phone').value.trim();
  if (!name) { alert('请输入联系人姓名'); return; }
  if (!phone || !/^1\d{10}$/.test(phone)) { alert('请输入有效的手机号码'); return; }
  
  const type = document.getElementById('ticket-type').value;
  const qty = parseInt(document.getElementById('ticket-qty').value) || 1;
  let price = currentTicketProduct.price;
  if (type === 'child') price *= 0.5;
  if (type === 'senior') price *= 0.7;
  const total = price * qty;
  
  const btn = document.getElementById('ticket-buy-btn');
  btn.textContent = '处理中...';
  btn.disabled = true;
  
  try {
    const resp = await fetch(BACKEND + '/api/tickets/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_id: currentTicketProduct.id,
        quantity: qty,
        contact: { name: name, phone: phone }
      })
    });
    const data = await resp.json();
    
    if (data.success) {
      // Save to profile
      var orderItem = {
        title: data.order.product_name,
        city: currentTicketProduct.city || '',
        price: data.order.total,
        count: data.order.quantity,
        date: new Date().toISOString().slice(0,10),
        order_id: data.order.order_id,
        status: 'confirmed'
      };
      if (!profileData.orders) profileData.orders = [];
      profileData.orders.unshift(orderItem);
      // Save to localStorage for persistence
      var localOrders = JSON.parse(localStorage.getItem('sm_tkt_orders') || '[]');
      localOrders.unshift(orderItem);
      localStorage.setItem('sm_tkt_orders', JSON.stringify(localOrders));
      // Sync to backend
      fetch(BACKEND + '/api/user/order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(orderItem)
      }).catch(function(){});

      const modal = document.getElementById('ticket-modal');
      modal.innerHTML =
        '<div class="ticket-success">' +
          '<div class="ts-icon">✅</div>' +
          '<div class="ts-msg">购买成功！</div>' +
          '<div class="ts-order">订单号：' + escHtml(data.order.order_id) + '</div>' +
          '<div class="ts-price">CNY ' + data.order.total.toFixed(0) + '</div>' +
          '<div style="margin-top:16px;font-size:13px;color:var(--ink-subtle)">' +
            escHtml(data.order.product_name) + ' × ' + data.order.quantity + '张' +
          '</div>' +
          '<button class="tm-btn-cancel" style="margin-top:20px" onclick="closeTicket()">完成</button>' +
        '</div>';
      showToast('🎫 购票成功！订单已保存到个人中心', 'success');
    } else {
      showToast('购票失败，请重试', 'error');
      alert('下单失败：' + (data.error || '未知错误'));
    }
  } catch(e) {
    showToast('购票失败，请重试', 'error');
    console.error('submitOrder error:', e);
    alert('网络错误：' + e.message);
  }
  btn.textContent = '确认购买';
  btn.disabled = false;
}

// ===== PROFILE PAGE (Personal Center) =====
let profileData = { orders: [], itineraries: [], hotels: [], flights: [] };

async function loadProfile() {
  try {
    const resp = await fetch(BACKEND + '/api/user/profile?user_id=default');
    const data = await resp.json();
    if (data.success) {
      profileData = data.data;
      // Merge local orders from ticket purchases
      const localOrders = JSON.parse(localStorage.getItem('sm_tkt_orders') || '[]');
      profileData.orders = [...localOrders, ...(profileData.orders || [])];
    }
  } catch(e) {
    console.error('加载个人中心数据失败:', e);
  }
  renderAllProfileLists();
}

function renderAllProfileLists() {
  renderProfileList('orders', profileData.orders || []);
  renderProfileList('itineraries', profileData.itineraries || []);
  renderProfileList('hotels', profileData.hotels || []);
  renderProfileList('flights', profileData.flights || []);
}

function renderProfileList(type, items) {
  const el = document.getElementById('profile-' + type + '-list');
  if (!el) return;
  if (!items.length) {
    const labels = { orders: '暂无订单', itineraries: '暂无行程', hotels: '暂无酒店预订', flights: '暂无机票预订' };
    const hints = { orders: '在对话中购票后，订单会出现在这里', itineraries: '使用行程规划功能后，计划会出现在这里', hotels: '在对话中预订酒店后，记录会出现在这里', flights: '机票预订记录将出现在这里' };
    el.innerHTML = '<div class="profile-empty">' + labels[type] + '<br/><span>' + hints[type] + '</span></div>';
    return;
  }
  const icons = { orders: '🎫', itineraries: '🗺️', hotels: '🏨', flights: '✈️' };
  el.innerHTML = items.map((item, idx) => {
    const price = item.price ? ('CNY ' + (typeof item.price === 'number' ? item.price.toFixed(0) : item.price)) : '';
    const badge = item.status === 'confirmed' ? '<span class="pf-card-badge pf-badge-confirmed">已确认</span>' : '<span class="pf-card-badge pf-badge-pending">待处理</span>';
    const meta = [item.city, item.date, item.detail, item.days ? item.days + '天' : '', item.count ? item.count + '份' : '', item.spots ? item.spots.join(', ') : ''].filter(Boolean).join(' · ');
    var viewBtn = '';
    if (type === 'itineraries' && item.content) {
      viewBtn = '<button class="pf-card-view" onclick="event.stopPropagation();viewItineraryDetail(' + idx + ')">查看详情</button>';
    }
    return '<div class="pf-card">' +
      '<div class="pf-card-icon">' + (icons[type] || '📌') + '</div>' +
      '<div class="pf-card-info">' +
        '<div class="pf-card-title">' + escHtml(item.title || item.product_name || '') + '</div>' +
        '<div class="pf-card-meta">' + escHtml(meta) + ' ' + badge + '</div>' +
      '</div>' +
      '<div class="pf-card-right">' +
        (price ? '<div class="pf-card-price">' + price + '</div>' : '') +
        viewBtn +
        '<button class="pf-card-del" onclick="deleteProfileItem(\'' + type + '\',' + idx + ')">删除</button>' +
      '</div>' +
    '</div>';
  }).join('');
}

function viewItineraryDetail(idx) {
  var item = profileData.itineraries[idx];
  if (!item || !item.content) return;

  var overlay = document.createElement('div');
  overlay.className = 'pf-detail-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center;';
  overlay.onclick = function(e) { if (e.target === overlay) overlay.remove(); };

  var content = item.content
    .replace(/### (.*)/g, '<h4>$1</h4>')
    .replace(/## (.*)/g, '<h3>$1</h3>')
    .replace(/# (.*)/g, '<h2>$1</h2>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br/>');

  overlay.innerHTML =
    '<div class="pf-detail-card" style="background:var(--paper-2);border:1px solid var(--rule);border-radius:var(--radius-md);padding:32px;max-width:720px;max-height:80vh;overflow-y:auto;margin:20px;box-shadow:0 16px 60px rgba(0,0,0,0.6)">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">' +
        '<h2 style="margin:0;font-size:20px;font-weight:400;color:var(--accent-2);letter-spacing:.04em">' + escHtml(item.title || '') + '</h2>' +
        '<button style="background:none;border:none;color:var(--ink-subtle);font-size:20px;cursor:pointer" onclick="this.closest(\'.pf-detail-overlay\').remove()">✕</button>' +
      '</div>' +
      '<div style="line-height:1.8;color:var(--ink);font-size:15px">' + content + '</div>' +
    '</div>';
  document.body.appendChild(overlay);
}

function deleteProfileItem(type, idx) {
  if (confirm('确定删除这条记录？')) {
    profileData[type].splice(idx, 1);
    // Also update localStorage for orders
    if (type === 'orders') {
      localStorage.setItem('sm_tkt_orders', JSON.stringify(profileData.orders));
    }
    renderProfileList(type, profileData[type]);
    saveProfileToServer();
  }
}

function addProfileItem(type) {
  const labels = { order: '添加订单', itinerary: '添加行程', hotel: '添加酒店预订', flight: '添加机票预订' };
  const btypes = { order: 'ticket', itinerary: 'itinerary', hotel: 'hotel', flight: 'flight' };
  const icons = { order: '🎫', itinerary: '🗺️', hotel: '🏨', flight: '✈️' };
  
  const overlay = document.createElement('div');
  overlay.className = 'pf-modal-overlay';
  overlay.innerHTML =
    '<div class="pf-modal">' +
      '<h3>' + (icons[type] || '') + ' ' + (labels[type] || '') + '</h3>' +
      '<label>名称</label><input id="pf-input-title" placeholder="例如：西湖游船票">' +
      '<label>城市</label><input id="pf-input-city" placeholder="例如：杭州">' +
      '<label>价格 (CNY)</label><input id="pf-input-price" type="number" placeholder="0">' +
      '<label>日期</label><input id="pf-input-date" type="date">' +
      (type === 'itinerary' ? '<label>行程天数</label><input id="pf-input-days" type="number" value="3">' : '') +
      '<div class="pf-modal-actions">' +
        '<button class="pf-btn-cancel" onclick="this.closest(\'.pf-modal-overlay\').remove()">取消</button>' +
        '<button class="pf-btn-save" id="pf-save-btn">保存</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(overlay);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.remove(); });
  overlay.querySelector('#pf-save-btn').addEventListener('click', async function() {
    const title = overlay.querySelector('#pf-input-title').value.trim();
    if (!title) { alert('请输入名称'); return; }
    const item = {
      title: title,
      city: overlay.querySelector('#pf-input-city').value.trim(),
      price: parseFloat(overlay.querySelector('#pf-input-price').value) || 0,
      date: overlay.querySelector('#pf-input-date').value,
    };
    if (type === 'itinerary') {
      item.days = parseInt(overlay.querySelector('#pf-input-days').value) || 3;
    }
    
    const btype = btypes[type];
    const storeKey = btype + 's';
    
    try {
      const resp = await fetch(BACKEND + '/api/user/booking', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ booking_type: btype, ...item })
      });
      const data = await resp.json();
      if (data.success) {
        item.id = data.booking.id;
        item.status = 'confirmed';
        item.created_at = data.booking.created_at;
      }
    } catch(e) {
      item.id = 'LOCAL' + Date.now();
    }
    
    if (!profileData[storeKey]) profileData[storeKey] = [];
    profileData[storeKey].unshift(item);
    if (btype === 'ticket') {
      localStorage.setItem('sm_tkt_orders', JSON.stringify(profileData.orders));
    }
    renderProfileList(storeKey, profileData[storeKey]);
    overlay.remove();
  });
}

async function saveProfileToServer() {
  try {
    await fetch(BACKEND + '/api/user/clear?user_id=default&category=orders', { method: 'POST' });
    for (const o of profileData.orders) {
      await fetch(BACKEND + '/api/user/order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(o) });
    }
  } catch(e) {
    console.error('saveProfileToServer error:', e);
  }
}

// Profile tab switching
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('#profile-tabs .ptab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelectorAll('#profile-tabs .ptab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      const ptab = this.dataset.ptab;
      document.querySelectorAll('#profile-content .profile-section').forEach(s => s.classList.remove('active'));
      document.getElementById('ps-' + ptab).classList.add('active');
    });
  });
});

// Hook: save ticket orders to profile after purchase
const origSubmitOrder = submitOrder;
submitOrder = async function() {
  await origSubmitOrder();
  const orderEl = document.querySelector('.ticket-success');
  if (orderEl) {
    const orders = JSON.parse(localStorage.getItem('sm_tkt_orders') || '[]');
    if (currentTicketProduct) {
      orders.unshift({
        title: currentTicketProduct.name,
        city: currentTicketProduct.city || '',
        price: currentTicketProduct.price,
        count: parseInt(document.getElementById('ticket-qty').value) || 1,
        date: new Date().toISOString().split('T')[0],
        status: 'confirmed',
        id: 'LOCAL' + Date.now(),
        created_at: new Date().toISOString()
      });
      localStorage.setItem('sm_tkt_orders', JSON.stringify(orders));
    }
  }
};

// Load profile on page switch to profile
const origSwitchPage = switchPage;
switchPage = function(name) {
  origSwitchPage(name);
  if (name === 'profile') {
    try {
      loadProfile();
    } catch(e) {
      console.error('加载个人中心数据失败:', e);
      showToast('个人中心数据加载失败，请稍后重试', 'warning');
    }
  }
  if (name === 'training') {
    try {
      initTrainingPage();
    } catch(e) {
      console.error('初始化实训页面失败:', e);
      showToast('实训页面加载失败，请刷新重试', 'error');
    }
  }
  if (name === 'plan') {
    // 如果行程数据加载失败（planContent 未能正常渲染），不做阻断，静默处理
  }
};

