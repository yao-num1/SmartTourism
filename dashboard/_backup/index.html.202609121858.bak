// ===== LOAD HISTORY =====
async function loadHistory() {
  if (!conversationId) return;
  try {
    var r = await fetch(BACKEND + '/api/sessions/' + conversationId + '/messages?limit=100');
    var data = await r.json();
    if (data.success && data.messages && data.messages.length > 0) {
      messages = data.messages.map(function(m) {
        return { role: m.role === 'agent' ? 'agent' : 'user', content: m.content, locations: [] };
      });
      renderMessages();
      setStatus('已加载 ' + messages.length + ' 条历史消息', 'oklch(0.62 0.14 175)');
    }
  } catch(e) {
    console.warn('加载历史消息失败:', e);
  }
}

function newConversation() {
  // Clear current conversation
  if (conversationId) {
    fetch(BACKEND + '/api/conversations/' + conversationId, { method: 'DELETE' }).catch(function(){});
  }
  conversationId = '';
  messages = [];
  localStorage.removeItem('st_conversation_id');
  renderMessages();
  setStatus('新对话', 'oklch(0.62 0.14 175)');
  showToast('已开启新对话', 'success');
}

