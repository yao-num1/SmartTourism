SMARTTOURISM_ENV=production
SMARTTOURISM_DEBUG=0
SMARTTOURISM_HOST=0.0.0.0
SMARTTOURISM_PORT=5000
SMARTTOURISM_LOG_LEVEL=INFO
SMARTTOURISM_MAX_CONTENT_LENGTH=2097152
SMARTTOURISM_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 第三方服务密钥建议只放在本地 .env 或服务器环境变量中，不要提交真实值
AMAP_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=

# LLM 发送层：瞬态故障（超时/429/5xx）重试次数与首次退避秒数
SMARTTOURISM_LLM_RETRY=1
SMARTTOURISM_LLM_RETRY_WAIT=1.5
# 备用通道（选填）：不填 BASE_URL 即不启用；密钥只放环境变量，不要提交
SMARTTOURISM_LLM_FALLBACK_BASE_URL=
SMARTTOURISM_LLM_FALLBACK_KEY=
SMARTTOURISM_LLM_FALLBACK_MODEL=

# 美团插件结果缓存：实时有效期 / 接口故障时可回退多久前的旧数据 / 缓存条数上限
MEITUAN_CACHE_TTL=300
MEITUAN_CACHE_STALE_MAX=86400
MEITUAN_CACHE_MAX_ENTRIES=200

# 流式「停止生成」的取消登记残留淘汰秒数（正常结束会即时注销，这里只兜异常残留）
SMARTTOURISM_STREAM_TTL=900

# 模型单价（元/百万 token，输入/输出分开）。不填则运维面板与成本实测只报 token 不报钱；
# 单价请按填写当时的官方价格页为准，不要写死进代码或文档（调价后数字会变成假数据）。
SMARTTOURISM_PRICE_IN_PER_M=
SMARTTOURISM_PRICE_OUT_PER_M=
SMARTTOURISM_PRICE_CURRENCY=CNY

# 生图指纹复用：Seedream 按张计费，模型+尺寸+提示词+水印完全相同时直接复用已落盘的图，
# 不再出网（演示反复点同一目的地、前端超时后再点一次，都不该付第二次钱）。
# 需要每次都要一张全新图时设为 0。
SMARTTOURISM_ARK_IMAGE_CACHE=1

# 生图单价（元/张）。不填则运维面板只报张数不报钱；请按填写当时的官方价格页为准。
SMARTTOURISM_PRICE_ARK_PER_IMAGE=
