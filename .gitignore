data/logs/
*.log

# 生成的海报/配图缓存（体积大，可重新生成）
dashboard/poster/

# 本地备份与临时测试脚本
_backup_*/
_*.py
_*.js
_*.txt
.workbuddy/

# 本地虚拟环境
venv/
.venv/

