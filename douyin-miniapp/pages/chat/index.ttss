.chat-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f8f3e8;
}

.intro {
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.messages {
  flex: 1;
  min-height: 520rpx;
  max-height: 760rpx;
  padding: 10rpx 0 22rpx;
}

.msg {
  display: flex;
  margin: 18rpx 0;
}

.msg.user {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 78%;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.assistant .msg-bubble {
  background: #fff;
  color: #2b241b;
  border: 1rpx solid rgba(111, 83, 48, 0.12);
}

.user .msg-bubble {
  background: #b5651d;
  color: #fff;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.quick {
  flex: 1;
  font-size: 24rpx;
}

.composer {
  padding: 20rpx;
}

.composer .textarea {
  min-height: 150rpx;
  margin-bottom: 18rpx;
}
