# /etc/systemd/system/smarttourism.service
# SmartTourism Flask API — Gunicorn 生产服务
# 安装方式：sudo cp smarttourism.service /etc/systemd/system/
# 启动方式：sudo systemctl daemon-reload && sudo systemctl enable --now smarttourism

[Unit]
Description=SmartTourism Flask API Server
After=network.target

[Service]
User=root
WorkingDirectory=/opt/smarttourism
Environment="PATH=/opt/smarttourism/venv/bin"
EnvironmentFile=/opt/smarttourism/.env
ExecStart=/opt/smarttourism/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 "server.app:app" --timeout 120
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
