# SmartTourism 环境变量配置模板
# 复制为 .env 并填写实际值
# 安装方式：cp .env.example /opt/smarttourism/.env
# 权限设置：chmod 600 /opt/smarttourism/.env

# ===== 大模型 API Key（至少配置一个）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 高德地图 Key =====
AMAP_KEY=your-amap-web-service-key

# ===== 社交平台热点接口（可选，用于社区页面展示）=====
# 抖音开放平台或商业数据合作提供的授权接口
DOUYIN_HOTSPOT_ENDPOINT=
DOUYIN_ACCESS_TOKEN=
DOUYIN_CLIENT_KEY=

# 小红书官方商业合作或授权数据服务提供的接口
XHS_HOTSPOT_ENDPOINT=
XHS_ACCESS_TOKEN=
XHS_APP_ID=
